/* 全局样式 */
page {
  background-color: #f3f4f6;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  color: #1f2937;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 通用卡片 */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
  margin-bottom: 24rpx;
}

/* 渐变按钮 */
.btn-primary {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  border: none;
  width: 100%;
  box-shadow: 0 8rpx 32rpx rgba(99,102,241,0.35);
}

.btn-danger {
  background: linear-gradient(135deg, #ef4444, #ec4899);
  color: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  border: none;
  width: 100%;
}

.btn-success {
  background: linear-gradient(135deg, #22c55e, #16a34a);
  color: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  border: none;
  width: 100%;
}

/* 输入框 */
.input-field {
  background: #f9fafb;
  border: 3rpx solid #e5e7eb;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.input-field:focus {
  border-color: #6366f1;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 40rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.tag-income  { background: #f0fdf4; color: #16a34a; }
.tag-expense { background: #fff1f2; color: #ef4444; }
.tag-primary { background: #eef2ff; color: #6366f1; }

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
  color: #9ca3af;
}
.empty-state .icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-state .text { font-size: 28rpx; }

/* 分割线 */
.divider {
  height: 1rpx;
  background: #f3f4f6;
  margin: 16rpx 0;
}

/* 加载中 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80rpx 0;
  color: #9ca3af;
  font-size: 26rpx;
}
