.page { padding: 16px 16px 100px; background: #f3f4f6; min-height: 100vh; }

.header-card {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  border-radius: 20px;
  padding: 20px;
  margin-bottom: 16px;
  display: flex;
  align-items: center;
  gap: 12px;
  position: relative;
  overflow: hidden;
}
.header-card::before {
  content: '';
  position: absolute;
  top: -30px; right: -30px;
  width: 120px; height: 120px;
  border-radius: 50%;
  background: rgba(255,255,255,0.08);
}
.header-icon { font-size: 36px; flex-shrink: 0; }
.header-info { flex: 1; }
.header-title { display: block; font-size: 18px; font-weight: 800; color: white; }
.header-sub { display: block; font-size: 12px; color: rgba(255,255,255,0.6); margin-top: 2px; }
.ledger-badge {
  background: rgba(255,255,255,0.2);
  border-radius: 20px;
  padding: 4px 12px;
  font-size: 12px;
  color: white;
  font-weight: 600;
  flex-shrink: 0;
}

.empty-tip {
  text-align: center;
  padding: 60px 0;
  color: #9ca3af;
  font-size: 15px;
}

.section-card {
  background: white;
  border-radius: 20px;
  padding: 18px;
  margin-bottom: 14px;
  box-shadow: 0 1px 6px rgba(0,0,0,0.05);
}
.section-title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 15px;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 14px;
}
.section-icon { font-size: 18px; }

.field-group { margin-bottom: 14px; }
.field-label { display: block; font-size: 12px; color: #9ca3af; margin-bottom: 8px; }

.btn-group { display: flex; gap: 8px; margin-bottom: 8px; }
.btn-toggle {
  flex: 1;
  padding: 9px 0;
  border-radius: 10px;
  border: none;
  font-size: 13px;
  font-weight: 600;
  text-align: center;
  background: #f3f4f6;
  color: #6b7280;
  cursor: pointer;
}
.btn-toggle.active {
  background: #eef2ff;
  color: #6366f1;
}
.btn-toggle.active.green { background: #dcfce7; color: #16a34a; }
.btn-toggle.active.red { background: #fee2e2; color: #dc2626; }

.month-input {
  width: 100%;
  padding: 9px 12px;
  border: 1.5px solid #e5e7eb;
  border-radius: 10px;
  font-size: 15px;
  background: white;
  box-sizing: border-box;
}

.export-btn-group { display: flex; flex-direction: column; gap: 10px; }
.export-btn {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 14px;
  border-radius: 14px;
  border: none;
  cursor: pointer;
}
.export-btn.primary { background: #6366f1; }
.export-btn.warning { background: #f59e0b; }
.export-btn-icon { font-size: 26px; flex-shrink: 0; }
.export-btn-text { display: flex; flex-direction: column; align-items: flex-start; flex: 1; }
.export-btn-title { font-size: 14px; font-weight: 700; color: white; }
.export-btn-sub { font-size: 11px; color: rgba(255,255,255,0.75); margin-top: 2px; }

.import-drop {
  border: 2px dashed #d1d5db;
  border-radius: 16px;
  padding: 32px 16px;
  text-align: center;
  cursor: pointer;
  background: #fafafa;
}
.drop-icon { display: block; font-size: 32px; margin-bottom: 8px; }
.drop-title { display: block; font-weight: 600; color: #374151; font-size: 14px; }
.drop-sub { display: block; font-size: 12px; color: #9ca3af; margin-top: 4px; }

.import-preview {
  background: #f9fafb;
  border-radius: 16px;
  padding: 16px;
}
.preview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}
.preview-name { font-weight: 700; font-size: 14px; color: #1f2937; }
.preview-date { font-size: 12px; color: #9ca3af; }

.preview-stats {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 8px;
}
.stat-chip {
  background: white;
  border-radius: 20px;
  padding: 3px 10px;
  font-size: 12px;
  color: #6b7280;
  font-weight: 500;
}

.mode-hint { font-size: 12px; color: #16a34a; display: block; margin-top: 4px; }
.mode-hint.red { color: #dc2626; }

.preview-actions { display: flex; gap: 10px; margin-top: 14px; }
.btn-cancel {
  flex: 1;
  padding: 11px 0;
  border-radius: 12px;
  border: 1.5px solid #e5e7eb;
  background: white;
  color: #6b7280;
  font-weight: 600;
  font-size: 14px;
  text-align: center;
}
.btn-confirm {
  flex: 2;
  padding: 11px 0;
  border-radius: 12px;
  border: none;
  color: white;
  font-weight: 700;
  font-size: 14px;
  text-align: center;
  background: #16a34a;
}
.btn-confirm.merge { background: #16a34a; }
.btn-confirm.overwrite { background: #ef4444; }

.safe-tip {
  background: #f0f9ff;
  border-radius: 16px;
  padding: 14px;
  display: flex;
  gap: 10px;
  align-items: flex-start;
  margin-bottom: 14px;
}
.safe-icon { font-size: 18px; flex-shrink: 0; margin-top: 1px; }
.safe-text { display: flex; flex-direction: column; gap: 3px; flex: 1; }
.safe-title { font-weight: 600; font-size: 13px; color: #0369a1; }
.safe-desc { font-size: 12px; color: #075985; line-height: 1.6; }

.loading-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.loading-box {
  background: white;
  border-radius: 20px;
  padding: 32px 48px;
  text-align: center;
  box-shadow: 0 10px 40px rgba(0,0,0,0.2);
}
.loading-spinner {
  width: 36px;
  height: 36px;
  border: 3px solid #e5e7eb;
  border-top-color: #6366f1;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin: 0 auto 12px;
}
.loading-text { font-size: 14px; color: #6b7280; font-weight: 600; }

@keyframes spin { to { transform: rotate(360deg); } }
.btn-press { opacity: 0.75; }
