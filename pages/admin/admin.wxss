/* pages/admin/admin.wxss */
page { background: #f0f2f7; }
.page { min-height: 100vh; padding-bottom: 140rpx; }

/* ── 游客提示 ─────────────────────────────── */
.guest-tip-card {
  margin: 32rpx 32rpx 0;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  border-radius: 24rpx;
  padding: 40rpx;
  text-align: center;
}
.guest-tip-card text { display: block; }
.guest-tip-icon { font-size: 64rpx; margin-bottom: 16rpx; }
.guest-tip-title { font-size: 32rpx; font-weight: 700; color: white; margin-bottom: 12rpx; }
.guest-tip-desc { font-size: 24rpx; color: rgba(255,255,255,0.8); margin-bottom: 24rpx; }
.guest-tip-btn {
  background: white; color: #6366f1;
  font-size: 28rpx; font-weight: 700;
  padding: 20rpx 40rpx; border-radius: 24rpx;
  display: inline-block;
}

/* 顶部头部 */
.header-card {
  position: relative;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  padding: 60rpx 40rpx 80rpx;
  overflow: hidden;
}
.header-circle1 {
  position: absolute; top: -80rpx; right: -80rpx;
  width: 320rpx; height: 320rpx;
  background: rgba(255,255,255,0.1); border-radius: 50%;
}
.header-circle2 {
  position: absolute; bottom: -60rpx; left: -40rpx;
  width: 200rpx; height: 200rpx;
  background: rgba(255,255,255,0.07); border-radius: 50%;
}
.header-title {
  display: block; color: #fff;
  font-size: 44rpx; font-weight: 700; letter-spacing: 2rpx;
}
.header-right { position: absolute; top: 32rpx; right: 32rpx; }
.logout-tag { font-size: 24rpx; color: #fff; background: rgba(255,255,255,0.2); padding: 8rpx 24rpx; border-radius: 20rpx; font-weight: 600; }

/* Tab 栏 */
.tab-bar {
  display: flex; margin: -40rpx 32rpx 0;
  background: #fff; border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.1);
  overflow: hidden; position: relative; z-index: 10;
}
.tab-item {
  flex: 1; display: flex; flex-direction: column;
  align-items: center; padding: 24rpx 0;
}
.tab-icon-text { font-size: 32rpx; }
.tab-label { font-size: 22rpx; color: #9ca3af; margin-top: 6rpx; }
.tab-item.active { background: linear-gradient(135deg, #ede9fe, #ddd6fe); }
.tab-item.active .tab-label { color: #6366f1; font-weight: 600; }

/* 加载/空状态 */
.loading-wrap { padding: 80rpx; text-align: center; }
.loading-text { color: #9ca3af; font-size: 28rpx; }
.empty-tip { display: flex; flex-direction: column; align-items: center; padding: 100rpx 0; }
.empty-icon { font-size: 80rpx; }
.empty-text { color: #9ca3af; font-size: 28rpx; margin-top: 20rpx; }
.empty-state { text-align: center; padding: 60rpx 32rpx; color: #9ca3af; font-size: 28rpx; }

/* 通用卡片 */
.info-card {
  margin: 32rpx 32rpx 0;
  background: #fff; border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.info-row { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 0; }
.info-label { font-size: 26rpx; color: #6b7280; }
.info-value { font-size: 28rpx; color: #1f2937; font-weight: 500; }
.info-input { flex: 1; text-align: right; font-size: 28rpx; color: #1f2937; background: #f3f4f6; padding: 16rpx 24rpx; border-radius: 16rpx; }
.divider { height: 1rpx; background: #f3f4f6; margin: 8rpx 0; }

/* 邀请码 */
.invite-row { display: flex; align-items: center; gap: 16rpx; }
.invite-code { font-size: 32rpx; font-weight: 700; color: #6366f1; letter-spacing: 4rpx; }
.copy-btn { background: #ede9fe; color: #6366f1; font-size: 22rpx; padding: 8rpx 20rpx; border-radius: 20rpx; font-weight: 500; }
.copy-btn.copied { background: #d1fae5; color: #10b981; }

/* 操作卡片 */
.action-card {
  margin: 24rpx 32rpx 0;
  background: #fff; border-radius: 20rpx;
  padding: 28rpx 32rpx;
  display: flex; align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
}
.action-icon { font-size: 32rpx; margin-right: 16rpx; }
.action-text { flex: 1; font-size: 28rpx; color: #374151; font-weight: 500; }
.action-arrow { font-size: 24rpx; color: #9ca3af; }

/* 分区标题 */
.section-title { font-size: 28rpx; color: #374151; font-weight: 600; padding: 32rpx 40rpx 16rpx; }

/* 成员列表 */
.member-list { padding: 0 32rpx; display: flex; flex-direction: column; gap: 16rpx; }
.member-item {
  background: #fff; border-radius: 20rpx;
  padding: 24rpx 28rpx;
  display: flex; align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
}
.member-name { flex: 1; font-size: 28rpx; color: #1f2937; font-weight: 500; }
.member-role { font-size: 22rpx; color: #9ca3af; }

/* 账本列表 */
.ledger-list { padding: 0 32rpx; display: flex; flex-direction: column; gap: 16rpx; }
.ledger-item {
  background: #fff; border-radius: 20rpx;
  padding: 24rpx 28rpx;
  display: flex; align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
}
.ledger-item.current { border: 2rpx solid #6366f1; background: #fafafe; }
.ledger-icon { font-size: 40rpx; margin-right: 20rpx; }
.ledger-name { flex: 1; font-size: 28rpx; color: #1f2937; font-weight: 500; }
.ledger-type { font-size: 22rpx; color: #6366f1; background: #ede9fe; padding: 4rpx 12rpx; border-radius: 10rpx; }
.ledger-check { font-size: 28rpx; color: #6366f1; margin-left: 12rpx; }

/* 用户列表 */
.user-list { padding: 0 32rpx; display: flex; flex-direction: column; gap: 16rpx; }
.user-item {
  background: #fff; border-radius: 20rpx;
  padding: 24rpx 28rpx;
  display: flex; align-items: flex-start;
  gap: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
  min-height: 120rpx;
}
.user-info { flex: 1; min-width: 0; }
.user-meta {
  display: flex; flex-direction: column; align-items: flex-end; gap: 8rpx;
  width: 180rpx; flex-shrink: 0;
  background: #f0f9ff; border: 2rpx solid #ddd; border-radius: 12rpx; padding: 10rpx 14rpx;
}
.user-date { font-size: 20rpx; color: #bbb; white-space: nowrap; }
.user-login { font-size: 18rpx; color: #ccc; white-space: nowrap; }
.user-name { display: block; font-size: 28rpx; color: #1f2937; font-weight: 600; }
.user-email { display: block; font-size: 22rpx; color: #9ca3af; margin-top: 4rpx; }
.user-status { margin-right: 16rpx; }
.activity-badge {
  font-size: 18rpx; font-weight: 700; padding: 4rpx 14rpx;
  border-radius: 20rpx; white-space: nowrap;
}
.activity-badge.online    { background: #d1fae5; color: #059669; }
.activity-badge.active   { background: #dbeafe; color: #2563eb; }
.activity-badge.normal   { background: #fef3c7; color: #d97706; }
.activity-badge.inactive { background: #fee2e2; color: #f97316; }
.activity-badge.zombie   { background: #f3f4f6; color: #9ca3af; }
.status-tag { font-size: 20rpx; padding: 6rpx 16rpx; border-radius: 20rpx; font-weight: 500; }
.status-tag.active { background: #d1fae5; color: #059669; }
.status-tag.pending { background: #fef3c7; color: #d97706; }
.status-tag.disabled { background: #fee2e2; color: #ef4444; }
.user-actions { display: flex; gap: 8rpx; }
.action-btn { font-size: 22rpx; padding: 8rpx 16rpx; border-radius: 16rpx; font-weight: 500; }
.action-btn.approve { background: #d1fae5; color: #059669; }
.action-btn.disable { background: #fef3c7; color: #d97706; }
.action-btn.enable { background: #dbeafe; color: #2563eb; }
.action-btn.delete { background: #fee2e2; color: #ef4444; }

/* 按钮 */
.save-btn { margin: 32rpx; background: linear-gradient(135deg, #6366f1, #8b5cf6); border-radius: 24rpx; padding: 28rpx; text-align: center; }
.save-btn text { color: white; font-size: 30rpx; font-weight: 700; }
.about-btn { margin: 0 32rpx; background: #f3f4f6; border-radius: 24rpx; padding: 28rpx; text-align: center; }
.about-btn text { color: #6b7280; font-size: 28rpx; font-weight: 600; }

/* 底部弹窗 */
.modal-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 100; }
.modal-sheet {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #fff; border-radius: 40rpx 40rpx 0 0;
  padding: 24rpx 40rpx 60rpx; z-index: 101;
  transform: translateY(100%); transition: transform 0.3s ease;
}
.modal-sheet.show { transform: translateY(0); }
.sheet-handle { width: 80rpx; height: 8rpx; background: #e5e7eb; border-radius: 4rpx; margin: 0 auto 32rpx; }
.sheet-title { display: block; font-size: 34rpx; font-weight: 700; color: #1f2937; margin-bottom: 32rpx; text-align: center; }
.sheet-row { display: flex; align-items: center; margin-bottom: 24rpx; gap: 20rpx; }
.sheet-label { font-size: 28rpx; color: #6b7280; width: 80rpx; flex-shrink: 0; }
.sheet-input { flex: 1; height: 88rpx; background: #f3f4f6; border-radius: 20rpx; padding: 0 24rpx; font-size: 28rpx; color: #1f2937; box-sizing: border-box; }
.sheet-btns { display: flex; gap: 16rpx; margin-top: 16rpx; }
.sheet-btn { flex: 1; height: 96rpx; border-radius: 24rpx; display: flex; align-items: center; justify-content: center; font-size: 30rpx; font-weight: 700; }
.sheet-btn.cancel { background: #f3f4f6; color: #6b7280; }
.sheet-btn.confirm { background: linear-gradient(135deg, #6366f1, #8b5cf6); color: #fff; }
