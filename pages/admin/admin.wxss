/* pages/admin/admin.wxss */
.page { background: #f3f4f6; min-height: 100vh; padding: 32rpx; padding-bottom: 120rpx; }

.header { margin-bottom: 24rpx; }
.page-title { font-size: 40rpx; font-weight: 700; color: #1f2937; display: block; }
.user-info { font-size: 24rpx; color: #9ca3af; margin-top: 4rpx; display: block; }

.tab-bar { display: flex; background: white; border-radius: 20rpx; padding: 6rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.tab { flex: 1; text-align: center; padding: 18rpx 0; border-radius: 16rpx; font-size: 26rpx; font-weight: 600; color: #9ca3af; }
.tab.active { background: linear-gradient(135deg,#6366f1,#8b5cf6); color: white; }

.sync-btn { background: linear-gradient(135deg,#f97316,#ef4444) !important; color: white !important; border-radius: 20rpx !important; padding: 20rpx 32rpx !important; font-size: 26rpx !important; font-weight: 600 !important; border: none !important; margin-bottom: 20rpx; }
.sync-btn::after { border: none; }

.loading { text-align: center; padding: 60rpx; color: #9ca3af; }

.section-title { font-size: 26rpx; font-weight: 600; color: #6b7280; margin-bottom: 16rpx; }

.user-list { }
.user-item { background: white; border-radius: 24rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.05); }
.ui-left { display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }
.ui-avatar { width: 80rpx; height: 80rpx; border-radius: 50%; background: linear-gradient(135deg,#6366f1,#8b5cf6); color: white; font-size: 36rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.ui-info { flex: 1; }
.ui-name  { font-size: 28rpx; font-weight: 700; color: #1f2937; display: block; }
.ui-email { font-size: 22rpx; color: #9ca3af; display: block; margin-top: 4rpx; }
.ui-right { display: flex; gap: 12rpx; margin-bottom: 16rpx; flex-wrap: wrap; }
.status-badge { font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 20rpx; font-weight: 600; }
.status-badge.active   { background: #dcfce7; color: #16a34a; }
.status-badge.pending  { background: #fef9c3; color: #ca8a04; }
.status-badge.disabled { background: #fee2e2; color: #dc2626; }
.role-badge { font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 20rpx; font-weight: 600; }
.role-badge.admin { background: #ede9fe; color: #7c3aed; }
.role-badge.user  { background: #f3f4f6; color: #6b7280; }
.ui-actions { display: flex; gap: 12rpx; flex-wrap: wrap; }
.action-btn { font-size: 24rpx !important; padding: 12rpx 20rpx !important; border-radius: 16rpx !important; border: none !important; margin: 0 !important; }
.action-btn.approve { background: #dcfce7 !important; color: #16a34a !important; }
.action-btn.disable { background: #fef9c3 !important; color: #ca8a04 !important; }
.action-btn.enable  { background: #dcfce7 !important; color: #16a34a !important; }
.action-btn.delete  { background: #fee2e2 !important; color: #dc2626 !important; }

.ledger-list { }
.ledger-item { background: white; border-radius: 24rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.05); }
.li-top { display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }
.li-icon { font-size: 48rpx; }
.li-info { flex: 1; }
.li-name  { font-size: 28rpx; font-weight: 700; color: #1f2937; display: block; }
.li-owner { font-size: 22rpx; color: #9ca3af; display: block; margin-top: 4rpx; }
.li-del { font-size: 28rpx; }
.li-members { background: #f3f4f6; border-radius: 16rpx; padding: 16rpx 20rpx; font-size: 24rpx; color: #6366f1; font-weight: 600; }

.empty { text-align: center; padding: 60rpx; color: #9ca3af; font-size: 26rpx; }

/* 审核弹窗 */
.modal-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 200; }
.modal { position: fixed; top: 50%; left: 50%; transform: translate(-50%,-50%) scale(0.8); z-index: 201; width: 90%; max-width: 600rpx; opacity: 0; transition: all 0.25s; pointer-events: none; }
.modal.show { opacity: 1; transform: translate(-50%,-50%) scale(1); pointer-events: auto; }
.modal-card { background: white; border-radius: 32rpx; overflow: hidden; box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.3); }
.modal-header { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 32rpx; border-bottom: 1rpx solid #f3f4f6; }
.modal-title { font-size: 32rpx; font-weight: 700; color: #1f2937; }
.modal-close { font-size: 36rpx; color: #9ca3af; width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; background: #f3f4f6; border-radius: 50%; }
.modal-body { padding: 32rpx; }
.modal-label { font-size: 28rpx; color: #374151; display: block; margin-bottom: 20rpx; }
.radio-item { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0; font-size: 28rpx; }
.modal-btn { background: linear-gradient(135deg,#6366f1,#8b5cf6) !important; color: white !important; border-radius: 20rpx !important; padding: 24rpx 0 !important; font-size: 30rpx !important; font-weight: 700 !important; border: none !important; margin-top: 24rpx; }
.modal-btn::after { border: none; }
