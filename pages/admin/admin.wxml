<view class="page">
<!-- 游客提示 -->
<view class="guest-tip-card" wx:if="{{isGuest}}">
  <text class="guest-tip-icon">🔐</text>
  <text class="guest-tip-title">登录后管理账户</text>
  <text class="guest-tip-desc">登录后可以管理账本、家庭协同、导入导出等</text>
  <button class="guest-tip-btn" bindtap="goLogin">去登录</button>
</view>

<block wx:if="{{!isGuest}}">
<view class="header-card">
<view class="header-circle1"></view>
<view class="header-circle2"></view>
<text class="header-title">{{user.role==='admin'||user.role==='manager'?'管理后台':'我的账户'}}</text>
<view class="header-right">
<text class="logout-tag" bindtap="handleLogout">退出</text>
</view>
</view>

<view class="tab-bar">
<view class="tab-item {{tab==='family'?'active':''}}" bindtap="setTab" data-tab="family">
<text class="tab-icon-text">👨‍👩‍👧</text>
<text class="tab-label">家庭</text>
</view>
<view class="tab-item {{tab==='account'?'active':''}}" bindtap="setTab" data-tab="account">
<text class="tab-icon-text">👤</text>
<text class="tab-label">账户</text>
</view>
<view class="tab-item {{tab==='ledgers'?'active':''}}" bindtap="setTab" data-tab="ledgers">
<text class="tab-icon-text">📒</text>
<text class="tab-label">账本</text>
</view>
<view class="tab-item {{tab==='import'?'active':''}}" bindtap="goExport">
<text class="tab-icon-text">💾</text>
<text class="tab-label">导入导出</text>
</view>
<view class="tab-item {{tab==='users'?'active':''}}" bindtap="setTab" data-tab="users" wx:if="{{user.role==='admin'||user.role==='manager'}}">
<text class="tab-icon-text">🛡️</text>
<text class="tab-label">用户</text>
</view>
</view>

<view class="loading-wrap" wx:if="{{loading}}">
<text class="loading-text">加载中...</text>
</view>

<!-- 家庭 Tab -->
<block wx:if="{{tab==='family' && !loading}}">
<view class="empty-tip" wx:if="{{!currentLedger}}">
<text class="empty-icon">📒</text>
<text class="empty-text">请先选择账本</text>
</view>
<block wx:if="{{currentLedger}}">
<view class="info-card">
<view class="info-row">
<text class="info-label">当前账本</text>
<text class="info-value">{{currentLedger.name}}</text>
</view>
<view class="divider"></view>
<view class="info-row">
<text class="info-label">邀请码</text>
<view class="invite-row">
<text class="invite-code">{{inviteCode}}</text>
<view class="copy-btn {{copied?'copied':''}}" bindtap="copyInviteCode">
<text>{{copied?'✓ 已复制':'复制'}}</text>
</view>
</view>
</view>
</view>
<view class="action-card" bindtap="openJoin">
<text class="action-icon">🔗</text>
<text class="action-text">加入其他账本</text>
<text class="action-arrow">›</text>
</view>
<view class="section-title">账本成员</view>
<view class="member-list">
<view class="member-item" wx:for="{{members}}" wx:key="user_id">
<text class="member-name">{{item.users.name || '未知'}}</text>
<text class="member-role">{{item.role==='owner'?'创建者':'成员'}}</text>
</view>
</view>
</block>
</block>

<!-- 账户 Tab -->
<block wx:if="{{tab==='account' && !loading}}">
<view class="section-title">基本信息</view>
<view class="info-card">
<view class="info-row">
<text class="info-label">用户ID</text>
<text class="info-value info-value-sm">{{profile.idShown}}</text>
</view>
<view class="divider"></view>
<view class="info-row">
<text class="info-label">注册邮箱</text>
<text class="info-value">{{profile.email || '--'}}</text>
</view>
<view class="divider"></view>
<view class="info-row">
<text class="info-label">身份</text>
<text class="role-tag {{profile.roleClass}}">{{profile.roleName}}</text>
</view>
<view class="divider"></view>
<view class="info-row">
<text class="info-label">状态</text>
<text class="status-tag {{profile.status}}">{{profile.statusName}}</text>
</view>
</view>

<view class="section-title">时间信息</view>
<view class="info-card">
<view class="info-row">
<text class="info-label">注册时间</text>
<text class="info-value">{{profile.createdDate}}</text>
</view>
<view class="divider"></view>
<view class="info-row">
<text class="info-label">最后登录</text>
<text class="info-value">{{profile.loginDate}}</text>
</view>
</view>

<view class="section-title">账本统计</view>
<view class="info-card">
<view class="info-row">
<text class="info-label">拥有账本</text>
<text class="info-value">{{profile.ledgerCount}} 个</text>
</view>
</view>

<view class="section-title">编辑昵称</view>
<view class="info-card">
<view class="info-row">
<text class="info-label">昵称</text>
<input class="info-input" value="{{editName}}" bindinput="onNameInput" placeholder="输入昵称"/>
</view>
</view>
<view class="save-btn" bindtap="handleSaveProfile"><text>保存昵称</text></view>

<view class="section-title" style="margin-top: 8rpx;">关于</view>
<view class="about-btn" bindtap="goAbout"><text>关于游游记账</text></view>
<view class="about-btn" bindtap="goAgreement"><text>用户协议</text></view>
<view class="about-btn" bindtap="goPrivacy"><text>隐私协议</text></view>
<view class="version-text"><text>游游记账 v5.1.1</text></view>
</block>

<!-- 账本 Tab -->
<block wx:if="{{tab==='ledgers' && !loading}}">
<view class="ledger-tab-header">
  <text class="section-title">我的账本</text>
  <view class="manage-all-btn" bindtap="goLedgersPage">完整管理 ›</view>
</view>

<!-- 新建 -->
<view class="create-card" bindtap="toggleCreate" wx:if="{{!showCreate}}">
  <text class="create-icon">➕</text>
  <text class="create-text">新建账本</text>
</view>
<view class="create-form" wx:if="{{showCreate}}">
  <view class="form-row">
    <input class="card-input" placeholder="输入账本名称" value="{{newLedgerName}}" bindinput="onNewLedgerNameInput"/>
  </view>
  <view class="form-btns">
    <view class="primary-btn" bindtap="handleCreateLedger">创建</view>
    <view class="secondary-btn" bindtap="toggleCreate">取消</view>
  </view>
</view>

<view class="ledger-list">
<view class="ledger-item {{currentLedger && currentLedger.id===item.id?'current':''}}" wx:for="{{myLedgers}}" wx:key="id">
  <view class="ledger-main" bindtap="switchLedger" data-ledger="{{item}}">
    <text class="ledger-icon">📒</text>
    <view class="ledger-info">
      <text class="ledger-name">{{item.displayName || item.name}}</text>
      <text class="ledger-type">{{item.type==='personal'?'个人':'家庭'}}</text>
    </view>
    <text class="ledger-check" wx:if="{{currentLedger && currentLedger.id===item.id}}">✓</text>
  </view>
  <!-- 内联编辑 -->
  <view class="edit-inline" wx:if="{{editingLedgerId === item.id}}">
    <input class="edit-input" placeholder="输入新名称" value="{{editLedgerName}}" bindinput="onEditLedgerNameInput" focus="{{true}}"/>
    <view class="edit-btns">
      <view class="edit-save-btn" catchtap="saveLedgerName" data-id="{{item.id}}">保存</view>
      <view class="edit-cancel-btn" catchtap="cancelEditLedger">取消</view>
    </view>
  </view>
  <view class="ledger-actions" wx:if="{{editingLedgerId !== item.id}}">
    <view class="action-btn edit-btn" catchtap="startEditLedger" data-index="{{index}}">编辑</view>
    <view class="action-btn del-btn" catchtap="handleDeleteLedger" data-index="{{index}}">删除</view>
  </view>
</view>
</view>
<view wx:if="{{myLedgers.length===0}}" class="empty-state"><text>暂无账本</text></view>
</block>

<!-- 用户管理 Tab -->
<block wx:if="{{tab==='users' && !loading && (user.role==='admin'||user.role==='manager')}}">
<view class="section-title">自动审核</view>
<view class="info-card">
<view class="info-row">
<text class="info-label">新用户自动通过</text>
<switch checked="{{autoApprove}}" bindchange="toggleAutoApprove" color="#6366f1"/>
</view>
</view>
<view class="section-title">用户列表</view>
<view class="user-list">
<view class="user-item" wx:for="{{users}}" wx:key="id">
  <!-- 第一行：用户名 + 状态徽章 + 活跃度 -->
  <view class="user-row1">
    <text class="user-name">{{item.name || '未设置昵称'}}</text>
    <text class="status-tag {{item.status}}" style="background-color: {{item.status == 'active' ? '#d1fae5' : (item.status == 'pending' ? '#fef3c7' : '#fee2e2')}}; color: {{item.status == 'active' ? '#059669' : (item.status == 'pending' ? '#d97706' : '#ef4444')}};">{{item.status == 'active' ? '正常' : (item.status == 'pending' ? '待审核' : '已禁用')}}</text>
    <text class="activity-badge {{item.activityClass}}" style="background-color: {{item.activityClass == 'online' ? '#d1fae5' : (item.activityClass == 'active' ? '#dbeafe' : (item.activityClass == 'normal' ? '#fef3c7' : (item.activityClass == 'inactive' ? '#ffedd5' : '#f3f4f6')))}}; color: {{item.activityClass == 'online' ? '#059669' : (item.activityClass == 'active' ? '#2563eb' : (item.activityClass == 'normal' ? '#d97706' : (item.activityClass == 'inactive' ? '#ea580c' : '#9ca3af')))}};">{{item.activity}}</text>
    <text class="role-tag" style="background-color: #ede9fe; color: #7c3aed;">{{item.role == 'admin' ? '管理员' : '用户'}}</text>
  </view>
  <!-- 第二行：邮箱 -->
  <view class="user-row2">
    <text class="user-email">{{item.email || ''}}</text>
  </view>
  <!-- 第三行：注册时间 + 最后登录 -->
  <view class="user-row3">
    <text class="user-date">注册: {{item.createdDate}}</text>
    <text class="user-login">登录: {{item.loginDate}}</text>
  </view>
  <!-- 操作按钮 -->
  <view class="user-actions">
    <text class="action-btn approve" wx:if="{{item.status==='pending'}}" bindtap="handleApproveUser" data-id="{{item.id}}">通过</text>
    <text class="action-btn disable" wx:if="{{item.status==='active'}}" bindtap="handleDisableUser" data-id="{{item.id}}">禁用</text>
    <text class="action-btn enable" wx:if="{{item.status==='disabled'}}" bindtap="handleEnableUser" data-id="{{item.id}}">启用</text>
    <text class="action-btn delete" wx:if="{{item.status==='disabled'}}" bindtap="handleDeleteUser" data-id="{{item.id}}">删除</text>
  </view>
</view>
</view>
</block>

<!-- 加入账本弹窗 -->
<view class="modal-mask" wx:if="{{showJoin}}" bindtap="closeJoin"></view>
<view class="modal-sheet {{showJoin?'show':''}}">
<view class="sheet-handle"></view>
<text class="sheet-title">加入账本</text>
<view class="sheet-row">
<text class="sheet-label">邀请码</text>
<input class="sheet-input" placeholder="输入8位邀请码" value="{{joinCode}}" bindinput="onJoinCodeInput" maxlength="8"/>
</view>
<view class="sheet-btns">
<text class="sheet-btn cancel" bindtap="closeJoin">取消</text>
<text class="sheet-btn confirm" bindtap="handleJoin">{{joining?'加入中...':'加入'}}</text>
</view>
</view>
</block>
</view>
