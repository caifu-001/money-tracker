<!--pages/settings/settings.wxml-->
<view class="page">
  <!-- 用户信息卡片 -->
  <view class="profile-card">
    <view class="avatar">{{user.name ? user.name.charAt(0).toUpperCase() : '?'}}</view>
    <view class="profile-info">
      <text class="profile-name">{{user.name || '未设置昵称'}}</text>
      <text class="profile-email">{{user.email}}</text>
      <text class="profile-role {{user.role === 'admin' ? 'admin' : ''}}">
        {{user.role === 'admin' ? '🛡️ 管理员' : '👤 普通用户'}}
      </text>
    </view>
    <view class="edit-btn" bindtap="openChangeName">✏️</view>
  </view>

  <!-- 功能列表 -->
  <view class="section-title">账号设置</view>
  <view class="menu-list">
    <view class="menu-item" bindtap="openChangeName">
      <text class="menu-icon">✏️</text>
      <text class="menu-label">修改昵称</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="openResetPwd">
      <text class="menu-icon">🔑</text>
      <text class="menu-label">修改密码</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="section-title">系统</view>
  <view class="menu-list">
    <view class="menu-item" bindtap="goAdmin" wx:if="{{user.role === 'admin'}}">
      <text class="menu-icon">🛡️</text>
      <text class="menu-label">管理后台</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goAbout">
      <text class="menu-icon">ℹ️</text>
      <text class="menu-label">关于</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 退出按钮 -->
  <view class="logout-area">
    <button class="logout-btn" bindtap="handleLogout">退出登录</button>
    <button class="delete-btn" bindtap="handleDeleteAccount">删除账号</button>
  </view>

  <text class="app-version">游游记账 v1.0</text>
</view>

<!-- 修改昵称弹窗 -->
<view class="modal-mask" wx:if="{{showChangeName}}" bindtap="closeChangeName"></view>
<view class="modal {{showChangeName ? 'show' : ''}}">
  <view class="modal-card">
    <view class="modal-header">
      <text class="modal-title">修改昵称</text>
      <text class="modal-close" bindtap="closeChangeName">✕</text>
    </view>
    <view class="modal-body">
      <input class="modal-input" placeholder="输入新昵称" value="{{newName}}" bindinput="onNewNameInput" focus="{{showChangeName}}"/>
      <button class="modal-btn" bindtap="handleChangeName" disabled="{{saving}}">
        {{saving ? '保存中...' : '保存'}}
      </button>
    </view>
  </view>
</view>

<!-- 修改密码弹窗 -->
<view class="modal-mask" wx:if="{{showResetPwd}}" bindtap="closeResetPwd"></view>
<view class="modal {{showResetPwd ? 'show' : ''}}">
  <view class="modal-card">
    <view class="modal-header">
      <text class="modal-title">修改密码</text>
      <text class="modal-close" bindtap="closeResetPwd">✕</text>
    </view>
    <view class="modal-body">
      <input class="modal-input" type="password" placeholder="当前密码" value="{{oldPwd}}" bindinput="onOldPwdInput"/>
      <input class="modal-input" type="password" placeholder="新密码（至少6位）" value="{{newPwd}}" bindinput="onNewPwdInput"/>
      <input class="modal-input" type="password" placeholder="确认新密码" value="{{confirmPwd}}" bindinput="onConfirmPwdInput"/>
      <button class="modal-btn" bindtap="handleResetPwd" disabled="{{pwdSaving}}">
        {{pwdSaving ? '保存中...' : '确认修改'}}
      </button>
    </view>
  </view>
</view>
