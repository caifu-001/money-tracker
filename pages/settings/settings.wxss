page { background: #f0f2f7; }
.top-bar {
  display: flex; align-items: center; justify-content: flex-end;
  padding: 20rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid #f3f4f6;
}
.top-bar-text { font-size: 28rpx; color: #ef4444; font-weight: 700; }
.page { min-height: 100vh; padding-bottom: 140rpx; }
.header-card { position: relative; overflow: hidden; background: linear-gradient(135deg, #6366f1, #8b5cf6); padding: 60rpx 40rpx 80rpx; }
.header-circle { position: absolute; border-radius: 50%; background: rgba(255,255,255,0.1); }
.header-circle1 { top: -80rpx; right: -80rpx; width: 320rpx; height: 320rpx; }
.header-circle2 { bottom: -60rpx; left: -40rpx; width: 200rpx; height: 200rpx; }
.header-title { display: block; color: #fff; font-size: 44rpx; font-weight: 700; letter-spacing: 2rpx; }
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 100; }
.modal-sheet { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; border-radius: 40rpx 40rpx 0 0; padding: 24rpx 40rpx 60rpx; z-index: 101; transform: translateY(100%); transition: transform 0.3s ease; }
.modal-sheet.show { transform: translateY(0); }
.sheet-handle { width: 80rpx; height: 8rpx; background: #e5e7eb; border-radius: 4rpx; margin: 0 auto 32rpx; }
.sheet-title { display: block; font-size: 34rpx; font-weight: 700; color: #1f2937; margin-bottom: 16rpx; text-align: center; }
.sheet-btns { display: flex; gap: 20rpx; }
.sheet-btn { flex: 1; height: 96rpx; border-radius: 24rpx; display: flex; align-items: center; justify-content: center; font-size: 30rpx; font-weight: 600; }
.sheet-btn.cancel { background: #f3f4f6; color: #6b7280; }
.sheet-btn.confirm { background: linear-gradient(135deg, #6366f1, #8b5cf6); color: #fff; }
.section-header { display: flex; align-items: center; justify-content: space-between; padding: 32rpx 40rpx 16rpx; }
.section-title { font-size: 28rpx; color: #374151; font-weight: 600; }
.profile-card { margin: -40rpx 32rpx 0; background: #fff; border-radius: 24rpx; padding: 48rpx 32rpx; display: flex; flex-direction: column; align-items: center; box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.1); position: relative; z-index: 10; }
.avatar-wrap { width: 120rpx; height: 120rpx; background: linear-gradient(135deg, #6366f1, #8b5cf6); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 20rpx; }
.avatar-text { color: #fff; font-size: 52rpx; font-weight: 700; }
.profile-name { font-size: 36rpx; color: #1f2937; font-weight: 700; }
.profile-email { font-size: 24rpx; color: #9ca3af; margin-top: 8rpx; }
.menu-card { margin: 0 32rpx; background: #fff; border-radius: 24rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); overflow: hidden; }
.menu-item { display: flex; align-items: center; padding: 32rpx 28rpx; border-bottom: 1rpx solid #f3f4f6; }
.menu-item:last-child { border-bottom: none; }
.menu-icon { font-size: 32rpx; margin-right: 20rpx; }
.menu-label { flex: 1; font-size: 28rpx; color: #374151; font-weight: 500; }
.menu-arrow { font-size: 32rpx; color: #d1d5db; }
.logout-label { color: #ef4444 !important; font-weight: 600 !important; }
.logout-card {
  margin: 32rpx;
  background: #fef2f2;
  border: 3rpx solid #fecaca;
  border-radius: 24rpx;
  padding: 28rpx;
  display: flex; align-items: center; justify-content: center;
}
.logout-text { font-size: 30rpx; font-weight: 700; color: #ef4444; }
.danger-card { border: 3rpx solid #fee2e2; }
.danger-item { border-bottom: none !important; }
.danger-label { color: #ef4444 !important; font-weight: 600 !important; }
.app-version { display: block; text-align: center; color: #9ca3af; font-size: 22rpx; padding: 32rpx; }
.sheet-input { width: 100%; height: 96rpx; background: #f3f4f6; border-radius: 20rpx; padding: 0 24rpx; font-size: 28rpx; color: #1f2937; box-sizing: border-box; margin-bottom: 20rpx; }