.page { min-height: 100vh; background: #f3f4f6; padding: 24rpx; box-sizing: border-box; }

/* 未登录 */
.guest-tip { display: flex; flex-direction: column; align-items: center; padding: 120rpx 40rpx; }
.guest-title { font-size: 40rpx; font-weight: 700; color: #1f2937; }
.guest-desc { font-size: 26rpx; color: #6b7280; margin-top: 16rpx; }
.login-btn { margin-top: 40rpx; background: #6366f1; color: white; font-size: 28rpx; border-radius: 28rpx; padding: 16rpx 80rpx; }
.login-btn::after { border: none; }

/* 车辆切换 */
.vehicle-tabs { margin-bottom: 24rpx; }
.tabs-scroll { white-space: nowrap; }
.tab { display: inline-flex; align-items: center; padding: 16rpx 32rpx; margin-right: 16rpx; background: white; border-radius: 20rpx; border: 3rpx solid #e5e7eb; }
.tab-name { font-size: 26rpx; font-weight: 600; color: #6b7280; }
.tab.active { background: #6366f1; border-color: #6366f1; }
.tab.active .tab-name { color: white; }
.vehicle-picker { display: flex; align-items: center; justify-content: center; gap: 12rpx; background: white; border-radius: 24rpx; padding: 20rpx; }
.vehicle-picker-name { font-size: 30rpx; font-weight: 600; color: #1f2937; }
.vehicle-picker-arrow { font-size: 24rpx; color: #9ca3af; }

.loading-wrap { padding: 120rpx 0; text-align: center; }
.loading { color: #9ca3af; font-size: 26rpx; }

.empty-wrap { display: flex; flex-direction: column; align-items: center; padding: 120rpx 40rpx; }
.empty-icon { font-size: 80rpx; }
.empty-title { font-size: 32rpx; font-weight: 600; color: #374151; margin-top: 24rpx; }
.empty-desc { font-size: 24rpx; color: #9ca3af; margin-top: 12rpx; text-align: center; line-height: 1.6; }

/* 汇总卡片 */
.summary-card { background: linear-gradient(135deg, #6366f1, #8b5cf6); border-radius: 28rpx; padding: 32rpx; margin-bottom: 24rpx; box-shadow: 0 8rpx 32rpx rgba(99,102,241,0.3); }
.summary-main { display: flex; }
.summary-item { flex: 1; display: flex; flex-direction: column; }
.summary-label { font-size: 24rpx; color: rgba(255,255,255,0.8); }
.summary-value { font-size: 48rpx; font-weight: 700; color: white; margin-top: 8rpx; }
.summary-unit { font-size: 22rpx; font-weight: 400; color: rgba(255,255,255,0.7); margin-left: 6rpx; }
.summary-grid { display: flex; margin-top: 32rpx; background: rgba(255,255,255,0.12); border-radius: 20rpx; padding: 20rpx 0; }
.summary-cell { flex: 1; display: flex; flex-direction: column; align-items: center; }
.cell-value { font-size: 30rpx; font-weight: 700; color: white; }
.cell-label { font-size: 20rpx; color: rgba(255,255,255,0.7); margin-top: 4rpx; }

/* 区块 */
.section { background: white; border-radius: 24rpx; padding: 28rpx; margin-bottom: 24rpx; }
.section-title { font-size: 28rpx; font-weight: 700; color: #1f2937; display: block; margin-bottom: 20rpx; }

/* 每月油费 */
.month-row { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; border-bottom: 2rpx solid #f3f4f6; }
.month-row:last-child { border-bottom: none; }
.month-name { font-size: 26rpx; color: #374151; }
.month-amount { font-size: 28rpx; font-weight: 600; color: #ef4444; }

/* 明细 */
.record { border-bottom: 2rpx solid #f3f4f6; padding: 20rpx 0; }
.record:last-child { border-bottom: none; }
.record-head { display: flex; align-items: center; }
.record-date { font-size: 26rpx; font-weight: 600; color: #1f2937; }
.record-vehicle { font-size: 22rpx; color: #6366f1; background: #eef2ff; border-radius: 8rpx; padding: 2rpx 10rpx; margin-left: 12rpx; }
.record-amount { margin-left: auto; font-size: 28rpx; font-weight: 700; color: #ef4444; }
.record-body { margin-top: 8rpx; }
.record-meta { font-size: 24rpx; color: #6b7280; }
.record-note { font-size: 22rpx; color: #9ca3af; display: block; margin-top: 4rpx; }
.record-calc { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 10rpx; }
.calc-tag { font-size: 22rpx; color: #059669; background: #ecfdf5; border-radius: 8rpx; padding: 4rpx 12rpx; }
.record-first { font-size: 22rpx; color: #9ca3af; }
