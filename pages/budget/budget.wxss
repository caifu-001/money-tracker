/* pages/budget/budget.wxss - 统一设计系统 */
page { background: #f0f2f7; }
.page { min-height: 100vh; padding-bottom: 140rpx; }

.header-card { position: relative; overflow: hidden; background: linear-gradient(135deg, #6366f1, #8b5cf6); padding: 60rpx 40rpx 80rpx; }
.header-circle { position: absolute; border-radius: 50%; background: rgba(255,255,255,0.1); }
.header-circle1 { top: -80rpx; right: -80rpx; width: 320rpx; height: 320rpx; }
.header-circle2 { bottom: -60rpx; left: -40rpx; width: 200rpx; height: 200rpx; }
.header-title { display: block; color: #fff; font-size: 44rpx; font-weight: 700; letter-spacing: 2rpx; }

.month-nav-card { display: flex; align-items: center; justify-content: center; gap: 32rpx; margin: 32rpx 32rpx 0; background: #fff; border-radius: 20rpx; padding: 24rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }
.month-btn { width: 64rpx; height: 64rpx; background: #f3f4f6; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.month-btn text { font-size: 36rpx; color: #6366f1; font-weight: 300; }
.month-label { font-size: 32rpx; color: #1f2937; font-weight: 700; min-width: 180rpx; text-align: center; }

.overview-card { margin: 24rpx 32rpx 0; background: #fff; border-radius: 24rpx; padding: 32rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }
.ov-row { display: flex; justify-content: space-between; margin-bottom: 24rpx; }
.ov-item { display: flex; flex-direction: column; align-items: center; flex: 1; }
.ov-label { font-size: 24rpx; color: #9ca3af; }
.ov-value { font-size: 32rpx; font-weight: 700; margin-top: 8rpx; }
.ov-value.purple { color: #6366f1; }
.ov-value.red { color: #ef4444; }
.ov-value.green { color: #10b981; }
.progress-wrap { margin-bottom: 24rpx; }
.progress-bar { height: 16rpx; background: #f3f4f6; border-radius: 8rpx; overflow: hidden; margin-bottom: 8rpx; }
.progress-fill { height: 100%; background: linear-gradient(90deg, #6366f1, #8b5cf6); border-radius: 8rpx; transition: width 0.3s; }
.progress-fill.over { background: linear-gradient(90deg, #f59e0b, #ef4444); }
.progress-text { font-size: 22rpx; color: #9ca3af; text-align: right; }
.total-budget-btn { height: 80rpx; background: linear-gradient(135deg, #6366f1, #8b5cf6); border-radius: 20rpx; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 600; }

.tip-banner { margin: 20rpx 32rpx; background: #fef3c7; border-radius: 16rpx; padding: 20rpx 24rpx; }
.tip-banner text { font-size: 24rpx; color: #92400e; }
.loading { padding: 80rpx; text-align: center; }
.loading-text { color: #9ca3af; font-size: 28rpx; }

.section-header { display: flex; align-items: center; justify-content: space-between; padding: 32rpx 40rpx 16rpx; }
.section-title { font-size: 28rpx; color: #374151; font-weight: 600; }

.cat-list { display: flex; flex-direction: column; gap: 16rpx; padding: 0 32rpx; margin-bottom: 40rpx; }
.cat-item { background: #fff; border-radius: 20rpx; padding: 24rpx 28rpx; display: flex; align-items: center; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06); }
.ci-left { display: flex; align-items: center; flex: 1; }
.ci-icon { font-size: 40rpx; margin-right: 20rpx; }
.ci-name { font-size: 28rpx; color: #1f2937; font-weight: 500; }
.ci-meta { display: block; font-size: 22rpx; color: #9ca3af; margin-top: 4rpx; }
.ci-meta.gray { color: #d1d5db; }
.ci-right { display: flex; align-items: center; gap: 16rpx; }
.ci-bar-wrap { width: 100rpx; height: 8rpx; background: #f3f4f6; border-radius: 4rpx; overflow: hidden; }
.ci-bar { height: 100%; background: #6366f1; border-radius: 4rpx; }
.ci-bar.over { background: #ef4444; }
.ci-pct { font-size: 22rpx; color: #6366f1; font-weight: 600; min-width: 64rpx; text-align: right; }
.ci-pct.red { color: #ef4444; }
.ci-set-btn { font-size: 28rpx; }
.ci-set-btn.add { color: #6366f1; }

.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 100; }
.modal-sheet { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; border-radius: 40rpx 40rpx 0 0; padding: 24rpx 40rpx 60rpx; z-index: 101; transform: translateY(100%); transition: transform 0.3s ease; }
.modal-sheet.show { transform: translateY(0); }
.sheet-handle { width: 80rpx; height: 8rpx; background: #e5e7eb; border-radius: 4rpx; margin: 0 auto 32rpx; }
.sheet-title { display: block; font-size: 34rpx; font-weight: 700; color: #1f2937; margin-bottom: 16rpx; text-align: center; }
.sheet-btns { display: flex; gap: 20rpx; }
.sheet-btn { flex: 1; height: 96rpx; border-radius: 24rpx; display: flex; align-items: center; justify-content: center; font-size: 30rpx; font-weight: 600; }
.sheet-btn.cancel { background: #f3f4f6; color: #6b7280; }
.sheet-btn.confirm { background: linear-gradient(135deg, #6366f1, #8b5cf6); color: #fff; }
.sheet-cat { display: flex; align-items: center; justify-content: center; gap: 16rpx; margin-bottom: 32rpx; }
.sheet-cat-icon { font-size: 48rpx; }
.sheet-cat-name { font-size: 32rpx; font-weight: 700; color: #1f2937; }
.amount-wrap { display: flex; align-items: center; background: #f3f4f6; border-radius: 20rpx; padding: 0 24rpx; margin-bottom: 32rpx; }
.amount-yuan { font-size: 36rpx; color: #6366f1; font-weight: 700; margin-right: 12rpx; }
.amount-input { flex: 1; height: 96rpx; font-size: 32rpx; color: #1f2937; background: transparent; }

/* edit-modal 弹窗样式 */
.edit-modal { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; border-radius: 40rpx 40rpx 0 0; padding: 24rpx 40rpx 60rpx; z-index: 101; transform: translateY(100%); transition: transform 0.3s ease; }
.edit-modal.show { transform: translateY(0); }
.em-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 32rpx; }
.em-title { font-size: 34rpx; font-weight: 700; color: #1f2937; }
.em-close { font-size: 36rpx; color: #9ca3af; padding: 10rpx; }
.em-body { padding: 0; }
