/* pages/budget/budget.wxss */
.page { background: #f3f4f6; min-height: 100vh; padding: 32rpx; padding-bottom: 120rpx; }

.header { margin-bottom: 24rpx; }
.page-title { font-size: 40rpx; font-weight: 700; color: #1f2937; display: block; }
.month-label { font-size: 24rpx; color: #9ca3af; margin-top: 4rpx; display: block; }

.overview-card { background: linear-gradient(135deg,#6366f1,#8b5cf6); border-radius: 32rpx; padding: 32rpx; margin-bottom: 20rpx; box-shadow: 0 8rpx 32rpx rgba(99,102,241,0.3); }
.ov-row { display: flex; justify-content: space-around; margin-bottom: 28rpx; }
.ov-item { text-align: center; }
.ov-label { color: rgba(255,255,255,0.7); font-size: 22rpx; display: block; margin-bottom: 8rpx; }
.ov-value { font-size: 36rpx; font-weight: 700; display: block; }
.ov-value.purple { color: white; }
.ov-value.red    { color: #fca5a5; }
.ov-value.green  { color: #86efac; }
.progress-wrap { }
.progress-bar { background: rgba(255,255,255,0.2); border-radius: 99rpx; height: 16rpx; overflow: hidden; margin-bottom: 8rpx; }
.progress-fill { height: 100%; background: #86efac; border-radius: 99rpx; transition: width 0.3s; }
.progress-fill.over { background: #fca5a5; }
.progress-text { color: rgba(255,255,255,0.7); font-size: 22rpx; display: block; text-align: right; }

.tip-banner { background: #eef2ff; border-radius: 16rpx; padding: 16rpx 24rpx; margin-bottom: 20rpx; }
.tip-banner text { font-size: 24rpx; color: #6366f1; }

.loading { text-align: center; padding: 60rpx; color: #9ca3af; }
.section-title { font-size: 26rpx; font-weight: 600; color: #6b7280; margin-bottom: 16rpx; }

.cat-list { }
.cat-item { background: white; border-radius: 24rpx; padding: 24rpx; margin-bottom: 12rpx; display: flex; align-items: center; justify-content: space-between; box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.05); border: 3rpx solid transparent; }
.cat-item.has-budget { border-color: #e0e7ff; background: #fafbff; }
.ci-left { display: flex; align-items: center; gap: 16rpx; flex: 1; min-width: 0; }
.ci-icon { font-size: 40rpx; flex-shrink: 0; }
.ci-info { flex: 1; min-width: 0; }
.ci-name { font-size: 28rpx; font-weight: 600; color: #1f2937; display: block; }
.ci-meta { font-size: 22rpx; color: #9ca3af; display: block; margin-top: 4rpx; }
.ci-meta.gray { color: #c7d2fe; }
.ci-right { display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; }
.ci-bar-wrap { width: 80rpx; height: 10rpx; background: #f3f4f6; border-radius: 99rpx; overflow: hidden; }
.ci-bar { height: 100%; background: linear-gradient(90deg,#6366f1,#8b5cf6); border-radius: 99rpx; transition: width 0.3s; }
.ci-bar.over { background: linear-gradient(90deg,#ef4444,#ec4899); }
.ci-pct { font-size: 22rpx; color: #9ca3af; min-width: 60rpx; text-align: right; }
.ci-pct.red { color: #ef4444; }
.ci-set-btn { font-size: 28rpx; }

/* 弹窗 */
.modal-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 200; }
.edit-modal { position: fixed; top: 50%; left: 50%; transform: translate(-50%,-50%) scale(0.8); z-index: 201; width: 90%; max-width: 640rpx; opacity: 0; transition: all 0.25s; pointer-events: none; }
.edit-modal.show { opacity: 1; transform: translate(-50%,-50%) scale(1); pointer-events: auto; }
.em-card { background: white; border-radius: 32rpx; overflow: hidden; box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.3); }
.em-header { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 32rpx; border-bottom: 1rpx solid #f3f4f6; }
.em-title { font-size: 32rpx; font-weight: 700; color: #1f2937; }
.em-close { font-size: 36rpx; color: #9ca3af; width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; background: #f3f4f6; border-radius: 50%; }
.em-body { padding: 40rpx 32rpx; text-align: center; }
.em-cat-icon { font-size: 80rpx; display: block; margin-bottom: 12rpx; }
.em-cat-name { font-size: 32rpx; font-weight: 700; color: #1f2937; display: block; margin-bottom: 32rpx; }
.em-input-wrap { display: flex; align-items: baseline; gap: 8rpx; border-bottom: 3rpx solid #6366f1; padding-bottom: 8rpx; margin-bottom: 32rpx; }
.em-yuan { font-size: 48rpx; font-weight: 700; color: #6366f1; }
.em-input { flex: 1; font-size: 52rpx; font-weight: 700; color: #1f2937; }
.em-btns { display: flex; gap: 16rpx; }
.em-btn-save { flex: 2; background: linear-gradient(135deg,#6366f1,#8b5cf6) !important; color: white !important; border-radius: 24rpx !important; padding: 28rpx 0 !important; font-size: 30rpx !important; font-weight: 700 !important; border: none !important; }
.em-btn-cancel { flex: 1; background: #f3f4f6 !important; color: #6b7280 !important; border-radius: 24rpx !important; padding: 28rpx 0 !important; font-size: 28rpx !important; font-weight: 600 !important; border: none !important; }
.em-btn-save::after, .em-btn-cancel::after { border: none; }
