/* pages/login/login.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #ec4899 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
  position: relative;
  overflow: hidden;
}

.bg-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255,255,255,0.08);
}
.bg-circle-1 { width: 400rpx; height: 400rpx; top: -100rpx; right: -100rpx; }
.bg-circle-2 { width: 300rpx; height: 300rpx; bottom: -80rpx; left: -80rpx; }

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}
.logo-img  { width: 120rpx; height: 120rpx; border-radius: 32rpx; margin-bottom: 16rpx; box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.2); }
.logo-name { font-size: 56rpx; font-weight: 700; color: #ffffff; letter-spacing: 4rpx; }
.logo-sub  { font-size: 26rpx; color: rgba(255,255,255,0.75); margin-top: 8rpx; }

.form-card {
  background: #ffffff;
  border-radius: 40rpx;
  padding: 48rpx 40rpx;
  width: 100%;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.2);
}

.mode-tabs {
  display: flex;
  background: #f3f4f6;
  border-radius: 20rpx;
  padding: 6rpx;
  margin-bottom: 40rpx;
}
.mode-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #9ca3af;
  transition: all 0.2s;
}
.mode-tab.active {
  background: #ffffff;
  color: #6366f1;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1);
}

.input-group { margin-bottom: 28rpx; }
.input-label { font-size: 24rpx; color: #6b7280; margin-bottom: 10rpx; display: block; }
.input-field {
  background: #f9fafb;
  border: 3rpx solid #e5e7eb;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.password-wrap { position: relative; }
.password-wrap .input-field { padding-right: 80rpx; }
.pwd-toggle {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 32rpx;
}

.forgot-link {
  text-align: right;
  font-size: 24rpx;
  color: #6366f1;
  margin-bottom: 32rpx;
  margin-top: -12rpx;
}

.back-btn {
  font-size: 26rpx;
  color: #6366f1;
  margin-bottom: 32rpx;
}

.btn-submit {
  background: linear-gradient(135deg, #6366f1, #8b5cf6) !important;
  color: #ffffff !important;
  border-radius: 24rpx !important;
  padding: 28rpx 0 !important;
  font-size: 32rpx !important;
  font-weight: 700 !important;
  border: none !important;
  width: 100% !important;
  box-shadow: 0 8rpx 32rpx rgba(99,102,241,0.35) !important;
  margin-top: 8rpx;
}
.btn-submit.disabled { opacity: 0.6; }
.btn-submit::after { border: none; }

.footer-text {
  color: rgba(255,255,255,0.5);
  font-size: 24rpx;
  margin-top: 48rpx;
}
