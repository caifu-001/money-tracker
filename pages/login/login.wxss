/* ===== 页面基础 ===== */
page { background: #f0f2f7; }
.page { min-height: 100vh; display: flex; flex-direction: column; background: #f0f2f7; }

/* ===== 顶部渐变背景 ===== */
.top-bg {
  background: linear-gradient(148deg, #6366f1 0%, #8b5cf6 50%, #a855f7 100%);
  padding: 100rpx 48rpx 140rpx;
  position: relative;
  overflow: hidden;
}
.top-circle {
  position: absolute;
  border-radius: 50%;
}
.top-circle-1 {
  width: 300rpx; height: 300rpx;
  background: rgba(255,255,255,0.07);
  top: -120rpx; right: -80rpx;
}
.top-circle-2 {
  width: 200rpx; height: 200rpx;
  background: rgba(255,255,255,0.05);
  bottom: -60rpx; left: -40rpx;
}
.top-circle-3 {
  width: 140rpx; height: 140rpx;
  background: rgba(255,255,255,0.05);
  top: 40rpx; left: 30rpx;
}

/* ===== Logo 区域 ===== */
.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
}
.logo-icon {
  width: 120rpx; height: 120rpx;
  background: rgba(255,255,255,0.18);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  margin-bottom: 20rpx;
  backdrop-filter: blur(8px);
}
.logo-name {
  color: #fff;
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  display: block;
}
.logo-slogan {
  color: rgba(255,255,255,0.72);
  font-size: 26rpx;
  margin-top: 10rpx;
  display: block;
}

/* ===== 表单卡片 ===== */
.form-card {
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  margin-top: -60rpx;
  padding: 48rpx 48rpx 60rpx;
  flex: 1;
  position: relative;
  z-index: 2;
}

/* ===== Tab 切换 ===== */
.mode-tabs {
  display: flex;
  background: #f3f4f6;
  border-radius: 20rpx;
  padding: 6rpx;
  margin-bottom: 48rpx;
}
.mode-tab {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #9ca3af;
  font-weight: 500;
  border-radius: 16rpx;
  transition: all 0.25s ease;
}
.mode-tab.active {
  background: #fff;
  color: #6366f1;
  font-weight: 700;
  box-shadow: 0 4rpx 16rpx rgba(99,102,241,0.18);
}

/* ===== 输入框 ===== */
.input-group {
  margin-bottom: 28rpx;
}
.input-label {
  display: block;
  font-size: 26rpx;
  color: #4b5563;
  font-weight: 600;
  margin-bottom: 14rpx;
  padding-left: 6rpx;
}
.input-field {
  width: 100%;
  height: 96rpx;
  background: #f8f9fa;
  border: 2rpx solid #e5e7eb;
  border-radius: 20rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #1f2937;
  box-sizing: border-box;
  transition: border-color 0.2s;
}
.input-field:focus {
  border-color: #6366f1;
  background: #fff;
}

/* ===== 密码框 ===== */
.password-wrap {
  position: relative;
}
.password-wrap .input-field {
  padding-right: 80rpx;
}
.pwd-toggle {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 32rpx;
  padding: 8rpx;
}

/* ===== 忘记密码 ===== */
.forgot-link {
  display: block;
  text-align: right;
  font-size: 26rpx;
  color: #6366f1;
  font-weight: 500;
  margin-bottom: 36rpx;
  padding-right: 4rpx;
}

/* ===== 主按钮 ===== */
.btn-primary {
  height: 100rpx;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  border-radius: 24rpx;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 24rpx rgba(99,102,241,0.35);
  transition: all 0.2s;
  border: none;
  width: 100%;
  margin-top: 8rpx;
}
.btn-primary:active:not(:disabled) {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(99,102,241,0.3);
}
.btn-signup {
  background: linear-gradient(135deg, #10b981, #059669);
  box-shadow: 0 8rpx 24rpx rgba(16,185,129,0.3);
}
.btn-signup:active:not(:disabled) {
  box-shadow: 0 4rpx 12rpx rgba(16,185,129,0.25);
}
.btn-disabled {
  opacity: 0.45 !important;
  background: #d1d5db !important;
  box-shadow: none !important;
}
.btn-loading {
  opacity: 0.7;
}

/* ===== 验证码 ===== */
.verify-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8rpx;
  background: #eff6ff;
  border: 2rpx solid #bfdbfe;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
}
.verify-hint-icon { font-size: 32rpx; }
.verify-hint-text { font-size: 26rpx; color: #3b82f6; }
.verify-hint-email { font-size: 26rpx; color: #1d4ed8; font-weight: 700; }
.verify-code-input {
  width: 100%;
  height: 120rpx;
  background: #f8f9fa;
  border: 2rpx solid #e5e7eb;
  border-radius: 20rpx;
  padding: 0 28rpx;
  font-size: 44rpx;
  text-align: center;
  letter-spacing: 12rpx;
  color: #1f2937;
  box-sizing: border-box;
}
.resend-row {
  display: flex;
  justify-content: center;
  margin-top: 28rpx;
}
.resend-text { font-size: 26rpx; color: #9ca3af; }
.resend-link { font-size: 26rpx; color: #6366f1; font-weight: 600; }

/* ===== 忘记密码页 ===== */
.forgot-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #1f2937;
  margin-bottom: 16rpx;
  text-align: center;
}
.forgot-desc {
  display: block;
  font-size: 26rpx;
  color: #6b7280;
  text-align: center;
  margin-bottom: 40rpx;
  line-height: 1.6;
}
.back-link {
  display: block;
  text-align: center;
  font-size: 28rpx;
  color: #6366f1;
  font-weight: 500;
  margin-top: 36rpx;
  padding: 16rpx;
}

/* ===== 协议勾选 ===== */
.agree-row {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 6rpx;
  margin: 16rpx 0 28rpx;
}
.agree-checkbox {
  width: 38rpx;
  height: 38rpx;
  border: 3rpx solid #d1d5db;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s;
  flex-shrink: 0;
}
.agree-checkbox.checked {
  background: #6366f1;
  border-color: #6366f1;
}
.agree-check-icon {
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}
.agree-text { font-size: 24rpx; color: #6b7280; }
.agree-link { font-size: 24rpx; color: #6366f1; font-weight: 600; }

/* ===== 微信注册卡片 ===== */
.wechat-register-card {
  background: linear-gradient(145deg, #07c160, #059669);
  border-radius: 28rpx;
  padding: 48rpx 40rpx;
  margin: 12rpx 0 24rpx;
  text-align: center;
  color: #fff;
  box-shadow: 0 8rpx 28rpx rgba(7,193,96,0.3);
}
.wrc-icon { font-size: 72rpx; display: block; margin-bottom: 16rpx; }
.wrc-title { font-size: 38rpx; font-weight: 800; display: block; margin-bottom: 12rpx; }
.wrc-desc { font-size: 26rpx; opacity: 0.85; display: block; margin-bottom: 32rpx; line-height: 1.5; }
.wrc-btn {
  height: 96rpx;
  background: #fff;
  border-radius: 48rpx;
  color: #07c160;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 24rpx;
  letter-spacing: 2rpx;
}
.wrc-btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}
.wrc-cancel {
  font-size: 26rpx;
  opacity: 0.8;
  text-decoration: underline;
  display: block;
}

/* ===== 底部 ===== */
.page-footer {
  background: #fff;
  padding: 32rpx 0 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.footer-version {
  font-size: 22rpx;
  color: #9ca3af;
}
.footer-links-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.footer-link { font-size: 24rpx; color: #6366f1; font-weight: 500; }
.footer-sep { font-size: 22rpx; color: #d1d5db; }
