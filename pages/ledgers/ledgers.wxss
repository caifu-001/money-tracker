/* pages/ledgers/ledgers.wxss */
.page { background: #f3f4f6; min-height: 100vh; padding: 32rpx; padding-bottom: 120rpx; }
.header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.page-title { font-size: 40rpx; font-weight: 700; color: #1f2937; }
.add-btn { background: linear-gradient(135deg,#6366f1,#8b5cf6); color: white; border-radius: 20rpx; padding: 14rpx 28rpx; font-size: 26rpx; font-weight: 600; }

.create-card { background: white; border-radius: 28rpx; padding: 32rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06); }
.create-title { font-size: 28rpx; font-weight: 600; color: #374151; display: block; margin-bottom: 20rpx; }
.create-input { border: 3rpx solid #e5e7eb; border-radius: 20rpx; padding: 24rpx; font-size: 28rpx; margin-bottom: 20rpx; }
.btn-row { display: flex; gap: 16rpx; }
.btn-confirm { flex: 1; background: #6366f1 !important; color: white !important; border-radius: 16rpx !important; padding: 20rpx 0 !important; font-size: 28rpx !important; font-weight: 600 !important; border: none !important; }
.btn-cancel  { flex: 1; background: #f3f4f6 !important; color: #6b7280 !important; border-radius: 16rpx !important; padding: 20rpx 0 !important; font-size: 28rpx !important; font-weight: 600 !important; border: none !important; }
.btn-confirm::after, .btn-cancel::after { border: none; }

.loading { text-align: center; padding: 60rpx; color: #9ca3af; }

.ledger-list { }
.ledger-item { background: white; border-radius: 24rpx; padding: 28rpx; margin-bottom: 16rpx; display: flex; align-items: center; justify-content: space-between; box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.05); border: 3rpx solid transparent; transition: border-color 0.2s; }
.ledger-item.active { border-color: #6366f1; background: #f5f3ff; }
.ledger-item.just-switched { border-color: #22c55e; background: #f0fdf4; }
.li-left { display: flex; align-items: center; gap: 20rpx; }
.li-icon { font-size: 48rpx; }
.li-info { }
.li-name { font-size: 30rpx; font-weight: 700; color: #1f2937; display: block; }
.li-date { font-size: 22rpx; color: #9ca3af; display: block; margin-top: 4rpx; }
.li-right { display: flex; align-items: center; gap: 12rpx; }
.li-badge { font-size: 20rpx; padding: 6rpx 14rpx; border-radius: 20rpx; font-weight: 600; }
.active-badge  { background: #6366f1; color: white; }
.default-badge { background: #f3f4f6; color: #6b7280; }
.li-del { font-size: 28rpx; }

.empty { background: white; border-radius: 32rpx; padding: 80rpx 32rpx; text-align: center; box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06); }
.empty-icon { font-size: 80rpx; display: block; margin-bottom: 20rpx; }
.empty-text { font-size: 28rpx; font-weight: 700; color: #1f2937; display: block; margin-bottom: 8rpx; }
.empty-sub  { font-size: 24rpx; color: #9ca3af; display: block; }
