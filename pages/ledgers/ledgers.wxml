<!--pages/ledgers/ledgers.wxml-->
<view class="page">
  <view class="header">
    <text class="page-title">📚 账本管理</text>
    <view class="add-btn" bindtap="toggleCreate">
      <text>+ 新建账本</text>
    </view>
  </view>

  <!-- 新建表单 -->
  <view class="create-card" wx:if="{{showCreate}}">
    <text class="create-title">创建新账本</text>
    <input class="create-input" placeholder="输入账本名称" value="{{newName}}" bindinput="onNameInput" focus="{{showCreate}}"/>
    <view class="btn-row">
      <button class="btn-confirm" bindtap="handleCreate" disabled="{{!newName||creating}}">
        {{creating?'创建中...':'确认创建'}}
      </button>
      <button class="btn-cancel" bindtap="toggleCreate">取消</button>
    </view>
  </view>

  <!-- 加载 -->
  <view class="loading" wx:if="{{loading}}"><text>加载中...</text></view>

  <!-- 账本列表 -->
  <view class="ledger-list" wx:else>
    <view class="ledger-item {{item.id===currentLedger.id?'active':''}} {{item.id===confirmLedgerId?'just-switched':''}}"
      wx:for="{{ledgers}}" wx:key="id" bindtap="switchLedger" data-index="{{index}}">
      <view class="li-left">
        <text class="li-icon">📖</text>
        <view class="li-info">
          <text class="li-name">{{item.name}}</text>
          <text class="li-date">{{item.created_at}}</text>
        </view>
      </view>
      <view class="li-right">
        <text class="li-badge active-badge" wx:if="{{item.id===currentLedger.id}}">当前</text>
        <text class="li-badge default-badge" wx:if="{{item.owner_id===user.id}}">创建者</text>
        <text class="li-del" catchtap="handleDelete" data-index="{{index}}">🗑</text>
      </view>
    </view>

    <view class="empty" wx:if="{{ledgers.length===0}}">
      <text class="empty-icon">📖</text>
      <text class="empty-text">还没有账本</text>
      <text class="empty-sub">点击右上角创建第一个账本</text>
    </view>
  </view>
</view>
