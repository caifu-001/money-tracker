/* ========== 页面基础 ========== */
.page { min-height: 100vh; background: #f0f2f7; padding-bottom: 40rpx; }

/* ========== 头部 ========== */
.header-card { position: relative; background: linear-gradient(135deg, #6366f1, #8b5cf6); padding: 48rpx 40rpx 60rpx; overflow: hidden; }
.header-circle { position: absolute; border-radius: 50%; background: rgba(255,255,255,0.12); }
.header-circle1 { width: 200rpx; height: 200rpx; top: -60rpx; right: -40rpx; }
.header-circle2 { width: 120rpx; height: 120rpx; bottom: -40rpx; left: 80rpx; }
.header-title { position: relative; z-index: 1; font-size: 36rpx; font-weight: 700; color: #fff; letter-spacing: 2rpx; }

/* ========== 月份导航 ========== */
.month-nav-card { display: flex; align-items: center; justify-content: center; gap: 32rpx; background: #fff; margin: -32rpx 24rpx 0; border-radius: 20rpx; padding: 24rpx 32rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08); position: relative; z-index: 2; }
.month-btn { width: 64rpx; height: 64rpx; background: #f3f4f6; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.month-btn text { font-size: 36rpx; color: #6366f1; font-weight: 600; line-height: 1; }
.month-label { font-size: 32rpx; font-weight: 700; color: #1f2937; min-width: 200rpx; text-align: center; }

/* ========== 时间切换 Tab ========== */
.time-tabs { display: flex; margin: 24rpx 24rpx 0; background: #fff; border-radius: 20rpx; padding: 6rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }
.time-tab { flex: 1; height: 72rpx; display: flex; align-items: center; justify-content: center; font-size: 26rpx; color: #9ca3af; font-weight: 500; border-radius: 16rpx; transition: all 0.2s; }
.time-tab text { color: inherit; font-size: 26rpx; }
.time-tab.active { background: #6366f1; color: #fff; font-weight: 700; }
.time-tab.active text { color: #fff; }

/* ========== 日期范围 ========== */
.date-range-card { display: flex; align-items: center; gap: 16rpx; margin: 16rpx 24rpx 0; background: #fff; border-radius: 16rpx; padding: 20rpx 24rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }

/* ========== 总览卡片 ========== */
.overview-card { margin: 24rpx 24rpx 0; background: #fff; border-radius: 24rpx; padding: 32rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }
.ov-row { display: flex; gap: 24rpx; }
.ov-item { flex: 1; background: #f9fafb; border-radius: 16rpx; padding: 20rpx 24rpx; display: flex; flex-direction: column; gap: 6rpx; }
.ov-label { font-size: 24rpx; color: #9ca3af; }
.ov-value { font-size: 36rpx; font-weight: 800; }
.ov-value.income { color: #22c55e; }
.ov-value.expense { color: #ef4444; }
.balance-row { display: flex; align-items: center; justify-content: space-between; margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid #f3f4f6; }
.balance-label { font-size: 28rpx; color: #6b7280; font-weight: 600; }
.balance-value { font-size: 36rpx; font-weight: 800; }
.balance-value.income { color: #22c55e; }
.balance-value.expense { color: #ef4444; }

/* ========== 视图切换 Tab ========== */
.pending-banner { margin: 20rpx 24rpx 0; background: #eef2ff; border: 3rpx solid #c7d2fe; border-radius: 16rpx; padding: 20rpx 24rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.pending-banner .pb-text { flex: 1; font-size: 24rpx; color: #4338ca; }
.pending-banner .pb-more { color: #4f46e5; }
/* 转账提示条（转账不计收支，与待结算提示区分配色） */
.transfer-banner { margin: 20rpx 24rpx 0; background: #faf5ff; border: 3rpx solid #e9d5ff; border-radius: 16rpx; padding: 20rpx 24rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.transfer-banner .pb-text { flex: 1; font-size: 24rpx; color: #7e22ce; }
.transfer-banner .pb-more { color: #7e22ce; }
/* 提示条右侧「查看 ›」行动点 */
.pb-more { font-size: 24rpx; font-weight: 700; flex-shrink: 0; }
/* 账户视图：转账流动 */
.breakdown-title.transfer { color: #7e22ce; }
.bi-amount.transfer { color: #7e22ce; }
.tf-mid { display: flex; flex-direction: column; gap: 4rpx; }
.tf-date { font-size: 22rpx; color: #9ca3af; }
.tf-hint { font-size: 22rpx; color: #9ca3af; display: block; margin-top: 16rpx; }
.view-tabs { display: flex; margin: 24rpx 24rpx 0; background: #fff; border-radius: 20rpx; padding: 6rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }
.view-tab { flex: 1; height: 72rpx; display: flex; align-items: center; justify-content: center; font-size: 26rpx; color: #9ca3af; font-weight: 500; border-radius: 16rpx; transition: all 0.2s; }
.view-tab text { color: inherit; font-size: 26rpx; }
.view-tab.active { background: #6366f1; color: #fff; font-weight: 700; }
.view-tab.active text { color: #fff; }

/* ========== 搜索 ========== */
.search-card { display: flex; align-items: center; gap: 16rpx; margin: 24rpx 24rpx 0; background: #fff; border-radius: 16rpx; padding: 20rpx 24rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }
.search-input { flex: 1; font-size: 28rpx; color: #1f2937; }
.search-clear { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #f1f5f9; color: #94a3b8; font-size: 24rpx; flex-shrink: 0; }

/* ========== 分类目录筛选 ========== */
.cat-filter-bar { display: flex; align-items: center; margin: 16rpx 24rpx 0; gap: 16rpx; }
.cf-btn { flex: 1; display: flex; align-items: center; gap: 12rpx; background: #fff; border-radius: 16rpx; padding: 20rpx 24rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }
.cf-icon { font-size: 32rpx; }
.cf-label { flex: 1; font-size: 28rpx; color: #374151; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cf-arrow { font-size: 32rpx; color: #9ca3af; }
.cf-clear { padding: 20rpx 24rpx; font-size: 26rpx; color: #ef4444; background: #fff; border-radius: 16rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }
.cat-filter-active { margin: 12rpx 24rpx 0; background: #ede9fe; border-radius: 12rpx; padding: 14rpx 20rpx; }
.cfa-text { font-size: 24rpx; color: #6d28d9; }

/* 分类目录选择弹窗 */
.cf-type-tabs { display: flex; margin: 0 32rpx 8rpx; background: #f3f4f6; border-radius: 16rpx; padding: 6rpx; }
.cf-type-tab { flex: 1; height: 64rpx; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; font-size: 26rpx; color: #6b7280; font-weight: 500; }
.cf-type-tab.active { background: #6366f1; color: #fff; font-weight: 700; }
.cf-tree { padding-bottom: 20rpx; }
.cf-node { display: flex; align-items: center; gap: 8rpx; min-height: 76rpx; }
.cf-expand { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; color: #9ca3af; font-size: 24rpx; flex-shrink: 0; }
.cf-expand.has { color: #6366f1; }
.cf-node-main { flex: 1; display: flex; align-items: center; gap: 12rpx; padding: 16rpx 8rpx; border-bottom: 1rpx solid #f3f4f6; }
.cf-node-icon { font-size: 32rpx; }
.cf-node-name { flex: 1; font-size: 28rpx; color: #374151; }
.cf-node-check { color: #6366f1; font-size: 28rpx; font-weight: 700; }

/* ========== 统计模式切换 ========== */
.stat-mode-toggle { display: flex; align-items: center; justify-content: center; margin: 16rpx 24rpx 0; gap: 8rpx; }
.stat-mode-label { font-size: 24rpx; color: #94a3b8; margin-right: 8rpx; }
.mode-btn { padding: 8rpx 28rpx; border-radius: 20rpx; background: #f1f5f9; color: #64748b; font-size: 24rpx; font-weight: 500; }
.mode-btn.active { background: #3b82f6; color: #fff; }

/* ========== 饼图卡片 ========== */
.pie-card { margin: 24rpx 24rpx 0; background: #fff; border-radius: 24rpx; padding: 32rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }
.chart-title { font-size: 28rpx; font-weight: 700; color: #1f2937; display: block; margin-bottom: 20rpx; }

/* 饼图一行：左侧比例条，右侧图例 */
.pie-row { display: flex; align-items: center; justify-content: space-between; }

/* 横向比例圆饼条 */
.bar-pie-row { display: flex; align-items: center; gap: 20rpx; margin-bottom: 24rpx; }
.bar-pie-chart { flex: 1; height: 40rpx; background: #f3f4f6; border-radius: 20rpx; overflow: hidden; display: flex; flex-direction: row; }
.bar-pie-bar { height: 100%; min-width: 4rpx; transition: width 0.4s ease; }
.bar-pie-total { width: 80rpx; height: 80rpx; background: #f3f4f6; border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; flex-shrink: 0; }
.bpt-text { font-size: 32rpx; font-weight: 800; color: #6366f1; line-height: 1; }
.bpt-sub { font-size: 20rpx; color: #9ca3af; }

/* 图例 */
.pie-legend { flex: 1; margin-left: 24rpx; display: flex; flex-direction: column; gap: 16rpx; }
.legend-item { display: flex; align-items: center; gap: 10rpx; }
.legend-dot { width: 20rpx; height: 20rpx; border-radius: 50%; flex-shrink: 0; }
.legend-name { flex: 1; font-size: 24rpx; color: #374151; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.legend-pct { font-size: 22rpx; color: #9ca3af; min-width: 80rpx; text-align: right; }
.legend-amount { font-size: 24rpx; color: #1f2937; font-weight: 700; min-width: 150rpx; text-align: right; }

/* ========== 趋势柱状图 ========== */
.chart-card { margin: 24rpx 24rpx 0; background: #fff; border-radius: 24rpx; padding: 32rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }
.bar-chart { display: flex; align-items: flex-end; gap: 8rpx; height: 160rpx; margin-top: 20rpx; padding-top: 8rpx; }
.bar-item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.bar-wrap { width: 100%; display: flex; align-items: flex-end; justify-content: center; height: 120rpx; }
.bar { width: 80%; max-width: 40rpx; background: #c7d2fe; border-radius: 6rpx 6rpx 0 0; transition: height 0.3s; }
.bar.bar-today { background: #6366f1; }
.bar.bar-income { background: #86efac; }
.bar.bar-income.bar-today { background: #22c55e; }
.bar-label { font-size: 20rpx; color: #9ca3af; }

/* ========== 类别网格 ========== */
.cat-budget-section { margin: 24rpx 24rpx 0; background: #fff; border-radius: 24rpx; padding: 32rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }
.section-title-bar { font-size: 28rpx; font-weight: 700; color: #1f2937; display: block; margin-bottom: 20rpx; }
.cat-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.cat-badge { display: flex; flex-direction: column; align-items: center; gap: 6rpx; background: #f9fafb; border-radius: 16rpx; padding: 16rpx 20rpx; min-width: 120rpx; position: relative; }
.cat-badge.has-budget { background: #ede9fe; }
.cb-icon { font-size: 40rpx; }
.cb-name { font-size: 22rpx; color: #374151; font-weight: 600; white-space: nowrap; }
.cb-dot { position: absolute; top: 8rpx; right: 8rpx; font-size: 16rpx; color: #22c55e; }

/* ========== 明细列表 ========== */
.breakdown-section { margin: 24rpx 24rpx 0; background: #fff; border-radius: 24rpx; padding: 32rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }
.breakdown-title { font-size: 28rpx; font-weight: 700; display: block; margin-bottom: 20rpx; }
.breakdown-title.expense { color: #ef4444; }
.breakdown-title.income { color: #22c55e; }
.breakdown-list { display: flex; flex-direction: column; gap: 0; }
.breakdown-item { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 0; border-bottom: 1rpx solid #f3f4f6; }
.breakdown-item:last-child { border-bottom: none; }
.bi-left { display: flex; align-items: center; gap: 12rpx; }
.bi-icon { font-size: 36rpx; }
.bi-name { font-size: 28rpx; color: #374151; font-weight: 600; }
.bi-right { display: flex; align-items: center; gap: 16rpx; }
.bi-amount { font-size: 28rpx; font-weight: 800; }
.bi-amount.expense { color: #ef4444; }
.bi-amount.income { color: #22c55e; }
.bi-pct { font-size: 24rpx; color: #9ca3af; min-width: 80rpx; text-align: right; }

/* 子类目明细（汇总模式） */
.sub-items { margin-top: 16rpx; padding-left: 48rpx; }
.sub-item { display: flex; align-items: center; padding: 12rpx 0; border-bottom: 1rpx solid #f9fafb; }
.sub-item:last-child { border-bottom: none; }
.sub-icon { font-size: 28rpx; margin-right: 8rpx; }
.sub-name { font-size: 24rpx; color: #6b7280; flex: 1; }
.sub-right { display: flex; align-items: center; gap: 12rpx; }
.sub-amount { font-size: 24rpx; font-weight: 600; }
.sub-amount.expense { color: #f87171; }
.sub-amount.income { color: #34d399; }
.sub-pct { font-size: 20rpx; color: #9ca3af; min-width: 60rpx; text-align: right; }

/* ========== 构成列表（统一占比可视化：进度条即占比，明细即图例） ========== */
.bd-card { margin: 24rpx 24rpx 0; background: #fff; border-radius: 24rpx; padding: 32rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }
.bd-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; margin-bottom: 8rpx; }
.bd-head-title { font-size: 30rpx; font-weight: 700; color: #1f2937; }
.bd-head-sub { font-size: 22rpx; color: #9ca3af; flex-shrink: 0; }
.bd-row { padding: 22rpx 0; border-bottom: 1rpx solid #f3f4f6; }
.bd-row:last-child { border-bottom: none; }
.bd-row-top { display: flex; align-items: center; gap: 12rpx; margin-bottom: 14rpx; }
.bd-row-icon { font-size: 34rpx; }
.bd-row-name { flex: 1; font-size: 28rpx; font-weight: 600; color: #374151; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bd-row-amt { font-size: 28rpx; font-weight: 800; flex-shrink: 0; }
.bd-row-amt.expense { color: #ef4444; }
.bd-row-amt.income { color: #22c55e; }
.bd-row-amt.account { color: #6366f1; }
.bd-row-amt.transfer { color: #7e22ce; }
.bd-row-bar { display: flex; align-items: center; gap: 16rpx; }
.bd-track { flex: 1; height: 14rpx; background: #f1f5f9; border-radius: 7rpx; overflow: hidden; }
.bd-fill { height: 100%; border-radius: 7rpx; transition: width 0.4s ease; }
.bd-fill.expense { background: linear-gradient(90deg, #fca5a5, #ef4444); }
.bd-fill.income { background: linear-gradient(90deg, #86efac, #22c55e); }
.bd-fill.account { background: linear-gradient(90deg, #a5b4fc, #6366f1); }
.bd-fill.transfer { background: linear-gradient(90deg, #d8b4fe, #a855f7); }
.bd-pct { font-size: 22rpx; color: #94a3b8; min-width: 72rpx; text-align: right; }
.bd-foot { display: block; margin-top: 20rpx; font-size: 22rpx; color: #9ca3af; line-height: 1.5; }

/* ========== 空状态 & 加载 ========== */
.empty-state { margin: 24rpx 24rpx 0; background: #fff; border-radius: 24rpx; padding: 80rpx 40rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); display: flex; flex-direction: column; align-items: center; gap: 16rpx; }
.empty-emoji { font-size: 80rpx; }
.empty-text { font-size: 28rpx; color: #9ca3af; }
.loading { display: flex; align-items: center; justify-content: center; padding: 120rpx 0; }
.loading-text { font-size: 28rpx; color: #9ca3af; }

/* ���� ������ϸ�˵����� ���� */
.detail-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 100; }
.detail-sheet { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; border-radius: 32rpx 32rpx 0 0; z-index: 101; transform: translateY(100%); transition: transform 0.25s ease; max-height: 75vh; display: flex; flex-direction: column; }
.detail-sheet.show { transform: translateY(0); }
.detail-header { display: flex; align-items: center; justify-content: space-between; padding: 32rpx 32rpx 20rpx; border-bottom: 1rpx solid #f3f4f6; }
.detail-title { font-size: 32rpx; font-weight: 700; color: #1f2937; }
.detail-close { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; color: #9ca3af; font-size: 32rpx; }
.detail-body { flex: 1; overflow-y: auto; padding: 8rpx 32rpx 40rpx; }
.detail-item { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #f3f4f6; }
.detail-item:last-child { border-bottom: none; }
.detail-item-left { flex: 1; display: flex; flex-direction: column; gap: 8rpx; min-width: 0; }
.detail-item-date { font-size: 26rpx; color: #6b7280; }
.detail-item-note { font-size: 24rpx; color: #9ca3af; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.detail-item-right { display: flex; flex-direction: column; align-items: flex-end; gap: 6rpx; }
.detail-item-amount { font-size: 30rpx; font-weight: 800; }
.detail-item-amount.expense { color: #ef4444; }
.detail-item-amount.income { color: #22c55e; }
.detail-item-pay { font-size: 22rpx; color: #9ca3af; }
.detail-item-arrow { margin-left: 16rpx; color: #d1d5db; font-size: 36rpx; }
.detail-empty { text-align: center; padding: 80rpx 0; color: #9ca3af; font-size: 28rpx; }
/* 待结算弹窗：顶部说明 + 底部合计 */
.pending-tip { margin: 20rpx 32rpx 0; background: #eef2ff; border-radius: 12rpx; padding: 18rpx 20rpx; }
.pending-tip text { font-size: 22rpx; color: #4338ca; line-height: 1.6; }
.pending-tip .hl { color: #ef4444; font-weight: 700; }
.pending-foot { padding: 20rpx 32rpx 32rpx; border-top: 1rpx solid #f3f4f6; }
.pending-foot text { font-size: 22rpx; color: #9ca3af; }

/* ========== 借款视图（022） ==========
   颜色语义：receivable 待收回=青（对方欠我）/ payable 待偿还=橙（我欠对方）/ settled=灰
   与 支出红 / 收入绿 / 账户靛 / 转账紫 都不冲突 */
.loan-glance {
  margin: 24rpx 24rpx 0; background: #fff; border-radius: 16rpx;
  padding: 28rpx 24rpx; display: flex; align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.lg-item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.lg-split { width: 1rpx; height: 80rpx; background: #f3f4f6; }
.lg-label { font-size: 24rpx; color: #9ca3af; }
.lg-value { font-size: 40rpx; font-weight: 800; }
.lg-sub { font-size: 22rpx; color: #9ca3af; }
.lg-value.receivable { color: #0d9488; }
.lg-value.payable { color: #ea580c; }

.loan-net-bar {
  margin: 16rpx 24rpx 0; background: #f9fafb; border-radius: 16rpx;
  padding: 20rpx 24rpx; display: flex; align-items: baseline; gap: 12rpx;
}
.lnb-label { font-size: 24rpx; color: #6b7280; }
.lnb-value { font-size: 32rpx; font-weight: 800; }
.lnb-value.receivable { color: #0d9488; }
.lnb-value.payable { color: #ea580c; }
.lnb-hint { font-size: 22rpx; color: #9ca3af; }
.lnb-foot { margin-left: auto; font-size: 20rpx; color: #d1d5db; }

/* 按对方：一行一人 */
.ln-row { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #f3f4f6; }
.ln-row:last-of-type { border-bottom: none; }
.ln-avatar {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: #f0fdfa; display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; flex-shrink: 0; margin-right: 20rpx;
}
.ln-mid { flex: 1; display: flex; flex-direction: column; gap: 6rpx; min-width: 0; }
.ln-name { font-size: 28rpx; font-weight: 700; color: #1f2937; }
.ln-sub { font-size: 22rpx; color: #9ca3af; }
.ln-right { display: flex; flex-direction: column; align-items: flex-end; gap: 6rpx; }
.ln-net { font-size: 30rpx; font-weight: 800; }
.ln-net.receivable { color: #0d9488; }
.ln-net.payable { color: #ea580c; }
.ln-net.settled { color: #9ca3af; }
.ln-tag { font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 10rpx; }
.ln-tag.receivable { background: #ccfbf1; color: #115e59; }
.ln-tag.payable { background: #ffedd5; color: #9a3412; }
.ln-tag.settled { background: #f3f4f6; color: #6b7280; }
.loan-empty-hint { font-size: 22rpx; color: #9ca3af; margin-top: 12rpx; text-align: center; }

/* 借款明细弹窗 */
.loan-detail-net {
  margin: 20rpx 32rpx 0; padding: 20rpx 24rpx; border-radius: 12rpx;
  display: flex; align-items: baseline; justify-content: space-between;
}
.loan-detail-net.receivable { background: #f0fdfa; }
.loan-detail-net.payable { background: #fff7ed; }
.loan-detail-net.settled { background: #f9fafb; }
