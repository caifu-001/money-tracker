<view class="page">
  <!-- 游客浏览提示条 -->
  <view class="guest-banner" wx:if="{{isGuest}}">
    <view class="gb-inner">
      <text class="gb-text">正在浏览，登录后即可查看完整分析</text>
      <text class="gb-login-btn" bindtap="goLogin">登录</text>
    </view>
  </view>

  <view class="header-card">
    <view class="header-circle header-circle1"></view>
    <view class="header-circle header-circle2"></view>
    <text class="header-title">数据分析</text>
  </view>
  <view class="month-nav-card">
    <view class="month-btn" bindtap="prevMonth"><text>‹</text></view>
    <text class="month-label">{{monthLabel}}</text>
    <view class="month-btn" bindtap="nextMonth"><text>›</text></view>
  </view>
  <view class="time-tabs">
    <view class="time-tab {{timeRange==='month'?'active':''}}" bindtap="setTime" data-range="month"><text>本月</text></view>
    <view class="time-tab {{timeRange==='quarter'?'active':''}}" bindtap="setTime" data-range="quarter"><text>本季</text></view>
    <view class="time-tab {{timeRange==='year'?'active':''}}" bindtap="setTime" data-range="year"><text>本年</text></view>
    <view class="time-tab {{timeRange==='custom'?'active':''}}" bindtap="setTime" data-range="custom"><text>自定义</text></view>
  </view>
  <view class="date-range-card" wx:if="{{timeRange==='custom'}}">
    <input type="date" value="{{customStartDate}}" bindchange="onStartDateChange"/>
    <text class="date-sep">至</text>
    <input type="date" value="{{customEndDate}}" bindchange="onEndDateChange"/>
  </view>
  <view class="overview-card">
    <view class="ov-row">
      <view class="ov-item"><text class="ov-label">收入</text><text class="ov-value income">+¥{{totalIncome || 0}}</text></view>
      <view class="ov-item"><text class="ov-label">支出</text><text class="ov-value expense">-¥{{totalExpense || 0}}</text></view>
    </view>
    <view class="balance-row">
      <text class="balance-label">结余</text>
      <text class="balance-value {{balance>=0?'income':'expense'}}">{{balance >= 0 ? '+' : ''}}¥{{balance || 0}}</text>
    </view>
  </view>
  <view class="view-tabs">
    <view class="view-tab {{viewType==='expense'?'active':''}}" bindtap="switchView" data-type="expense"><text>💸 支出</text></view>
    <view class="view-tab {{viewType==='income'?'active':''}}" bindtap="switchView" data-type="income"><text>💰 收入</text></view>
    <view class="view-tab {{viewType==='payment'?'active':''}}" bindtap="switchView" data-type="payment"><text>💳 支付</text></view>
  </view>
  <view class="loading" wx:if="{{loading}}"><text class="loading-text">加载中...</text></view>
  <view wx:if="{{!loading}}">

    <!-- 搜索卡片 - 全局适用 -->
    <view class="search-card">
      <input class="search-input" type="text" placeholder="搜索类别..." value="{{searchCat}}" bindinput="onSearchInput" bindconfirm="onSearchConfirm" confirm-type="search"/>
      <view class="search-clear" wx:if="{{searchCat}}" bindtap="clearSearch"><text>✕</text></view>
    </view>

    <!-- 搜索结果 - 紧贴搜索框下方 -->
    <view wx:if="{{searchCat && viewType==='expense'}}">
      <view class="breakdown-section" wx:if="{{filteredExpenseList && filteredExpenseList.length > 0}}">
        <text class="breakdown-title expense">💸 支出搜索结果（{{filteredExpenseList.length}}项）</text>
        <view class="breakdown-list">
          <view class="breakdown-item" wx:for="{{filteredExpenseList}}" wx:key="category">
            <view class="bi-left"><text class="bi-icon">{{item.icon}}</text><text class="bi-name">{{item.category}}</text></view>
            <view class="bi-right"><text class="bi-amount expense">-¥{{item.amount}}</text><text class="bi-pct">{{item.percent}}%</text></view>
          </view>
        </view>
      </view>
      <view class="empty-state" wx:if="{{!filteredExpenseList || filteredExpenseList.length === 0}}">
        <text class="empty-text">未找到匹配「{{searchCat}}」的支出类别</text>
      </view>
    </view>
    <view wx:if="{{searchCat && viewType==='income'}}">
      <view class="breakdown-section" wx:if="{{filteredIncomeList && filteredIncomeList.length > 0}}">
        <text class="breakdown-title income">💰 收入搜索结果（{{filteredIncomeList.length}}项）</text>
        <view class="breakdown-list">
          <view class="breakdown-item" wx:for="{{filteredIncomeList}}" wx:key="category">
            <view class="bi-left"><text class="bi-icon">{{item.icon}}</text><text class="bi-name">{{item.category}}</text></view>
            <view class="bi-right"><text class="bi-amount income">+¥{{item.amount}}</text><text class="bi-pct">{{item.percent}}%</text></view>
          </view>
        </view>
      </view>
      <view class="empty-state" wx:if="{{!filteredIncomeList || filteredIncomeList.length === 0}}">
        <text class="empty-text">未找到匹配「{{searchCat}}」的收入类别</text>
      </view>
    </view>
    <view wx:if="{{searchCat && viewType==='payment'}}">
      <view class="breakdown-section" wx:if="{{filteredPaymentList && filteredPaymentList.length > 0}}">
        <text class="breakdown-title">💳 支付搜索结果（{{filteredPaymentList.length}}项）</text>
        <view class="breakdown-list">
          <view class="breakdown-item" wx:for="{{filteredPaymentList}}" wx:key="method">
            <view class="bi-left"><text class="bi-icon">{{item.icon}}</text><text class="bi-name">{{item.label}}</text></view>
            <view class="bi-right"><text class="bi-amount expense">-¥{{item.amount}}</text><text class="bi-pct">{{item.percent}}%</text></view>
          </view>
        </view>
      </view>
      <view class="empty-state" wx:if="{{!filteredPaymentList || filteredPaymentList.length === 0}}">
        <text class="empty-text">未找到匹配「{{searchCat}}」的支付方式</text>
      </view>
    </view>

    <!-- 统计模式切换 -->
    <view class="stat-mode-toggle">
      <text class="stat-mode-label">统计</text>
      <view class="mode-btn {{statMode==='detail'?'active':''}}" bindtap="switchStatMode" data-mode="detail"><text>小类</text></view>
      <view class="mode-btn {{statMode==='summary'?'active':''}}" bindtap="switchStatMode" data-mode="summary"><text>大类</text></view>
    </view>

    <!-- 支出视图 -->
    <view wx:if="{{viewType==='expense'}}">
      <!-- 横向比例圆饼图 -->
      <view class="pie-card" wx:if="{{expenseBreakdown.length > 0}}">
        <text class="chart-title">💸 支出占比</text>
        <view class="bar-pie-row">
          <view class="bar-pie-chart">
            <view
              wx:for="{{expenseBreakdown}}"
              wx:key="category"
              class="bar-pie-bar"
              style="width:{{item.percent}}%;background:{{item.color}}"
            ></view>
          </view>
          <view class="bar-pie-total"><text class="bpt-text">{{expenseBreakdown.length}}</text><text class="bpt-sub">类</text></view>
        </view>
        <view class="pie-legend">
          <view class="legend-item" wx:for="{{expenseBreakdown}}" wx:key="category">
            <view class="legend-dot" style="background:{{item.color}}"></view>
            <text class="legend-name">{{item.icon}} {{item.category}}</text>
            <text class="legend-pct">{{item.percent}}%</text>
            <text class="legend-amount">¥{{item.amount}}</text>
          </view>
        </view>
      </view>
      <view class="chart-card" wx:if="{{dailyTrend.length > 0}}">
        <text class="chart-title">📊 支出趋势（近{{dailyTrend.length}}天）</text>
        <view class="bar-chart">
          <view class="bar-item" wx:for="{{dailyTrend}}" wx:key="date">
            <view class="bar-wrap"><view class="bar {{item.isToday?'bar-today':''}}" style="height:{{item.barHeight}}rpx"></view></view>
            <text class="bar-label">{{item.day}}</text>
          </view>
        </view>
      </view>
      <view class="cat-budget-section" wx:if="{{expenseCats.length > 0}}">
        <text class="section-title-bar">💰 支出类别</text>
        <view class="cat-grid">
          <view class="cat-badge {{item.hasBudget?'has-budget':''}}" wx:for="{{expenseCats}}" wx:key="name" bindtap="openBudgetSet" data-name="{{item.name}}" data-icon="{{item.icon}}" data-has="{{item.hasBudget}}">
            <text class="cb-icon">{{item.icon}}</text>
            <text class="cb-name">{{item.name}}</text>
            <text class="cb-dot" wx:if="{{item.hasBudget}}">●</text>
          </view>
        </view>
      </view>
      <view class="breakdown-section" wx:if="{{expenseBreakdown.length > 0}}">
        <text class="breakdown-title expense">💸 支出明细</text>
        <view class="breakdown-list">
          <view class="breakdown-item" wx:for="{{expenseBreakdown}}" wx:key="category">
            <view class="bi-left"><text class="bi-icon">{{item.icon}}</text><text class="bi-name">{{item.category}}</text></view>
            <view class="bi-right"><text class="bi-amount expense">-¥{{item.amount}}</text><text class="bi-pct">{{item.percent}}%</text></view>
            <view class="sub-items" wx:if="{{item.subItems && item.subItems.length}}">
              <view class="sub-item" wx:for="{{item.subItems}}" wx:for-item="sub" wx:key="category">
                <text class="sub-icon">{{sub.icon}}</text>
                <text class="sub-name">{{sub.category}}</text>
                <view class="sub-right">
                  <text class="sub-amount expense">¥{{sub.amount}}</text>
                  <text class="sub-pct">{{sub.percent}}%</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view class="empty-state" wx:if="{{expenseBreakdown.length===0 && dailyTrend.length===0}}">
        <text class="empty-emoji">💸</text><text class="empty-text">暂无支出数据</text>
      </view>
    </view>

    <!-- 收入视图 -->
    <view wx:if="{{viewType==='income'}}">
      <view class="pie-card" wx:if="{{incomeBreakdown.length > 0}}">
        <text class="chart-title">💰 收入占比</text>
        <view class="bar-pie-row">
          <view class="bar-pie-chart">
            <view wx:for="{{incomeBreakdown}}" wx:key="category" class="bar-pie-bar" style="width:{{item.percent}}%;background:{{item.color || '#22c55e'}}"></view>
          </view>
          <view class="bar-pie-total"><text class="bpt-text">{{incomeBreakdown.length}}</text><text class="bpt-sub">类</text></view>
        </view>
        <view class="pie-legend">
          <view class="legend-item" wx:for="{{incomeBreakdown}}" wx:key="category">
            <view class="legend-dot" style="background:{{item.color || '#22c55e'}}"></view>
            <text class="legend-name">{{item.icon}} {{item.category}}</text>
            <text class="legend-pct">{{item.percent}}%</text>
            <text class="legend-amount">¥{{item.amount}}</text>
          </view>
        </view>
      </view>
      <!-- 收入趋势 -->
      <view class="chart-card" wx:if="{{incomeTrend.length > 0}}">
        <text class="chart-title">📈 收入趋势（近{{incomeTrend.length}}天）</text>
        <view class="bar-chart">
          <view class="bar-item" wx:for="{{incomeTrend}}" wx:key="date">
            <view class="bar-wrap"><view class="bar bar-income {{item.isToday?'bar-today':''}}" style="height:{{item.barHeight}}rpx"></view></view>
            <text class="bar-label">{{item.day}}</text>
          </view>
        </view>
      </view>
      <view class="breakdown-section" wx:if="{{incomeBreakdown.length > 0}}">
        <text class="breakdown-title income">💰 收入明细</text>
        <view class="breakdown-list">
          <view class="breakdown-item" wx:for="{{incomeBreakdown}}" wx:key="category">
            <view class="bi-left"><text class="bi-icon">{{item.icon}}</text><text class="bi-name">{{item.category}}</text></view>
            <view class="bi-right"><text class="bi-amount income">+¥{{item.amount}}</text><text class="bi-pct">{{item.percent}}%</text></view>
          </view>
        </view>
      </view>
      <view class="empty-state" wx:if="{{incomeBreakdown.length===0}}">
        <text class="empty-emoji">💰</text><text class="empty-text">暂无收入数据</text>
      </view>
    </view>

    <!-- 支付方式视图 -->
    <view wx:if="{{viewType==='payment'}}">
      <view class="pie-card" wx:if="{{paymentBreakdown.length > 0}}">
        <text class="chart-title">💳 支付方式占比</text>
        <view class="bar-pie-row">
          <view class="bar-pie-chart">
            <view wx:for="{{paymentBreakdown}}" wx:key="method" class="bar-pie-bar" style="width:{{item.percent}}%;background:{{item.color || '#8b5cf6'}}"></view>
          </view>
          <view class="bar-pie-total"><text class="bpt-text">{{paymentBreakdown.length}}</text><text class="bpt-sub">种</text></view>
        </view>
        <view class="pie-legend">
          <view class="legend-item" wx:for="{{paymentBreakdown}}" wx:key="method">
            <view class="legend-dot" style="background:{{item.color || '#8b5cf6'}}"></view>
            <text class="legend-name">{{item.icon}} {{item.label}}</text>
            <text class="legend-pct">{{item.percent}}%</text>
            <text class="legend-amount">¥{{item.amount}}</text>
          </view>
        </view>
      </view>
      <view class="breakdown-section" wx:if="{{paymentBreakdown.length > 0}}">
        <text class="breakdown-title">💳 支付明细</text>
        <view class="breakdown-list">
          <view class="breakdown-item" wx:for="{{paymentBreakdown}}" wx:key="method">
            <view class="bi-left"><text class="bi-icon">{{item.icon}}</text><text class="bi-name">{{item.label}}</text></view>
            <view class="bi-right"><text class="bi-amount expense">-¥{{item.amount}}</text><text class="bi-pct">{{item.percent}}%</text></view>
          </view>
        </view>
      </view>
      <view class="empty-state" wx:if="{{paymentBreakdown.length===0}}">
        <text class="empty-emoji">💳</text><text class="empty-text">暂无支付数据</text>
      </view>
    </view>

  </view>
</view>
