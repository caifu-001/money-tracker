<view class="page">
  <!-- 游客浏览提示条 -->
  <view class="guest-banner" wx:if="{{isGuest}}">
    <view class="gb-inner">
      <text class="gb-text">正在浏览，登录后即可查看完整分析</text>
      <text class="gb-login-btn" bindtap="goLogin">登录</text>
    </view>
  </view>

  <view class="header-card">
    <view class="header-circle header-circle1"></view>
    <view class="header-circle header-circle2"></view>
    <text class="header-title">数据分析</text>
  </view>
  <view class="month-nav-card">
    <view class="month-btn" wx:if="{{timeRange!=='all'}}" bindtap="prevMonth"><text>‹</text></view>
    <text class="month-label">{{monthLabel}}</text>
    <view class="month-btn" wx:if="{{timeRange!=='all'}}" bindtap="nextMonth"><text>›</text></view>
  </view>
  <view class="time-tabs">
    <view class="time-tab {{timeRange==='month'?'active':''}}" bindtap="setTime" data-range="month"><text>本月</text></view>
    <view class="time-tab {{timeRange==='quarter'?'active':''}}" bindtap="setTime" data-range="quarter"><text>本季</text></view>
    <view class="time-tab {{timeRange==='year'?'active':''}}" bindtap="setTime" data-range="year"><text>本年</text></view>
    <view class="time-tab {{timeRange==='all'?'active':''}}" bindtap="setTime" data-range="all"><text>全部</text></view>
    <view class="time-tab {{timeRange==='custom'?'active':''}}" bindtap="setTime" data-range="custom"><text>自定义</text></view>
  </view>
  <view class="date-range-card" wx:if="{{timeRange==='custom'}}">
    <input type="date" value="{{customStartDate}}" bindchange="onStartDateChange"/>
    <text class="date-sep">至</text>
    <input type="date" value="{{customEndDate}}" bindchange="onEndDateChange"/>
  </view>
  <view class="overview-card">
    <view class="ov-row">
      <view class="ov-item"><text class="ov-label">收入</text><text class="ov-value income">+{{baseSymbol}}{{totalIncome || 0}}</text></view>
      <view class="ov-item"><text class="ov-label">支出</text><text class="ov-value expense">-{{baseSymbol}}{{totalExpense || 0}}</text></view>
    </view>
    <view class="balance-row">
      <text class="balance-label">结余</text>
      <text class="balance-value {{balance>=0?'income':'expense'}}">{{balance >= 0 ? '+' : ''}}{{baseSymbol}}{{balance || 0}}</text>
    </view>
  </view>
  <!-- 外币待结算：银行未入账，未计入上方统计。点开可看是哪几笔 -->
  <view class="pending-banner" wx:if="{{pendingCount>0}}" bindtap="openPendingDetail">
    <text class="pb-text">⏳ {{pendingCount}} 笔外币待结算未计入<text wx:if="{{pendingRefTotal>0}}"> · 参考 {{baseSymbol}}{{pendingRefText}}</text></text>
    <text class="pb-more">查看 ›</text>
  </view>
  <!-- 转账：账户间划转，不是收支，也不进预算。点开跳到账户视图 -->
  <view class="transfer-banner" wx:if="{{!loading && transferCount>0}}" bindtap="goAccountView">
    <text class="pb-text">🔄 本期 {{transferCount}} 笔转账（合计 {{baseSymbol}}{{transferTotalText}}）不计入收支与预算</text>
    <text class="pb-more">查看 ›</text>
  </view>
  <view class="view-tabs">
    <view class="view-tab {{viewType==='expense'?'active':''}}" bindtap="switchView" data-type="expense"><text>💸 支出</text></view>
    <view class="view-tab {{viewType==='income'?'active':''}}" bindtap="switchView" data-type="income"><text>💰 收入</text></view>
    <view class="view-tab {{viewType==='account'?'active':''}}" bindtap="switchView" data-type="account"><text>🏦 账户</text></view>
    <view class="view-tab {{viewType==='loan'?'active':''}}" bindtap="switchView" data-type="loan"><text>🤝 借款</text></view>
  </view>
  <view class="loading" wx:if="{{loading}}"><text class="loading-text">加载中...</text></view>
  <view wx:if="{{!loading}}">

    <!-- 搜索卡片 - 全局适用 -->
    <view class="search-card">
      <input class="search-input" type="text" placeholder="{{searchPlaceholder}}" value="{{searchCat}}" bindinput="onSearchInput" bindconfirm="onSearchConfirm" confirm-type="search"/>
      <view class="search-clear" wx:if="{{searchCat}}" bindtap="clearSearch"><text>✕</text></view>
    </view>

    <!-- 分类目录筛选（借款视图不适用：借款没有消费分类） -->
    <view class="cat-filter-bar" wx:if="{{viewType!=='loan'}}">
      <view class="cf-btn" bindtap="toggleCatFilter">
        <text class="cf-icon">🗂️</text>
        <text class="cf-label">{{catFilterName || '按分类目录统计'}}</text>
        <text class="cf-arrow">›</text>
      </view>
      <view class="cf-clear" wx:if="{{catFilterName}}" bindtap="clearCatFilter"><text>✕ 清除</text></view>
    </view>
    <!-- 分类筛选激活提示 -->
    <view class="cat-filter-active" wx:if="{{catFilterName && viewType!=='loan'}}">
      <text class="cfa-text">当前统计目录：{{catFilterName}}（含 {{catFilterNames.length}} 个子分类）</text>
    </view>

    <!-- 借款搜索结果：按对方匹配，金额是净欠款 -->
    <view class="bd-card" wx:if="{{searchCat && searchResultKind==='loan' && searchResultList && searchResultList.length > 0}}">
      <view class="bd-head">
        <text class="bd-head-title">🔍 搜索结果</text>
        <text class="bd-head-sub">{{searchResultList.length}} 位对方</text>
      </view>
      <view class="ln-row" wx:for="{{searchResultList}}" wx:key="name" bindtap="openLoanDetail" data-party="{{item.name}}">
        <text class="ln-avatar">🤝</text>
        <view class="ln-mid">
          <text class="ln-name">{{item.name}}</text>
          <text class="ln-sub">{{item.percent}}</text>
        </view>
        <text class="ln-net {{item.cls}}">{{baseSymbol}}{{item.amount}}</text>
      </view>
    </view>

    <!-- 搜索结果 - 紧贴搜索框下方（统一组件，按当前视图决定匹配维度） -->
    <view class="bd-card" wx:if="{{searchCat && searchResultKind!=='loan' && searchResultList && searchResultList.length > 0}}">
      <view class="bd-head">
        <text class="bd-head-title">🔍 搜索结果</text>
        <text class="bd-head-sub">{{searchResultList.length}} 项</text>
      </view>
      <view class="bd-row" wx:for="{{searchResultList}}" wx:key="name">
        <view class="bd-row-top">
          <text class="bd-row-icon">{{item.icon}}</text>
          <text class="bd-row-name">{{item.name}}</text>
          <text class="bd-row-amt {{item.cls}}">{{item.sign}}{{baseSymbol}}{{item.amount}}</text>
        </view>
        <view class="bd-row-bar">
          <view class="bd-track"><view class="bd-fill {{item.cls}}" style="width:{{item.percent}}%"></view></view>
          <text class="bd-pct">{{item.percent}}%</text>
        </view>
      </view>
    </view>
    <view class="empty-state" wx:if="{{searchCat && searchResultList && searchResultList.length === 0}}">
      <text class="empty-text">未找到匹配「{{searchCat}}」的结果</text>
    </view>

    <!-- 支出视图：分组维度（分类 / 支付方式）——把原「支付」一级 Tab 降级到这里 -->
    <view class="stat-mode-toggle" wx:if="{{viewType==='expense'}}">
      <text class="stat-mode-label">分组</text>
      <view class="mode-btn {{expenseDim==='category'?'active':''}}" bindtap="switchExpenseDim" data-dim="category"><text>按分类</text></view>
      <view class="mode-btn {{expenseDim==='payment'?'active':''}}" bindtap="switchExpenseDim" data-dim="payment"><text>按支付方式</text></view>
    </view>

    <!-- 统计粒度（小类/大类）：仅按分类统计时才有意义 -->
    <view class="stat-mode-toggle" wx:if="{{(viewType==='expense' && expenseDim==='category') || viewType==='income'}}">
      <text class="stat-mode-label">统计</text>
      <view class="mode-btn {{statMode==='detail'?'active':''}}" bindtap="switchStatMode" data-mode="detail"><text>小类</text></view>
      <view class="mode-btn {{statMode==='summary'?'active':''}}" bindtap="switchStatMode" data-mode="summary"><text>大类</text></view>
    </view>

    <!-- 支出视图：按分类 -->
    <view wx:if="{{viewType==='expense' && expenseDim==='category'}}">
      <!-- 支出构成：一图一说，进度条即占比，明细即图例 -->
      <view class="bd-card" wx:if="{{expenseBreakdown.length > 0}}">
        <view class="bd-head">
          <text class="bd-head-title">💸 支出构成</text>
          <text class="bd-head-sub">{{expenseBreakdown.length}} 类 · 共 {{baseSymbol}}{{totalExpense}}</text>
        </view>
        <view class="bd-row" wx:for="{{expenseBreakdown}}" wx:key="category" bindtap="openCategoryDetail" data-cat="{{item.category}}" data-type="expense">
          <view class="bd-row-top">
            <text class="bd-row-icon">{{item.icon}}</text>
            <text class="bd-row-name">{{item.category}}</text>
            <text class="bd-row-amt expense">-{{baseSymbol}}{{item.amount}}</text>
          </view>
          <view class="bd-row-bar">
            <view class="bd-track"><view class="bd-fill expense" style="width:{{item.percent}}%"></view></view>
            <text class="bd-pct">{{item.percent}}%</text>
          </view>
          <view class="sub-items" wx:if="{{item.subItems && item.subItems.length}}">
            <view class="sub-item" wx:for="{{item.subItems}}" wx:for-item="sub" wx:key="category" catchtap="openCategoryDetail" data-cat="{{sub.category}}" data-type="expense">
              <text class="sub-icon">{{sub.icon}}</text>
              <text class="sub-name">{{sub.category}}</text>
              <view class="sub-right">
                <text class="sub-amount expense">{{baseSymbol}}{{sub.amount}}</text>
                <text class="sub-pct">{{sub.percent}}%</text>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view class="chart-card" wx:if="{{dailyTrend.length > 0}}">
        <text class="chart-title">📊 支出趋势（近{{dailyTrend.length}}天）</text>
        <view class="bar-chart">
          <view class="bar-item" wx:for="{{dailyTrend}}" wx:key="date">
            <view class="bar-wrap"><view class="bar {{item.isToday?'bar-today':''}}" style="height:{{item.barHeight}}rpx"></view></view>
            <text class="bar-label">{{item.day}}</text>
          </view>
        </view>
      </view>
      <view class="cat-budget-section" wx:if="{{expenseCats.length > 0}}">
        <text class="section-title-bar">💰 支出类别</text>
        <view class="cat-grid">
          <view class="cat-badge {{item.hasBudget?'has-budget':''}}" wx:for="{{expenseCats}}" wx:key="name" bindtap="openBudgetSet" data-name="{{item.name}}" data-icon="{{item.icon}}" data-has="{{item.hasBudget}}">
            <text class="cb-icon">{{item.icon}}</text>
            <text class="cb-name">{{item.name}}</text>
            <text class="cb-dot" wx:if="{{item.hasBudget}}">●</text>
          </view>
        </view>
      </view>
      <view class="empty-state" wx:if="{{expenseBreakdown.length===0 && dailyTrend.length===0}}">
        <text class="empty-emoji">💸</text><text class="empty-text">暂无支出数据</text>
      </view>
    </view>

    <!-- 收入视图 -->
    <view wx:if="{{viewType==='income'}}">
      <view class="bd-card" wx:if="{{incomeBreakdown.length > 0}}">
        <view class="bd-head">
          <text class="bd-head-title">💰 收入构成</text>
          <text class="bd-head-sub">{{incomeBreakdown.length}} 类 · 共 {{baseSymbol}}{{totalIncome}}</text>
        </view>
        <view class="bd-row" wx:for="{{incomeBreakdown}}" wx:key="category" bindtap="openCategoryDetail" data-cat="{{item.category}}" data-type="income">
          <view class="bd-row-top">
            <text class="bd-row-icon">{{item.icon}}</text>
            <text class="bd-row-name">{{item.category}}</text>
            <text class="bd-row-amt income">+{{baseSymbol}}{{item.amount}}</text>
          </view>
          <view class="bd-row-bar">
            <view class="bd-track"><view class="bd-fill income" style="width:{{item.percent}}%"></view></view>
            <text class="bd-pct">{{item.percent}}%</text>
          </view>
        </view>
      </view>
      <!-- 收入趋势 -->
      <view class="chart-card" wx:if="{{incomeTrend.length > 0}}">
        <text class="chart-title">📈 收入趋势（近{{incomeTrend.length}}天）</text>
        <view class="bar-chart">
          <view class="bar-item" wx:for="{{incomeTrend}}" wx:key="date">
            <view class="bar-wrap"><view class="bar bar-income {{item.isToday?'bar-today':''}}" style="height:{{item.barHeight}}rpx"></view></view>
            <text class="bar-label">{{item.day}}</text>
          </view>
        </view>
      </view>
      <view class="empty-state" wx:if="{{incomeBreakdown.length===0}}">
        <text class="empty-emoji">💰</text><text class="empty-text">暂无收入数据</text>
      </view>
    </view>

    <!-- 支出视图：按支付方式（原「支付」一级 Tab） -->
    <view wx:if="{{viewType==='expense' && expenseDim==='payment'}}">
      <view class="bd-card" wx:if="{{paymentBreakdown.length > 0}}">
        <view class="bd-head">
          <text class="bd-head-title">💳 支付方式构成</text>
          <text class="bd-head-sub">{{paymentBreakdown.length}} 种 · 共 {{baseSymbol}}{{totalExpense}}</text>
        </view>
        <view class="bd-row" wx:for="{{paymentBreakdown}}" wx:key="method" bindtap="openCategoryDetail" data-method="{{item.method}}" data-type="payment">
          <view class="bd-row-top">
            <text class="bd-row-icon">{{item.icon}}</text>
            <text class="bd-row-name">{{item.label}}</text>
            <text class="bd-row-amt expense">-{{baseSymbol}}{{item.amount}}</text>
          </view>
          <view class="bd-row-bar">
            <view class="bd-track"><view class="bd-fill expense" style="width:{{item.percent}}%"></view></view>
            <text class="bd-pct">{{item.percent}}%</text>
          </view>
        </view>
        <text class="bd-foot">仅统计支出。同一笔支出若更换账户，请到「账户」视图查看资金流向</text>
      </view>
      <view class="empty-state" wx:if="{{paymentBreakdown.length===0}}">
        <text class="empty-emoji">💳</text><text class="empty-text">暂无支付数据</text>
      </view>
    </view>

    <!-- 资金账户视图 -->
    <view wx:if="{{viewType==='account'}}">
      <!-- 支出账户 -->
      <view class="bd-card" wx:if="{{accountBreakdown.length > 0}}">
        <view class="bd-head">
          <text class="bd-head-title">💸 支出账户</text>
          <text class="bd-head-sub">{{accountBreakdown.length}} 个 · 共 {{baseSymbol}}{{totalExpense}}</text>
        </view>
        <view class="bd-row" wx:for="{{accountBreakdown}}" wx:key="accId" bindtap="openAccountDetail" data-id="{{item.accId}}" data-name="{{item.category}}" data-flow="expense">
          <view class="bd-row-top">
            <text class="bd-row-icon">{{item.icon}}</text>
            <text class="bd-row-name">{{item.category}}</text>
            <text class="bd-row-amt account">-{{baseSymbol}}{{item.amount}}</text>
          </view>
          <view class="bd-row-bar">
            <view class="bd-track"><view class="bd-fill account" style="width:{{item.percent}}%"></view></view>
            <text class="bd-pct">{{item.percent}}%</text>
          </view>
        </view>
      </view>

      <!-- 收入账户 -->
      <view class="bd-card" wx:if="{{accountIncomeBreakdown.length > 0}}">
        <view class="bd-head">
          <text class="bd-head-title">💰 收入账户</text>
          <text class="bd-head-sub">{{accountIncomeBreakdown.length}} 个 · 共 {{baseSymbol}}{{totalIncome}}</text>
        </view>
        <view class="bd-row" wx:for="{{accountIncomeBreakdown}}" wx:key="accId" bindtap="openAccountDetail" data-id="{{item.accId}}" data-name="{{item.category}}" data-flow="income">
          <view class="bd-row-top">
            <text class="bd-row-icon">{{item.icon}}</text>
            <text class="bd-row-name">{{item.category}}</text>
            <text class="bd-row-amt income">+{{baseSymbol}}{{item.amount}}</text>
          </view>
          <view class="bd-row-bar">
            <view class="bd-track"><view class="bd-fill income" style="width:{{item.percent}}%"></view></view>
            <text class="bd-pct">{{item.percent}}%</text>
          </view>
        </view>
      </view>

      <!-- 转账流动：转账不计收支，只有这里能看到 -->
      <view class="bd-card" wx:if="{{transferCount > 0}}">
        <view class="bd-head">
          <text class="bd-head-title">🔄 转账流动</text>
          <text class="bd-head-sub">{{transferCount}} 笔 · 共 {{baseSymbol}}{{transferTotalText}}</text>
        </view>
        <view class="bd-row" wx:for="{{transferList}}" wx:key="id" bindtap="editTransaction" data-id="{{item.id}}">
          <view class="bd-row-top">
            <text class="bd-row-icon">{{item.fromIcon}}</text>
            <text class="bd-row-name">{{item.fromName}} → {{item.toName}}</text>
            <text class="bd-row-amt transfer">{{baseSymbol}}{{item.amount}}</text>
          </view>
          <view class="bd-row-bar">
            <text class="tf-date">{{item.date}}{{item.note?' · '+item.note:''}}</text>
          </view>
        </view>
        <text class="bd-foot">转账不产生收入或支出，只改变账户余额</text>
      </view>

      <view class="empty-state" wx:if="{{accountBreakdown.length===0 && accountIncomeBreakdown.length===0 && transferCount===0}}">
        <text class="empty-emoji">🏦</text><text class="empty-text">暂无账户数据</text>
      </view>
    </view>

    <!-- 借款视图（022）：欠款是存量，用全量借款算，不受月份筛选影响 -->
    <view wx:if="{{viewType==='loan'}}">
      <view class="loan-glance">
        <view class="lg-item">
          <text class="lg-label">待收回</text>
          <text class="lg-value receivable">{{loanSummary.receivableText}}</text>
          <text class="lg-sub">别人欠我</text>
        </view>
        <view class="lg-split"></view>
        <view class="lg-item">
          <text class="lg-label">待偿还</text>
          <text class="lg-value payable">{{loanSummary.payableText}}</text>
          <text class="lg-sub">我欠别人</text>
        </view>
      </view>
      <view class="loan-net-bar">
        <text class="lnb-label">净头寸</text>
        <text class="lnb-value {{loanSummary.netPositive?'payable':'receivable'}}">{{loanSummary.netText}}</text>
        <text class="lnb-hint">{{loanSummary.netPositive ? '净欠别人' : '净借出'}}</text>
        <text class="lnb-foot">累计 · 不受月份筛选</text>
      </view>

      <view class="bd-card" wx:if="{{loanParties.length > 0}}">
        <view class="bd-head">
          <text class="bd-head-title">🤝 按对方结算</text>
          <text class="bd-head-sub">{{loanOpenCount}} 人未结清 / 共 {{loanPartyCount}} 人</text>
        </view>
        <view class="ln-row" wx:for="{{loanParties}}" wx:key="party" bindtap="openLoanDetail" data-party="{{item.party}}">
          <text class="ln-avatar">🤝</text>
          <view class="ln-mid">
            <text class="ln-name">{{item.party}}</text>
            <text class="ln-sub">{{item.count}} 笔 · 最近 {{item.lastDate}}</text>
          </view>
          <view class="ln-right">
            <text class="ln-net {{item.kind}}">{{baseSymbol}}{{item.netText}}</text>
            <text class="ln-tag {{item.kind}}">{{item.netLabel}}</text>
          </view>
        </view>
        <text class="bd-foot">借款不计入收支与预算。还钱时反向记一笔（借出→收入记借入），两条自动抵消。</text>
      </view>

      <view class="empty-state" wx:if="{{loanParties.length===0}}">
        <text class="empty-emoji">🤝</text>
        <text class="empty-text">还没有借款记录</text>
        <text class="loan-empty-hint">记账时勾选「🤝 借款」：在支出里记 = 借出，在收入里记 = 借入</text>
      </view>
    </view>

  </view>

  <!-- 外币待结算明细弹窗 -->
  <view class="detail-mask" wx:if="{{showPending}}" bindtap="closePending"></view>
  <view class="detail-sheet {{showPending?'show':''}}">
    <view class="detail-header">
      <text class="detail-title">⏳ 外币待结算（{{pendingDetailList.length}} 笔）</text>
      <view class="detail-close" bindtap="closePending"><text>✕</text></view>
    </view>
    <view class="pending-tip">
      <text>银行最终扣款金额尚未确定，这些账目<text class="hl">未计入</text>上方任何统计。账单出来后点进该笔账单，填入实际扣款金额即可转为已结算。</text>
    </view>
    <scroll-view class="detail-body" scroll-y>
      <view class="detail-item" wx:for="{{pendingDetailList}}" wx:key="id" bindtap="editTransaction" data-id="{{item.id}}">
        <view class="detail-item-left">
          <text class="detail-item-date">{{item.date}} · {{item.category}}</text>
          <text class="detail-item-note">{{item.payText}}{{item.note?' · '+item.note:''}}</text>
        </view>
        <view class="detail-item-right">
          <text class="detail-item-amount expense">{{item.originalText}}</text>
          <text class="detail-item-pay" wx:if="{{item.refText}}">参考 {{item.refText}}</text>
        </view>
        <text class="detail-item-arrow">›</text>
      </view>
      <view class="detail-empty" wx:if="{{pendingDetailList.length===0}}">
        <text>暂无待结算账单</text>
      </view>
    </scroll-view>
    <view class="pending-foot">
      <text>合计参考 {{baseSymbol}}{{pendingRefText}}，仅供参考，以银行实际扣款为准</text>
    </view>
  </view>

  <!-- 借款明细弹窗：某个对方的每一笔借出 / 借入 -->
  <view class="detail-mask" wx:if="{{showLoanDetail}}" bindtap="closeLoanDetail"></view>
  <view class="detail-sheet {{showLoanDetail?'show':''}}">
    <view class="detail-header">
      <text class="detail-title">🤝 {{loanDetailTitle}}</text>
      <view class="detail-close" bindtap="closeLoanDetail"><text>✕</text></view>
    </view>
    <view class="loan-detail-net {{loanDetailKind}}">
      <text class="ldn-label">{{loanDetailNetLabel}}</text>
      <text class="ldn-value">{{baseSymbol}}{{loanDetailNetText}}</text>
    </view>
    <scroll-view class="detail-body" scroll-y>
      <view class="detail-item" wx:for="{{loanDetailList}}" wx:key="id" bindtap="editLoanTx" data-id="{{item.id}}" data-date="{{item.date}}">
        <view class="detail-item-left">
          <text class="detail-item-cat">{{item.dirLabel}}</text>
          <text class="detail-item-date">{{item.date}}{{item.note?' · '+item.note:''}}</text>
        </view>
        <text class="loan-detail-amt {{item.dir}}">{{item.sign}}{{baseSymbol}}{{item.amountText}}</text>
        <text class="detail-item-arrow">›</text>
      </view>
      <view class="detail-empty" wx:if="{{loanDetailList.length===0}}">
        <text>暂无借款流水</text>
      </view>
    </scroll-view>
    <view class="pending-foot">
      <text>净额 = 借入合计 − 借出合计，为 0 即已结清</text>
    </view>
  </view>

  <!-- 分类明细账单弹窗 -->
  <view class="detail-mask" wx:if="{{showDetail}}" bindtap="closeDetail"></view>
  <view class="detail-sheet {{showDetail?'show':''}}">
    <view class="detail-header">
      <text class="detail-title">{{detailTitle}}</text>
      <view class="detail-close" bindtap="closeDetail"><text>✕</text></view>
    </view>
    <scroll-view class="detail-body" scroll-y>
      <view class="detail-item" wx:for="{{detailList}}" wx:key="id" bindtap="editTransaction" data-id="{{item.id}}">
        <view class="detail-item-left">
          <text class="detail-item-date">{{item.date}}</text>
          <text class="detail-item-note" wx:if="{{item.note}}">{{item.note}}</text>
        </view>
        <view class="detail-item-right">
          <text class="detail-item-amount {{item.type==='expense'?'expense':'income'}}">{{item.type==='expense'?'-':'+'}}{{baseSymbol}}{{item.amount}}</text>
          <text class="detail-item-pay">{{item.paymentDisplay}}</text>
        </view>
        <text class="detail-item-arrow">›</text>
      </view>
      <view class="detail-empty" wx:if="{{detailList.length===0}}">
        <text>暂无账单</text>
      </view>
    </scroll-view>
  </view>

  <!-- 分类目录选择弹窗 -->
  <view class="detail-mask" wx:if="{{showCatFilter}}" bindtap="closeCatFilter"></view>
  <view class="detail-sheet {{showCatFilter?'show':''}}">
    <view class="detail-header">
      <text class="detail-title">选择统计目录</text>
      <view class="detail-close" bindtap="closeCatFilter"><text>✕</text></view>
    </view>
    <view class="cf-type-tabs">
      <view class="cf-type-tab {{filterType==='expense'?'active':''}}" bindtap="setFilterType" data-type="expense"><text>💸 支出</text></view>
      <view class="cf-type-tab {{filterType==='income'?'active':''}}" bindtap="setFilterType" data-type="income"><text>💰 收入</text></view>
    </view>
    <scroll-view class="detail-body" scroll-y>
      <view class="cf-tree" wx:if="{{filterType==='expense'}}">
        <block wx:for="{{filterExpenseTree}}" wx:key="id" wx:for-item="n1">
          <view class="cf-node" style="padding-left:{{24+(n1.depth-1)*36}}rpx">
            <view class="cf-expand {{n1.children.length?'has':''}}" bindtap="toggleFilterExpand" data-id="{{n1.id}}">
              <text wx:if="{{n1.children.length}}">{{n1.expanded?'▼':'▶'}}</text>
              <text wx:else>·</text>
            </view>
            <view class="cf-node-main" bindtap="selectFilterNode" data-id="{{n1.id}}" data-name="{{n1.name}}" data-type="expense">
              <text class="cf-node-icon">{{n1.icon}}</text>
              <text class="cf-node-name">{{n1.name}}</text>
              <text class="cf-node-check" wx:if="{{catFilterId===n1.id}}">✓</text>
            </view>
          </view>
          <block wx:if="{{n1.expanded}}">
            <block wx:for="{{n1.children}}" wx:for-item="n2" wx:key="id">
              <view class="cf-node" style="padding-left:{{24+(n2.depth-1)*36}}rpx">
                <view class="cf-expand {{n2.children.length?'has':''}}" bindtap="toggleFilterExpand" data-id="{{n2.id}}">
                  <text wx:if="{{n2.children.length}}">{{n2.expanded?'▼':'▶'}}</text>
                  <text wx:else>·</text>
                </view>
                <view class="cf-node-main" bindtap="selectFilterNode" data-id="{{n2.id}}" data-name="{{n2.name}}" data-type="expense">
                  <text class="cf-node-icon">{{n2.icon}}</text>
                  <text class="cf-node-name">{{n2.name}}</text>
                  <text class="cf-node-check" wx:if="{{catFilterId===n2.id}}">✓</text>
                </view>
              </view>
              <block wx:if="{{n2.expanded}}">
                <block wx:for="{{n2.children}}" wx:for-item="n3" wx:key="id">
                  <view class="cf-node" style="padding-left:{{24+(n3.depth-1)*36}}rpx">
                    <view class="cf-expand {{n3.children.length?'has':''}}" bindtap="toggleFilterExpand" data-id="{{n3.id}}">
                      <text wx:if="{{n3.children.length}}">{{n3.expanded?'▼':'▶'}}</text>
                      <text wx:else>·</text>
                    </view>
                    <view class="cf-node-main" bindtap="selectFilterNode" data-id="{{n3.id}}" data-name="{{n3.name}}" data-type="expense">
                      <text class="cf-node-icon">{{n3.icon}}</text>
                      <text class="cf-node-name">{{n3.name}}</text>
                      <text class="cf-node-check" wx:if="{{catFilterId===n3.id}}">✓</text>
                    </view>
                  </view>
                  <block wx:if="{{n3.expanded}}">
                    <block wx:for="{{n3.children}}" wx:for-item="n4" wx:key="id">
                      <view class="cf-node" style="padding-left:{{24+(n4.depth-1)*36}}rpx">
                        <view class="cf-expand"><text>·</text></view>
                        <view class="cf-node-main" bindtap="selectFilterNode" data-id="{{n4.id}}" data-name="{{n4.name}}" data-type="expense">
                          <text class="cf-node-icon">{{n4.icon}}</text>
                          <text class="cf-node-name">{{n4.name}}</text>
                          <text class="cf-node-check" wx:if="{{catFilterId===n4.id}}">✓</text>
                        </view>
                      </view>
                    </block>
                  </block>
                </block>
              </block>
            </block>
          </block>
        </block>
      </view>
      <view class="cf-tree" wx:if="{{filterType==='income'}}">
        <block wx:for="{{filterIncomeTree}}" wx:key="id" wx:for-item="n1">
          <view class="cf-node" style="padding-left:{{24+(n1.depth-1)*36}}rpx">
            <view class="cf-expand {{n1.children.length?'has':''}}" bindtap="toggleFilterExpand" data-id="{{n1.id}}">
              <text wx:if="{{n1.children.length}}">{{n1.expanded?'▼':'▶'}}</text>
              <text wx:else>·</text>
            </view>
            <view class="cf-node-main" bindtap="selectFilterNode" data-id="{{n1.id}}" data-name="{{n1.name}}" data-type="income">
              <text class="cf-node-icon">{{n1.icon}}</text>
              <text class="cf-node-name">{{n1.name}}</text>
              <text class="cf-node-check" wx:if="{{catFilterId===n1.id}}">✓</text>
            </view>
          </view>
          <block wx:if="{{n1.expanded}}">
            <block wx:for="{{n1.children}}" wx:for-item="n2" wx:key="id">
              <view class="cf-node" style="padding-left:{{24+(n2.depth-1)*36}}rpx">
                <view class="cf-expand {{n2.children.length?'has':''}}" bindtap="toggleFilterExpand" data-id="{{n2.id}}">
                  <text wx:if="{{n2.children.length}}">{{n2.expanded?'▼':'▶'}}</text>
                  <text wx:else>·</text>
                </view>
                <view class="cf-node-main" bindtap="selectFilterNode" data-id="{{n2.id}}" data-name="{{n2.name}}" data-type="income">
                  <text class="cf-node-icon">{{n2.icon}}</text>
                  <text class="cf-node-name">{{n2.name}}</text>
                  <text class="cf-node-check" wx:if="{{catFilterId===n2.id}}">✓</text>
                </view>
              </view>
              <block wx:if="{{n2.expanded}}">
                <block wx:for="{{n2.children}}" wx:for-item="n3" wx:key="id">
                  <view class="cf-node" style="padding-left:{{24+(n3.depth-1)*36}}rpx">
                    <view class="cf-expand {{n3.children.length?'has':''}}" bindtap="toggleFilterExpand" data-id="{{n3.id}}">
                      <text wx:if="{{n3.children.length}}">{{n3.expanded?'▼':'▶'}}</text>
                      <text wx:else>·</text>
                    </view>
                    <view class="cf-node-main" bindtap="selectFilterNode" data-id="{{n3.id}}" data-name="{{n3.name}}" data-type="income">
                      <text class="cf-node-icon">{{n3.icon}}</text>
                      <text class="cf-node-name">{{n3.name}}</text>
                      <text class="cf-node-check" wx:if="{{catFilterId===n3.id}}">✓</text>
                    </view>
                  </view>
                  <block wx:if="{{n3.expanded}}">
                    <block wx:for="{{n3.children}}" wx:for-item="n4" wx:key="id">
                      <view class="cf-node" style="padding-left:{{24+(n4.depth-1)*36}}rpx">
                        <view class="cf-expand"><text>·</text></view>
                        <view class="cf-node-main" bindtap="selectFilterNode" data-id="{{n4.id}}" data-name="{{n4.name}}" data-type="income">
                          <text class="cf-node-icon">{{n4.icon}}</text>
                          <text class="cf-node-name">{{n4.name}}</text>
                          <text class="cf-node-check" wx:if="{{catFilterId===n4.id}}">✓</text>
                        </view>
                      </view>
                    </block>
                  </block>
                </block>
              </block>
            </block>
          </block>
        </block>
      </view>
      <view class="detail-empty" wx:if="{{(filterType==='expense' && filterExpenseTree.length===0) || (filterType==='income' && filterIncomeTree.length===0)}}">
        <text>暂无分类</text>
      </view>
    </scroll-view>
  </view>
</view>
