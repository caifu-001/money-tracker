/* pages/categories/categories.wxss */
.page { background: #f3f4f6; min-height: 100vh; padding: 32rpx; padding-bottom: 120rpx; }

.page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 32rpx; }
.page-title { font-size: 40rpx; font-weight: 700; color: #1f2937; }
.add-btn { background: linear-gradient(135deg,#6366f1,#8b5cf6); color: white; border-radius: 20rpx; padding: 14rpx 28rpx; font-size: 26rpx; font-weight: 600; }

.form-card { background: white; border-radius: 28rpx; padding: 32rpx; box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06); margin-bottom: 24rpx; }
.form-title { font-size: 28rpx; font-weight: 600; color: #374151; display: block; margin-bottom: 20rpx; }
.type-tabs { display: flex; background: #f3f4f6; border-radius: 20rpx; padding: 6rpx; margin-bottom: 20rpx; }
.type-tab { flex: 1; text-align: center; padding: 16rpx 0; border-radius: 16rpx; font-size: 26rpx; font-weight: 600; color: #9ca3af; }
.type-tab.active-expense { background: white; color: #ef4444; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08); }
.type-tab.active-income  { background: white; color: #22c55e; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08); }

.icon-name-row { display: flex; gap: 16rpx; margin-bottom: 20rpx; align-items: center; }
.icon-input { width: 80rpx; height: 80rpx; border: 3rpx solid #e5e7eb; border-radius: 16rpx; text-align: center; font-size: 36rpx; background: #f9fafb; flex-shrink: 0; }
.name-input { flex: 1; padding: 20rpx 24rpx; border: 3rpx solid #e5e7eb; border-radius: 16rpx; font-size: 28rpx; background: #f9fafb; }
.btn-row { display: flex; gap: 16rpx; }
.btn-confirm { flex: 1; background: #6366f1 !important; color: white !important; border-radius: 16rpx !important; padding: 20rpx 0 !important; font-size: 28rpx !important; font-weight: 600 !important; border: none !important; }
.btn-cancel  { flex: 1; background: #f3f4f6 !important; color: #6b7280 !important; border-radius: 16rpx !important; padding: 20rpx 0 !important; font-size: 28rpx !important; font-weight: 600 !important; border: none !important; }
.btn-confirm::after, .btn-cancel::after { border: none; }

.loading { text-align: center; padding: 80rpx; color: #9ca3af; }

.section { background: white; border-radius: 28rpx; padding: 28rpx; box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06); margin-bottom: 24rpx; }
.section-title { font-size: 30rpx; font-weight: 700; display: block; margin-bottom: 20rpx; }
.expense-color { color: #ef4444; }
.income-color  { color: #16a34a; }
.sub-title { font-size: 22rpx; color: #9ca3af; display: block; margin-bottom: 16rpx; }

.preset-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 28rpx; }
.preset-item { width: calc(25% - 12rpx); background: #f9fafb; border-radius: 20rpx; padding: 20rpx 8rpx; text-align: center; border: 1rpx solid #f3f4f6; }
.preset-icon { font-size: 44rpx; display: block; margin-bottom: 8rpx; }
.preset-name { font-size: 22rpx; color: #374151; font-weight: 500; display: block; }

.empty-custom { font-size: 26rpx; color: #d1d5db; text-align: center; padding: 24rpx 0; }

.cat-row { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 16rpx; background: #f9fafb; border-radius: 20rpx; margin-bottom: 8rpx; border: 3rpx solid transparent; }
.cat-row.highlighted { border-color: #6366f1; background: #eef2ff; }
.cat-row.editing     { border-color: #6366f1; }
.child-row { margin-left: 40rpx; background: #f3f4f6; }

.expand-btn { width: 40rpx; flex-shrink: 0; font-size: 28rpx; color: #9ca3af; text-align: center; }
.expand-placeholder { width: 40rpx; flex-shrink: 0; }
.child-indent { width: 60rpx; }

.cat-icon { font-size: 40rpx; flex-shrink: 0; }
.cat-info { flex: 1; min-width: 0; }
.cat-name { font-size: 28rpx; font-weight: 500; color: #1f2937; display: block; }
.cat-meta { font-size: 22rpx; color: #9ca3af; display: block; margin-top: 4rpx; }
.cat-actions { display: flex; gap: 12rpx; flex-shrink: 0; align-items: center; }
.action-edit    { font-size: 28rpx; }
.action-add     { font-size: 22rpx; background: #f0f0f0; color: #6b7280; padding: 6rpx 14rpx; border-radius: 12rpx; font-weight: 600; }
.action-del     { font-size: 28rpx; }
.action-confirm { font-size: 32rpx; color: #6366f1; font-weight: 700; padding: 0 8rpx; }
.action-cancel  { font-size: 32rpx; color: #9ca3af; padding: 0 8rpx; }

.edit-icon-input { width: 64rpx; height: 64rpx; border: 3rpx solid #6366f1; border-radius: 12rpx; text-align: center; font-size: 28rpx; background: white; flex-shrink: 0; }
.edit-name-input { flex: 1; padding: 14rpx 18rpx; border: 3rpx solid #6366f1; border-radius: 16rpx; font-size: 26rpx; background: white; }

.inline-form { background: white; border-radius: 20rpx; padding: 24rpx; margin: 0 0 12rpx 40rpx; border: 3rpx solid #e0e7ff; box-shadow: 0 4rpx 16rpx rgba(99,102,241,0.1); }
.inline-title { font-size: 24rpx; color: #6366f1; font-weight: 600; display: block; margin-bottom: 16rpx; }
