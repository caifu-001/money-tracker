/* pages/categories/categories.wxss */
page { background: #f0f2f7; }
.page { min-height: 100vh; padding-bottom: 140rpx; }

/* ── 游客提示 ─────────────────────────────── */
.guest-tip-card {
  margin: 32rpx 32rpx 0;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  border-radius: 24rpx;
  padding: 40rpx;
  text-align: center;
}
.guest-tip-card text { display: block; }
.guest-tip-icon { font-size: 64rpx; margin-bottom: 16rpx; }
.guest-tip-title { font-size: 32rpx; font-weight: 700; color: white; margin-bottom: 12rpx; }
.guest-tip-desc { font-size: 24rpx; color: rgba(255,255,255,0.8); margin-bottom: 24rpx; }
.guest-tip-btn {
  background: white; color: #6366f1;
  font-size: 28rpx; font-weight: 700;
  padding: 20rpx 40rpx; border-radius: 24rpx;
  display: inline-block;
}

/* ── 顶部头部 ─────────────────────────────── */
.header-card {
  position: relative; overflow: hidden;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  padding: 60rpx 40rpx 80rpx;
}
.header-bg {
  position: absolute; top: -80rpx; right: -80rpx;
  width: 320rpx; height: 320rpx;
  background: rgba(255,255,255,0.08); border-radius: 50%;
}
.header-title { display: block; color: #fff; font-size: 44rpx; font-weight: 700; letter-spacing: 2rpx; }
.header-sub   { display: block; color: rgba(255,255,255,0.7); font-size: 26rpx; margin-top: 8rpx; }

/* ── Tab 切换 ─────────────────────────────── */
.type-tabs {
  display: flex; margin: -40rpx 32rpx 0;
  background: #fff; border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.10);
  overflow: hidden; position: relative; z-index: 10;
}
.tab-item {
  flex: 1; display: flex; flex-direction: column;
  align-items: center; padding: 28rpx 0;
}
.tab-icon { font-size: 36rpx; }
.tab-text { font-size: 26rpx; color: #9ca3af; margin-top: 6rpx; font-weight: 500; }
.active-exp { background: linear-gradient(135deg, #fef3c7, #fee2e2); }
.active-exp .tab-text { color: #ef4444; font-weight: 700; }
.active-inc { background: linear-gradient(135deg, #d1fae5, #a7f3d0); }
.active-inc .tab-text { color: #10b981; font-weight: 700; }

/* ── 添加按钮 ─────────────────────────────── */
.add-bar {
  margin: 32rpx 32rpx 0;
  background: white;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.add-bar .add-icon { font-size: 40rpx; color: #6366f1; font-weight: 300; }
.add-bar .add-text { font-size: 28rpx; color: #1f2937; font-weight: 600; }

/* ── 分类列表 ─────────────────────────────── */
.cat-list { margin: 24rpx 32rpx; }

.ci-icon-text {
  width: 80rpx; height: 80rpx; border-radius: 20rpx;
  background: #f3f4f6; display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; flex-shrink: 0;
}
.ci-expand {
  width: 48rpx; height: 48rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: #9ca3af;
  flex-shrink: 0;
}
.ci-expand.has-children { color: #6366f1; cursor: pointer; }
.ci-expand.expanded { color: #8b5cf6; }
.cat-item.child { background: #fafafa; }
.cat-item {
  display: flex; align-items: center; gap: 20rpx;
  background: #fff; border-radius: 24rpx; padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}
.ci-name { flex: 1; font-size: 30rpx; font-weight: 600; color: #1f2937; }
.ci-actions { display: flex; gap: 10rpx; flex-shrink: 0; }
.ci-btn {
  font-size: 22rpx; padding: 8rpx 16rpx; border-radius: 20rpx; font-weight: 600;
}
.ci-btn-inline { background: #ede9fe; color: #7c3aed; }
.ci-btn-edit  { background: #e0e7ff; color: #6366f1; }
.ci-btn-move  { background: #dbeafe; color: #1d4ed8; }
.ci-btn-del   { background: #fee2e2; color: #ef4444; }

/* 加载/空状态 */
.loading { text-align: center; padding: 80rpx 32rpx; color: #9ca3af; font-size: 28rpx; }
.empty-state { text-align: center; padding: 60rpx 32rpx; color: #9ca3af; font-size: 28rpx; }

/* ── 底部弹窗 ─────────────────────────────── */
.modal-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); z-index: 100;
}
.modal-sheet {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #fff; border-radius: 40rpx 40rpx 0 0;
  padding: 24rpx 40rpx 60rpx; z-index: 101;
  transform: translateY(100%); transition: transform 0.3s ease;
}
.modal-sheet.show { transform: translateY(0); }
.sheet-handle {
  width: 80rpx; height: 8rpx; background: #e5e7eb; border-radius: 4rpx;
  margin: 0 auto 32rpx;
}
.sheet-title { display: block; font-size: 34rpx; font-weight: 700; color: #1f2937; margin-bottom: 32rpx; text-align: center; }
.sheet-parent-name { display: block; font-size: 24rpx; color: #9ca3af; text-align: center; margin-bottom: 24rpx; }
.sheet-row { display: flex; align-items: center; margin-bottom: 24rpx; gap: 20rpx; }
.sheet-label { font-size: 28rpx; color: #6b7280; width: 80rpx; flex-shrink: 0; }
.sheet-input {
  flex: 1; height: 88rpx; background: #f3f4f6; border-radius: 20rpx;
  padding: 0 24rpx; font-size: 28rpx; color: #1f2937; box-sizing: border-box;
}
.icon-input { width: 88rpx; flex: none; text-align: center; font-size: 36rpx; }
.sheet-btns { display: flex; gap: 16rpx; margin-top: 16rpx; }
.sheet-btn {
  flex: 1; height: 96rpx; border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; font-weight: 700;
}
.sheet-btn.cancel  { background: #f3f4f6; color: #6b7280; }
.sheet-btn.confirm { background: linear-gradient(135deg, #6366f1, #8b5cf6); color: #fff; }
.sheet-btn.delete  { background: #fee2e2; color: #ef4444; }

/* ── 移动弹窗 ─────────────────────────────── */
.move-list {
  max-height: 520rpx;
  background: #f8fafc;
  border-radius: 20rpx;
  padding: 8rpx 0;
  margin-bottom: 24rpx;
}
.move-option {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 24rpx;
  font-size: 28rpx; color: #1f2937;
}
.move-option:active { background: #eef2ff; }
.move-option.selected { background: #ede9fe; }
.move-option.selected .move-option-name { color: #7c3aed; font-weight: 700; }
.move-option-check { color: #7c3aed; font-size: 32rpx; font-weight: 700; }
