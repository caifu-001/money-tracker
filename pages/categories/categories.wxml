<view class="page">
<!-- 游客提示 -->
<view class="guest-tip-card" wx:if="{{isGuest}}">
  <text class="guest-tip-icon">🔐</text>
  <text class="guest-tip-title">登录后管理分类</text>
  <text class="guest-tip-desc">登录后可以添加、编辑、删除自定义分类</text>
  <button class="guest-tip-btn" bindtap="goLogin">去登录</button>
</view>

<view class="header-card">
  <view class="header-bg"></view>
  <text class="header-title">分类管理</text>
  <text class="header-sub">管理你的收支分类</text>
</view>

<view class="type-tabs">
  <view class="tab-item {{type==='expense'?'active-exp':''}}" bindtap="setType" data-type="expense">
    <text class="tab-icon">💸</text>
    <text class="tab-text">支出分类</text>
  </view>
  <view class="tab-item {{type==='income'?'active-inc':''}}" bindtap="setType" data-type="income">
    <text class="tab-icon">💰</text>
    <text class="tab-text">收入分类</text>
  </view>
</view>

<view class="add-bar" bindtap="openAdd">
  <text class="add-icon">+</text>
  <text class="add-text">添加{{type==='expense'?'支出':'收入'}}分类</text>
</view>

<view class="loading" wx:if="{{loading}}"><text class="loading-text">加载中...</text></view>

<!-- 支出分类 -->
<view wx:if="{{!loading && type==='expense'}}">
  <view class="cat-list">
    <block wx:for="{{expenseCats}}" wx:key="id" wx:for-item="lv1">
      <view class="cat-item" style="padding-left:{{24+lv1.level*40}}rpx">
        <view class="ci-expand {{lv1.children.length?'has-children':''}} {{lv1.expanded?'expanded':''}}" bindtap="toggleExpand" data-id="{{lv1.id}}">
          <text wx:if="{{lv1.children.length}}">{{lv1.expanded?'▼':'▶'}}</text>
          <text wx:else>·</text>
        </view>
        <view class="ci-icon-text">{{lv1.icon}}</view>
        <text class="ci-name">{{lv1.name}}</text>
        <view class="ci-actions">
          <text class="ci-btn ci-btn-inline" bindtap="openAdd" data-parent="{{lv1.id}}">+子级</text>
          <text class="ci-btn ci-btn-edit" bindtap="openEdit" data-cat="{{lv1}}">编辑</text>
          <text class="ci-btn ci-btn-del" bindtap="handleDelete" data-id="{{lv1.id}}">删除</text>
        </view>
      </view>
      <!-- 二级 -->
      <block wx:if="{{lv1.expanded}}">
        <block wx:for="{{lv1.children}}" wx:for-item="lv2" wx:key="id">
          <view class="cat-item child" style="padding-left:{{24+lv2.level*40}}rpx">
            <view class="ci-expand {{lv2.children.length?'has-children':''}} {{lv2.expanded?'expanded':''}}" bindtap="toggleExpand" data-id="{{lv2.id}}">
              <text wx:if="{{lv2.children.length}}">{{lv2.expanded?'▼':'▶'}}</text>
              <text wx:else>·</text>
            </view>
            <view class="ci-icon-text">{{lv2.icon}}</view>
            <text class="ci-name">{{lv2.name}}</text>
            <view class="ci-actions">
              <text class="ci-btn ci-btn-inline" bindtap="openAdd" data-parent="{{lv2.id}}">+子级</text>
              <text class="ci-btn ci-btn-edit" bindtap="openEdit" data-cat="{{lv2}}">编辑</text>
              <text class="ci-btn ci-btn-del" bindtap="handleDelete" data-id="{{lv2.id}}">删除</text>
            </view>
          </view>
          <!-- 三级 -->
          <block wx:if="{{lv2.expanded}}">
            <block wx:for="{{lv2.children}}" wx:for-item="lv3" wx:key="id">
              <view class="cat-item child" style="padding-left:{{24+lv3.level*40}}rpx">
                <view class="ci-expand">·</view>
                <view class="ci-icon-text">{{lv3.icon}}</view>
                <text class="ci-name">{{lv3.name}}</text>
                <view class="ci-actions">
                  <text class="ci-btn ci-btn-edit" bindtap="openEdit" data-cat="{{lv3}}">编辑</text>
                  <text class="ci-btn ci-btn-del" bindtap="handleDelete" data-id="{{lv3.id}}">删除</text>
                </view>
              </view>
            </block>
          </block>
        </block>
      </block>
    </block>
  </view>
  <view wx:if="{{expenseCats.length===0}}" class="empty-state"><text>暂无支出分类</text></view>
</view>

<!-- 收入分类 -->
<view wx:if="{{!loading && type==='income'}}">
  <view class="cat-list">
    <block wx:for="{{incomeCats}}" wx:key="id" wx:for-item="lv1">
      <view class="cat-item" style="padding-left:{{24+lv1.level*40}}rpx">
        <view class="ci-expand {{lv1.children.length?'has-children':''}} {{lv1.expanded?'expanded':''}}" bindtap="toggleExpand" data-id="{{lv1.id}}">
          <text wx:if="{{lv1.children.length}}">{{lv1.expanded?'▼':'▶'}}</text>
          <text wx:else>·</text>
        </view>
        <view class="ci-icon-text">{{lv1.icon}}</view>
        <text class="ci-name">{{lv1.name}}</text>
        <view class="ci-actions">
          <text class="ci-btn ci-btn-inline" bindtap="openAdd" data-parent="{{lv1.id}}">+子级</text>
          <text class="ci-btn ci-btn-edit" bindtap="openEdit" data-cat="{{lv1}}">编辑</text>
          <text class="ci-btn ci-btn-del" bindtap="handleDelete" data-id="{{lv1.id}}">删除</text>
        </view>
      </view>
      <!-- 二级 -->
      <block wx:if="{{lv1.expanded}}">
        <block wx:for="{{lv1.children}}" wx:for-item="lv2" wx:key="id">
          <view class="cat-item child" style="padding-left:{{24+lv2.level*40}}rpx">
            <view class="ci-expand">·</view>
            <view class="ci-icon-text">{{lv2.icon}}</view>
            <text class="ci-name">{{lv2.name}}</text>
            <view class="ci-actions">
              <text class="ci-btn ci-btn-edit" bindtap="openEdit" data-cat="{{lv2}}">编辑</text>
              <text class="ci-btn ci-btn-del" bindtap="handleDelete" data-id="{{lv2.id}}">删除</text>
            </view>
          </view>
        </block>
      </block>
    </block>
  </view>
  <view wx:if="{{incomeCats.length===0}}" class="empty-state"><text>暂无收入分类</text></view>
</view>

<!-- 添加弹窗 -->
<view class="modal-mask" wx:if="{{showAdd}}" bindtap="closeAdd"></view>
<view class="modal-sheet {{showAdd?'show':''}}">
  <view class="sheet-handle"></view>
  <text class="sheet-title">添加分类</text>
  <view class="sheet-row">
    <text class="sheet-label">图标</text>
    <input class="sheet-input icon-input" placeholder="📌" value="{{addIcon}}" bindinput="onAddIconInput" maxlength="2"/>
  </view>
  <view class="sheet-row">
    <text class="sheet-label">名称</text>
    <input class="sheet-input" placeholder="输入分类名称" value="{{addName}}" bindinput="onAddNameInput"/>
  </view>
  <view class="sheet-btns">
    <text class="sheet-btn cancel" bindtap="closeAdd">取消</text>
    <text class="sheet-btn confirm" bindtap="handleAdd">添加</text>
  </view>
</view>

<!-- 编辑弹窗 -->
<view class="modal-mask" wx:if="{{showEdit}}" bindtap="closeEdit"></view>
<view class="modal-sheet {{showEdit?'show':''}}">
  <view class="sheet-handle"></view>
  <text class="sheet-title">编辑分类</text>
  <view class="sheet-row">
    <text class="sheet-label">图标</text>
    <input class="sheet-input icon-input" placeholder="📌" value="{{editIcon}}" bindinput="onEditIconInput" maxlength="2"/>
  </view>
  <view class="sheet-row">
    <text class="sheet-label">名称</text>
    <input class="sheet-input" placeholder="输入分类名称" value="{{editName}}" bindinput="onEditNameInput"/>
  </view>
  <view class="sheet-btns">
    <text class="sheet-btn delete" bindtap="handleDelete">删除</text>
    <text class="sheet-btn cancel" bindtap="closeEdit">取消</text>
    <text class="sheet-btn confirm" bindtap="handleEdit">保存</text>
  </view>
</view>
</view>
