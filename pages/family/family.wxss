/* pages/family/family.wxss */
.page { background: #f3f4f6; min-height: 100vh; padding: 32rpx; padding-bottom: 120rpx; }
.header { margin-bottom: 32rpx; }
.title { font-size: 40rpx; font-weight: 700; color: #1f2937; display: block; }
.desc  { font-size: 24rpx; color: #9ca3af; margin-top: 6rpx; display: block; }
.loading { text-align: center; padding: 80rpx; color: #9ca3af; }
.placeholder { background: white; border-radius: 32rpx; padding: 80rpx 32rpx; text-align: center; box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06); }
.ph-icon { font-size: 100rpx; display: block; margin-bottom: 24rpx; }
.ph-text { font-size: 36rpx; font-weight: 700; color: #1f2937; display: block; margin-bottom: 12rpx; }
.ph-sub  { font-size: 26rpx; color: #9ca3af; display: block; }
