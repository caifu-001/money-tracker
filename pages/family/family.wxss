/* pages/family/family.wxss - 统一设计系统 */
page { background: #f0f2f7; }
.page { min-height: 100vh; padding-bottom: 140rpx; }

.header-card { position: relative; overflow: hidden; background: linear-gradient(135deg, #6366f1, #8b5cf6); padding: 60rpx 40rpx 80rpx; }
.header-circle { position: absolute; border-radius: 50%; background: rgba(255,255,255,0.1); }
.header-circle1 { top: -80rpx; right: -80rpx; width: 320rpx; height: 320rpx; }
.header-circle2 { bottom: -60rpx; left: -40rpx; width: 200rpx; height: 200rpx; }
.header-title { display: block; color: #fff; font-size: 44rpx; font-weight: 700; letter-spacing: 2rpx; }
.header-sub { display: block; color: rgba(255,255,255,0.75); font-size: 26rpx; margin-top: 8rpx; }

.loading { padding: 80rpx; text-align: center; }
.loading-text { color: #9ca3af; font-size: 28rpx; }

.invite-card { margin: 32rpx 32rpx 0; background: #fff; border-radius: 24rpx; padding: 32rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }
.invite-row { display: flex; flex-direction: column; gap: 16rpx; }
.invite-label { font-size: 24rpx; color: #6b7280; }
.invite-code-wrap { display: flex; align-items: center; justify-content: space-between; }
.invite-code { font-size: 40rpx; font-weight: 800; color: #6366f1; letter-spacing: 6rpx; }
.copy-btn { background: #ede9fe; color: #6366f1; font-size: 22rpx; padding: 10rpx 24rpx; border-radius: 20rpx; font-weight: 500; }
.copy-btn.copied { background: #d1fae5; color: #10b981; }

/* 加入按钮 */
.join-btn { margin-top: 24rpx; padding: 20rpx; border-radius: 16rpx; border: 2rpx solid rgba(99,102,241,0.3); text-align: center; font-size: 26rpx; color: #6366f1; font-weight: 600; }

/* 加入表单卡片 */
.join-card { margin: 24rpx 32rpx 0; background: #fff; border-radius: 24rpx; padding: 32rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); display: flex; flex-direction: column; gap: 16rpx; }
.join-card-title { font-size: 30rpx; color: #374151; font-weight: 700; }
.join-card-sub { font-size: 22rpx; color: #9ca3af; }
.join-input { width: 100%; padding: 20rpx 24rpx; border-radius: 16rpx; border: 2rpx solid #e5e7eb; font-size: 36rpx; font-weight: 700; text-align: center; letter-spacing: 8rpx; box-sizing: border-box; font-family: monospace; }
.join-result { padding: 16rpx 20rpx; border-radius: 12rpx; font-size: 24rpx; font-weight: 600; }
.join-result.ok { background: #f0fdf4; color: #16a34a; }
.join-result.err { background: #fef2f2; color: #ef4444; }
.join-submit-btn { padding: 24rpx; border-radius: 16rpx; background: linear-gradient(135deg, #6366f1, #8b5cf6); color: #fff; text-align: center; font-size: 28rpx; font-weight: 700; }
.join-submit-btn.disabled { opacity: 0.4; }

.section-header { display: flex; align-items: center; justify-content: space-between; padding: 32rpx 40rpx 16rpx; }
.section-title { font-size: 28rpx; color: #374151; font-weight: 600; }
.section-count { font-size: 24rpx; color: #9ca3af; }

.member-list { padding: 0 32rpx; display: flex; flex-direction: column; gap: 16rpx; }
.member-item { background: #fff; border-radius: 20rpx; padding: 24rpx 28rpx; display: flex; align-items: center; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06); }
.member-avatar { width: 80rpx; height: 80rpx; background: linear-gradient(135deg, #6366f1, #8b5cf6); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 20rpx; flex-shrink: 0; }
.member-avatar text { color: #fff; font-size: 32rpx; font-weight: 700; }
.member-info { flex: 1; }
.member-name { display: block; font-size: 28rpx; color: #1f2937; font-weight: 500; }
.member-role { display: block; font-size: 22rpx; color: #9ca3af; margin-top: 4rpx; }
.role-icon { font-size: 32rpx; }
