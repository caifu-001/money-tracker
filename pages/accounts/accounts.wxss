.page { min-height: 100vh; background: #f3f4f6; padding: 24rpx; box-sizing: border-box; }

/* 未登录 */
.guest-tip { display: flex; flex-direction: column; align-items: center; padding: 120rpx 40rpx; }
.guest-icon { font-size: 80rpx; }
.guest-title { font-size: 34rpx; font-weight: 700; color: #1f2937; margin-top: 24rpx; }
.guest-desc { font-size: 26rpx; color: #6b7280; margin-top: 16rpx; text-align: center; line-height: 1.7; }
.login-btn { margin-top: 48rpx; background: #6366f1; color: white; font-size: 28rpx; border-radius: 28rpx; padding: 18rpx 88rpx; }

.loading-wrap { padding: 120rpx 0; text-align: center; }
.loading { color: #9ca3af; font-size: 26rpx; }

/* 净资产卡片 */
.net-card { background: linear-gradient(135deg, #6366f1, #8b5cf6); border-radius: 28rpx; padding: 36rpx 32rpx; margin-bottom: 24rpx; box-shadow: 0 8rpx 32rpx rgba(99,102,241,0.3); }
.net-label { font-size: 24rpx; color: rgba(255,255,255,0.8); }
.net-amount { display: block; font-size: 60rpx; font-weight: 700; color: white; margin-top: 10rpx; }
.net-grid { display: flex; margin-top: 32rpx; background: rgba(255,255,255,0.12); border-radius: 20rpx; padding: 20rpx 0; }
.net-cell { flex: 1; display: flex; flex-direction: column; align-items: center; }
.nc-value { font-size: 32rpx; font-weight: 700; color: white; }
.nc-label { font-size: 20rpx; color: rgba(255,255,255,0.7); margin-top: 6rpx; }

/* 区块 */
.section { background: white; border-radius: 24rpx; padding: 24rpx 28rpx; margin-bottom: 24rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.section-title { font-size: 28rpx; font-weight: 700; color: #1f2937; }
.section-add { font-size: 24rpx; color: #6366f1; font-weight: 600; padding: 6rpx 12rpx; }

/* 账户行 */
.acc-item { display: flex; align-items: center; padding: 22rpx 0; border-bottom: 2rpx solid #f3f4f6; }
.acc-item:last-child { border-bottom: none; }
.acc-icon { font-size: 40rpx; width: 64rpx; }
.acc-info { flex: 1; display: flex; flex-direction: column; min-width: 0; }
.acc-name { font-size: 28rpx; font-weight: 600; color: #1f2937; }
.acc-tail { font-size: 22rpx; color: #9ca3af; font-weight: 400; }
.acc-sub { font-size: 22rpx; color: #9ca3af; margin-top: 4rpx; }
.acc-amount { font-size: 30rpx; font-weight: 700; color: #059669; }
.acc-amount.neg { color: #ef4444; }
.acc-amount.debt { color: #ef4444; }
.acc-empty { display: block; font-size: 24rpx; color: #9ca3af; padding: 24rpx 0; text-align: center; }

/* 说明 */
.tip-card { background: #eef2ff; border-radius: 24rpx; padding: 26rpx 28rpx; }
.tip-title { display: block; font-size: 26rpx; font-weight: 700; color: #4338ca; margin-bottom: 12rpx; }
.tip-line { display: block; font-size: 24rpx; color: #4338ca; line-height: 1.8; }

/* 弹窗 */
.modal-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.45); z-index: 100; }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; background: white; border-radius: 32rpx 32rpx 0 0; z-index: 101; transform: translateY(100%); transition: transform 0.25s ease; max-height: 86vh; display: flex; flex-direction: column; }
.sheet.show { transform: translateY(0); }
.sheet-head { display: flex; align-items: center; justify-content: space-between; padding: 32rpx 32rpx 16rpx; }
.sheet-title { font-size: 32rpx; font-weight: 700; color: #1f2937; }
.sheet-close { font-size: 32rpx; color: #9ca3af; padding: 0 8rpx; }
.sheet-body { flex: 1; padding: 0 32rpx; }

.form-row { margin-bottom: 30rpx; }
.form-label { display: block; font-size: 26rpx; font-weight: 600; color: #374151; margin-bottom: 14rpx; }
.form-input { background: #f3f4f6; border-radius: 16rpx; padding: 20rpx 24rpx; font-size: 28rpx; color: #1f2937; }
.form-input-wrap { display: flex; align-items: center; background: #f3f4f6; border-radius: 16rpx; padding: 0 24rpx; }
.form-symbol { font-size: 28rpx; color: #6b7280; margin-right: 10rpx; }
.form-input-wrap .form-input { flex: 1; background: transparent; padding-left: 0; }
.form-hint { display: block; font-size: 22rpx; color: #9ca3af; margin-top: 12rpx; line-height: 1.6; }

.kind-row { display: flex; gap: 20rpx; }
.kind-item { flex: 1; display: flex; align-items: center; justify-content: center; gap: 10rpx; padding: 22rpx 0; border-radius: 16rpx; border: 3rpx solid #e5e7eb; background: white; }
.kind-item.selected { border-color: #6366f1; background: #eef2ff; }
.kind-icon { font-size: 32rpx; }
.kind-name { font-size: 28rpx; font-weight: 600; color: #374151; }
.kind-item.selected .kind-name { color: #4338ca; }

.icon-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.icon-item { width: 80rpx; height: 80rpx; display: flex; align-items: center; justify-content: center; font-size: 36rpx; border-radius: 16rpx; border: 3rpx solid #e5e7eb; background: white; }
.icon-item.selected { border-color: #6366f1; background: #eef2ff; }

.sheet-actions { display: flex; align-items: center; gap: 20rpx; padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); border-top: 2rpx solid #f3f4f6; }
.btn-ghost { font-size: 26rpx; color: #ef4444; padding: 20rpx 10rpx; }
.btn-primary { flex: 1; text-align: center; background: #6366f1; color: white; font-size: 30rpx; font-weight: 600; border-radius: 24rpx; padding: 22rpx 0; }
.btn-primary.disabled { opacity: 0.6; }
