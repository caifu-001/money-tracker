/* pages/home/home.wxss */
.page { background: #f3f4f6; min-height: 100vh; padding-bottom: 120rpx; }

/* 顶部渐变 */
.header-gradient {
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #ec4899 100%);
  padding: 80rpx 32rpx 60rpx;
  position: relative; overflow: hidden;
}
.bg-deco { position: absolute; border-radius: 50%; background: rgba(255,255,255,0.07); }
.bg-deco-1 { width: 240rpx; height: 240rpx; top: -60rpx; right: -60rpx; }
.bg-deco-2 { width: 200rpx; height: 200rpx; bottom: -80rpx; left: -40rpx; }


.header-right { display: flex; gap: 8px; align-items: center; }
.header-btn { width: 64rpx; height: 64rpx; border-radius: 50%; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; font-size: 32rpx; }
.header-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 32rpx; }
.ledger-name { color: rgba(255,255,255,0.9); font-size: 26rpx; display: block; }
.month-label { color: rgba(255,255,255,0.6); font-size: 22rpx; margin-top: 4rpx; display: block; }
.admin-badge { background: rgba(255,255,255,0.25); color: white; font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 20rpx; }

.balance-area { text-align: center; margin-bottom: 32rpx; }
.balance-label { color: rgba(255,255,255,0.75); font-size: 26rpx; display: block; margin-bottom: 8rpx; }
.balance-amount { color: white; font-size: 72rpx; font-weight: 700; letter-spacing: -2rpx; }

.stat-row { display: flex; gap: 20rpx; }
.stat-card { flex: 1; background: rgba(255,255,255,0.15); border-radius: 24rpx; padding: 24rpx; }
.stat-label { color: rgba(255,255,255,0.75); font-size: 24rpx; display: block; margin-bottom: 8rpx; }
.stat-value { color: white; font-size: 36rpx; font-weight: 700; }

/* 账目列表 */
.list-card {
  margin: -32rpx 24rpx 0;
  background: white; border-radius: 32rpx;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.08);
  overflow: hidden; position: relative; z-index: 1;
}
.list-header { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 32rpx; border-bottom: 1rpx solid #f3f4f6; }
.list-title { font-weight: 700; color: #1f2937; font-size: 30rpx; }
.list-count { font-size: 24rpx; color: #9ca3af; background: #f9fafb; padding: 6rpx 20rpx; border-radius: 40rpx; }

.loading, .empty-state { text-align: center; padding: 80rpx 32rpx; color: #9ca3af; }
.empty-state .icon { font-size: 80rpx; display: block; margin-bottom: 20rpx; }
.empty-state .text { font-size: 28rpx; display: block; }
.empty-state .sub { font-size: 24rpx; color: #d1d5db; margin-top: 8rpx; display: block; }

.tx-item { display: flex; align-items: center; padding: 24rpx 32rpx; border-bottom: 1rpx solid #f9fafb; gap: 20rpx; }
.tx-icon { width: 80rpx; height: 80rpx; border-radius: 24rpx; display: flex; align-items: center; justify-content: center; font-size: 36rpx; flex-shrink: 0; }
.tx-icon.income  { background: #f0fdf4; }
.tx-icon.expense { background: #fff1f2; }
.tx-info { flex: 1; min-width: 0; }
.tx-cat  { font-size: 28rpx; font-weight: 500; color: #1f2937; display: block; }
.tx-date { font-size: 22rpx; color: #9ca3af; margin-top: 4rpx; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tx-right { display: flex; flex-direction: column; align-items: flex-end; gap: 8rpx; flex-shrink: 0; }
.tx-amount { font-size: 30rpx; font-weight: 700; }
.tx-amount.income  { color: #16a34a; }
.tx-amount.expense { color: #dc2626; }
.tx-actions { display: flex; gap: 12rpx; }
.action-edit { font-size: 28rpx; }
.action-del  { font-size: 28rpx; }

/* 悬浮按钮 */
.float-btn {
  position: fixed; right: 40rpx; bottom: 160rpx;
  width: 112rpx; height: 112rpx; border-radius: 50%;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(99,102,241,0.5);
  z-index: 100;
}
.float-icon { color: white; font-size: 60rpx; font-weight: 300; line-height: 1; margin-top: -4rpx; }

/* 弹窗 */
.modal-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 200; }
.quick-add-panel {
  position: fixed; bottom: 0; left: 0; right: 0; z-index: 201;
  background: white; border-radius: 48rpx 48rpx 0 0;
  max-height: 90vh; overflow-y: auto;
  transform: translateY(100%); transition: transform 0.3s ease;
}
.quick-add-panel.show { transform: translateY(0); }
.panel-drag { width: 80rpx; height: 8rpx; background: #e5e7eb; border-radius: 99rpx; margin: 24rpx auto 0; }
.panel-content { padding: 0 40rpx 60rpx; }
.panel-header { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0 32rpx; }
.panel-title { font-size: 36rpx; font-weight: 700; color: #1f2937; }
.panel-close { font-size: 36rpx; color: #9ca3af; width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; background: #f3f4f6; border-radius: 50%; }

.type-tabs { display: flex; background: #f3f4f6; border-radius: 24rpx; padding: 8rpx; margin-bottom: 32rpx; }
.type-tab { flex: 1; text-align: center; padding: 20rpx 0; border-radius: 18rpx; font-size: 28rpx; font-weight: 700; color: #9ca3af; }
.type-tab.active-expense { background: white; color: #ef4444; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1); }
.type-tab.active-income  { background: white; color: #22c55e; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1); }

.amount-area { border-radius: 32rpx; padding: 28rpx 32rpx; margin-bottom: 32rpx; }
.expense-bg { background: #fff1f2; }
.income-bg  { background: #f0fdf4; }
.amount-label { font-size: 22rpx; color: #9ca3af; display: block; margin-bottom: 8rpx; }
.amount-row { display: flex; align-items: baseline; gap: 8rpx; }
.amount-symbol { font-size: 52rpx; font-weight: 700; }
.amount-symbol.red   { color: #ef4444; }
.amount-symbol.green { color: #22c55e; }
.amount-input { flex: 1; font-size: 72rpx; font-weight: 700; color: #1f2937; background: transparent; border: none; }

.cat-section { margin-bottom: 24rpx; }
.cat-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.cat-title { font-size: 26rpx; font-weight: 600; color: #6b7280; }
.cat-selected { font-size: 22rpx; color: #6366f1; background: #eef2ff; padding: 6rpx 16rpx; border-radius: 20rpx; }
.cat-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.cat-item {
  width: calc(25% - 12rpx); padding: 20rpx 8rpx 16rpx;
  border-radius: 24rpx; border: 3rpx solid transparent;
  background: #f9fafb; text-align: center; position: relative;
}
.cat-item.selected { background: #6366f1; border-color: #6366f1; }
.cat-icon { font-size: 40rpx; display: block; margin-bottom: 6rpx; }
.cat-name { font-size: 20rpx; font-weight: 600; color: #6b7280; display: block; }
.cat-item.selected .cat-name { color: white; }
.cat-arrow { position: absolute; top: 8rpx; right: 8rpx; font-size: 18rpx; color: #9ca3af; }
.cat-item.selected .cat-arrow { color: rgba(255,255,255,0.8); }

.sub-panel { background: #f5f3ff; border-radius: 24rpx; padding: 20rpx; margin-top: 16rpx; border: 3rpx solid #e0e7ff; }
.sub-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; font-size: 24rpx; color: #6366f1; font-weight: 600; }
.sub-self { font-size: 22rpx; background: white; border: 1rpx solid #c7d2fe; border-radius: 20rpx; padding: 6rpx 16rpx; color: #6366f1; }

.note-input { background: #f9fafb; border: 3rpx solid #f3f4f6; border-radius: 24rpx; padding: 24rpx 28rpx; font-size: 28rpx; width: 100%; box-sizing: border-box; margin-bottom: 24rpx; }

.submit-btn { border-radius: 28rpx !important; padding: 28rpx 0 !important; font-size: 32rpx !important; font-weight: 700 !important; color: white !important; border: none !important; width: 100% !important; }
.submit-btn::after { border: none; }
.expense-btn { background: linear-gradient(135deg, #ef4444, #ec4899) !important; box-shadow: 0 8rpx 32rpx rgba(239,68,68,0.35) !important; }
.income-btn  { background: linear-gradient(135deg, #22c55e, #16a34a) !important; box-shadow: 0 8rpx 32rpx rgba(34,197,94,0.35) !important; }

.date-picker { background: #f9fafb; border: 3rpx solid #e5e7eb; border-radius: 20rpx; padding: 20rpx 24rpx; font-size: 28rpx; color: #1f2937; }
.input-label { font-size: 24rpx; color: #6b7280; margin-bottom: 8rpx; display: block; }

/* Append to home.wxss */

/* Payment section */
.payment-section { margin-bottom: 24rpx; }
.payment-title { font-size: 26rpx; font-weight: 600; color: #6b7280; display: block; margin-bottom: 12rpx; }
.payment-row { display: flex; gap: 12rpx; }
.pay-item {
  flex: 1; padding: 16rpx 8rpx; border-radius: 20rpx; border: 3rpx solid #e5e7eb;
  text-align: center; background: white;
}
.pay-item.selected { border-color: #6366f1; background: #eef2ff; }
.pay-icon { font-size: 36rpx; display: block; margin-bottom: 4rpx; }
.pay-name { font-size: 22rpx; font-weight: 600; color: #374151; display: block; }
.pay-item.selected .pay-name { color: #6366f1; }

/* Header buttons */
.header-right { display: flex; gap: 8px; align-items: center; }
.header-btn { width: 64rpx; height: 64rpx; border-radius: 50%; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; font-size: 32rpx; }
.admin-btn { background: rgba(253,224,71,0.4); }
