<view class="page">
<!-- 游客模式：微信新用户一键注册 -->
<view class="guest-welcome" wx:if="{{isGuest && !guestBrowsing && showWechatRegister}}">
<view class="guest-icon">💬</view>
<text class="guest-title">检测到微信账号</text>
<text class="guest-desc">一键创建账号，无需填写任何信息</text>
<view class="agree-row">
  <view class="agree-checkbox {{agreedPrivacy?'checked':''}}" bindtap="toggleAgree">
    <text wx:if="{{agreedPrivacy}}" class="agree-check-icon">✓</text>
  </view>
  <text class="agree-text">我已阅读并同意</text>
  <text class="agree-link" catchtap="goAgreement">《用户协议》</text>
  <text class="agree-text">和</text>
  <text class="agree-link" catchtap="goPrivacy">《隐私政策》</text>
</view>
<button class="guest-login-btn wechat-btn" bindtap="handleWechatRegister" disabled="{{loading}}">
  {{loading?'创建中...':'微信一键注册'}}
</button>
<view class="guest-actions">
  <text class="guest-cancel-link" bindtap="goLogin">使用邮箱登录</text>
  <text class="guest-skip-link" bindtap="dismissRegister">暂不使用</text>
</view>
<text class="guest-tip">登录后即可使用记账功能</text>
</view>

<!-- 游客模式：未检测到微信或选择邮箱 -->
<view class="guest-welcome" wx:if="{{isGuest && !guestBrowsing && !showWechatRegister}}">
<view class="guest-icon">📝</view>
<text class="guest-title">欢迎使用游游记账</text>
<text class="guest-desc">一款简洁的家庭记账工具，支持多账本、预算管理、数据分析</text>
<view class="guest-features">
<view class="feature-item"><text class="feature-icon">📊</text><text>收支统计</text></view>
<view class="feature-item"><text class="feature-icon">💰</text><text>预算管理</text></view>
<view class="feature-item"><text class="feature-icon">👨‍👩‍👧‍👦</text><text>家庭账本</text></view>
</view>
<view class="agree-row">
  <view class="agree-checkbox {{agreedPrivacy?'checked':''}}" bindtap="toggleAgree">
    <text wx:if="{{agreedPrivacy}}" class="agree-check-icon">✓</text>
  </view>
  <text class="agree-text">我已阅读并同意</text>
  <text class="agree-link" catchtap="goAgreement">《用户协议》</text>
  <text class="agree-text">和</text>
  <text class="agree-link" catchtap="goPrivacy">《隐私政策》</text>
</view>
<view class="guest-actions">
  <button class="guest-login-btn" bindtap="goLogin" disabled="{{!agreedPrivacy}}">登录 / 注册</button>
  <text class="guest-skip-link {{!agreedPrivacy?'guest-skip-disabled':''}}" bindtap="dismissRegister">先体验</text>
</view>
<text class="guest-tip">登录后即可使用记账功能</text>
</view>

<!-- 游客浏览模式 + 已登录用户 共用主体界面 -->
<block wx:if="{{guestBrowsing || !isGuest}}">
<view class="guest-browsing-banner" wx:if="{{isGuest && guestBrowsing}}">
<text class="gb-text">正在浏览模式 · 登录后可开始记账</text>
<text class="gb-login-btn" bindtap="goLogin">登录 / 注册</text>
</view>

<!-- 已登录无账本：创建账本 -->
<view class="no-ledger" wx:if="{{!isGuest && showCreateLedger}}">
<text class="title">还没有账本</text>
<text class="sub">创建一个账本开始记账吧</text>
<input class="ledger-input" placeholder="输入账本名称" value="{{newLedgerName}}" bindinput="onLedgerNameInput"/>
<button class="btn-primary" bindtap="createLedger" disabled="{{creatingLedger}}">{{creatingLedger?"创建中...":"创建账本"}}</button>
</view>

<!-- 主体记账界面（已登录有账本 或 游客浏览） -->
<block wx:elif="{{!showCreateLedger || (isGuest && guestBrowsing)}}">
<view class="header">
<view class="header-left">
<text class="ledger-name" bindtap="{{isGuest?'goLogin':'goLedgers'}}">{{isGuest?'游游记账':(currentLedger.displayName || currentLedger.name)}} <text class="ledger-switch-hint">▾</text></text>
<view class="month-row">
<text class="month-arrow" bindtap="prevMonth">‹</text>
<text class="month" bindtap="openMonthPicker">{{monthLabel}}</text>
<text class="month-arrow" bindtap="nextMonth">›</text>
</view>
</view>
<view class="header-right">
<text class="fuel-btn" bindtap="goFuel">⛽ 油耗</text>
<text class="export-btn" bindtap="handleExport">📤 导出</text>
</view>
</view>

<view class="balance-card">
<text class="balance-label">{{currentMonth}}月结余</text>
<text class="balance-amount">{{isGuest?'0.00':balance}}</text>
<view class="stat-row">
<view class="stat"><text class="stat-label">收入</text><text class="stat-value income">{{isGuest?'0.00':totalIncome}}</text></view>
<view class="stat"><text class="stat-label">支出</text><text class="stat-value expense">{{isGuest?'0.00':totalExpense}}</text></view>
</view>
<!-- 游客不显示待报销 -->
<view class="reimburse-summary" wx:if="{{!isGuest && pendingReimburseTotal!=='0.00'}}">
<text class="reimburse-label">🧾 待报销</text>
<view class="reimburse-right">
<text class="reimburse-value">{{baseSymbol}}{{pendingReimburseTotal}}</text>
<text class="settle-btn" bindtap="settleAllReimburse">核销</text>
</view>
</view>
<!-- 外币待结算：银行未入账，本位币金额未定，未计入上方收支 -->
<view class="pending-summary" wx:if="{{!isGuest && pendingCount>0}}">
<text class="pending-label">⏳ 待结算 · 未计入收支</text>
<view class="pending-right">
<text class="pending-value">{{pendingCount}} 笔<text wx:if="{{pendingRefTotal!=='0.00'}}"> · 参考 {{baseSymbol}}{{pendingRefTotal}}</text></text>
<text class="pending-toggle" bindtap="togglePendingFilter">{{showPendingOnly?'显示全部':'查看'}}</text>
</view>
</view>
<!-- 借款未结清提示：别人欠我 / 我欠别人（净额法，反向记账自动抵消） -->
<view class="loan-summary" wx:if="{{!isGuest && loanOverview.open}}" bindtap="goLoanAnalytics">
<text class="loan-sum-label">🤝 {{loanOverview.partyCount}} 人借款未结清</text>
<view class="loan-sum-right">
<text class="loan-sum-in" wx:if="{{loanOverview.receivable>0}}">待收回 {{loanOverview.receivableText}}</text>
<text class="loan-sum-out" wx:if="{{loanOverview.payable>0}}">待偿还 {{loanOverview.payableText}}</text>
<text class="loan-sum-arrow">明细 ›</text>
</view>
</view>
<!-- 资金账户入口：资产 / 负债账户与余额，信用卡还款在这里记 -->
<view class="account-entry" wx:if="{{!isGuest}}" bindtap="goAccounts">
<text class="ae-label">💼 资金账户与负债</text>
<text class="ae-arrow">管理 ›</text>
</view>
</view>

<view class="list-card">
<view class="list-header">
<text class="list-title">{{currentMonth}}月账目</text>
<view class="list-header-right" wx:if="{{!isGuest}}">
      <text class="reimburse-filter {{showReimbursableOnly?'active':''}}" bindtap="toggleReimbursableFilter">🧾 待报销</text>
      <text class="reimburse-filter loan-filter {{showLoanOnly?'active':''}}" bindtap="toggleLoanFilter">🤝 借款</text>
      <text class="list-count">共{{listFiltered?displayCount:transactions.length}}条</text>
</view>
</view>
<!-- 游客：显示引导文字 -->
<view wx:if="{{isGuest && guestBrowsing}}">
<view class="empty-state guest-empty">
<text class="guest-empty-title">👋 欢迎体验游游记账</text>
<text class="guest-empty-desc">点击右下角 <text class="guest-btn-highlight">+</text> 按钮可以体验记账流程</text>
<text class="guest-empty-hint">登录后即可保存记录、创建多账本、管理家庭记账</text>
</view>
</view>
<!-- 已登录：按日分组 -->
<view wx:elif="{{loading}}"><text class="loading">加载中...</text></view>
<view wx:elif="{{transactions.length===0}}"><text class="empty-state">暂无账目，点击右下角按钮开始记账</text></view>
<!-- 筛选后没有命中任何账目：整组不展示，这里兜底给出口 -->
<view wx:elif="{{listFiltered && displayGroups.length===0}}" class="filter-empty">
  <text class="fe-emoji">{{showPendingOnly?'⏳':(showLoanOnly?'🤝':'🧾')}}</text>
  <text class="fe-text">{{showPendingOnly?'本月没有待结算账目':(showLoanOnly?'本月没有借款账目':'本月没有待报销账目')}}</text>
  <text class="fe-reset" bindtap="clearListFilter">显示全部账目</text>
</view>
<block wx:else>
<block wx:for="{{displayGroups}}" wx:key="date" wx:for-item="group">
  <!-- 日期头 + 当日小计 -->
  <view class="day-header">
    <text class="day-date">{{group.dateLabel}}</text>
    <view class="day-stats">
      <text class="day-inc" wx:if="{{group.income !== '0.00'}}">收 {{baseSymbol}}{{group.income}}</text>
      <text class="day-divider" wx:if="{{group.income !== '0.00' && group.expense !== '0.00'}}">|</text>
      <text class="day-exp" wx:if="{{group.expense !== '0.00'}}">支 {{baseSymbol}}{{group.expense}}</text>
      <text class="day-loan" wx:if="{{group.loanOutText}}">借出 {{group.loanOutText}}</text>
      <text class="day-loan" wx:if="{{group.loanInText}}">借入 {{group.loanInText}}</text>
    </view>
  </view>
  <!-- 当日交易列表 -->
  <view class="tx-item" wx:for="{{group.items}}" wx:key="id" wx:for-item="item" wx:if="{{(!showReimbursableOnly || (item.is_reimbursable && item.reimbursement_status==='pending')) && (!showPendingOnly || item.isPending) && (!showLoanOnly || item.isLoan)}}">
    <view class="tx-icon {{item.isLoan?'loan':item.type}}">{{item.categoryIcon}}</view>
    <view class="tx-info">
      <text class="tx-cat">{{item.isLoan ? (item.loanParty || item.category) : item.category}}<text class="tx-loan-badge" wx:if="{{item.isLoan}}">{{item.loanBadge}}</text><text class="tx-transfer-badge" wx:if="{{item.isTransfer}}">🔄转账</text><text class="tx-pending-badge" wx:if="{{item.isPending}}">⏳待结算</text><text class="tx-reimburse-badge" wx:if="{{item.is_reimbursable}}">{{item.reimbursement_status==='pending'?'🧾待报销':'✅已到账'}}</text></text>
      <text class="tx-date">{{item.dateLabel}}{{item.accountTag?" · "+item.accountTag:""}}{{(!item.isTransfer && item.paymentDisplay)?" · "+item.paymentDisplay:""}}{{item.fuelInfo?" · "+item.fuelInfo:""}}{{item.note?" · "+item.note:""}}<text class="tx-recorder" wx:if="{{showRecorder && item.recorderName}}"> · {{item.recorderName}}</text></text>
    </view>
    <view class="tx-right">
      <text class="tx-amount {{item.isTransfer?'transfer':(item.isLoan?'loan':item.type)}}">{{item.isTransfer?"":(item.type==='income'?"+":"-")}}{{item.amountDisplay}}</text>
      <text class="tx-convert pending" wx:if="{{item.isPending}}">{{item.pendingHint}}</text>
      <text class="tx-convert" wx:elif="{{item.showConvert}}">≈ {{item.baseDisplay}}</text>
      <view class="tx-actions" wx:if="{{item.canEdit}}">
        <text catchtap="onEditTap" data-date="{{group.date}}" data-index="{{index}}">编辑</text>
        <text catchtap="onDeleteTap" data-date="{{group.date}}" data-index="{{index}}" class="tx-delete">删除</text>
        <text catchtap="onReimburseStatusTap" data-date="{{group.date}}" data-index="{{index}}" class="tx-reimburse-status" wx:if="{{item.is_reimbursable}}">{{item.reimbursement_status==='pending'?'✓到账':'↩待报'}}</text>
      </view>
    </view>
  </view>
</block>
</block>
</view>

<view class="float-btn" bindtap="openQuickAdd"><text>+</text></view>

<!-- 月份选择弹窗 -->
<view class="modal-mask" wx:if="{{monthPickerVisible}}" bindtap="closeMonthPicker"></view>
<view class="month-picker-panel" wx:if="{{monthPickerVisible}}">
<view class="mp-header">
<text bindtap="closeMonthPicker">取消</text>
<text class="mp-title">选择月份</text>
<text class="mp-confirm" bindtap="closeMonthPicker">确定</text>
</view>
<picker-view
  class="mp-picker-view"
  value="{{monthPickerValue}}"
  bindchange="onMonthPickerChange"
  indicator-style="height: 50px;"
>
  <picker-view-column>
    <view wx:for="{{monthPickerRange[0]}}" wx:key="*this" class="mp-item">{{item}}</view>
  </picker-view-column>
  <picker-view-column>
    <view wx:for="{{monthPickerRange[1]}}" wx:key="*this" class="mp-item">{{item}}</view>
  </picker-view-column>
</picker-view>
</view>
</block>
</block>
</view>

<!-- 记一笔弹窗 -->
<view class="modal-mask" wx:if="{{showQuickAdd}}" bindtap="closeQuickAdd"></view>
<view class="quick-panel {{showQuickAdd?'show':''}}">
<view class="panel-header">
<text>记一笔</text>
<text bindtap="closeQuickAdd">✕</text>
</view>
<view class="type-tabs">
<text class="type-tab {{qaType==='expense'?'active-exp':''}}" bindtap="setQaType" data-type="expense">支出</text>
<text class="type-tab {{qaType==='income'?'active-inc':''}}" bindtap="setQaType" data-type="income">收入</text>
<text class="type-tab {{qaType==='transfer'?'active-tra':''}}" bindtap="setQaType" data-type="transfer">转账</text>
</view>
<view class="amount-input-wrap {{qaType==='expense'?'expense-bg':''}}{{qaType==='income'?'income-bg':''}}{{qaType==='transfer'?'transfer-bg':''}}">
<text class="yuan">{{qaType==='transfer'?(accounts[qaAccountIndex] ? accounts[qaAccountIndex].name : '转账'):qaSymbol}}</text>
<input type="digit" value="{{qaAmount}}" bindinput="onAmountInput" placeholder="0.00"/>
</view>
<!-- 币种选择 + 换算预览（转账为本位币划转，不需要币种） -->
<view class="fx-row" wx:if="{{qaType!=='transfer'}}">
<picker range="{{currencyLabels}}" value="{{qaCurrencyIndex}}" bindchange="onQaCurrencyChange">
<view class="fx-pick"><text class="fx-code">{{qaCurrency}}</text><text class="fx-caret">▾</text></view>
</picker>
<text class="fx-preview {{qaRateWarn?'warn':''}}" wx:if="{{qaConvertHint}}">{{qaConvertHint}}</text>
<text class="fx-preview" wx:else>本位币记账 · {{baseCurrency}}</text>
</view>
<!-- 转账：转出账户 → 转入账户 -->
<view class="transfer-box" wx:if="{{qaType==='transfer'}}">
<picker class="tf-pick-wrap" range="{{accounts}}" range-key="name" value="{{qaAccountIndex}}" bindchange="onQaAccountChange">
<view class="tf-row">
<text class="tf-label">转出</text>
<text class="tf-name">{{accounts[qaAccountIndex] ? accounts[qaAccountIndex].name : '选择账户'}}</text>
<text class="tf-caret">▾</text>
</view>
</picker>
<view class="tf-swap" bindtap="swapQaAccounts">⇅</view>
<picker class="tf-pick-wrap" range="{{accounts}}" range-key="name" value="{{qaToAccountIndex}}" bindchange="onQaToAccountChange">
<view class="tf-row">
<text class="tf-label">转入</text>
<text class="tf-name">{{accounts[qaToAccountIndex] ? accounts[qaToAccountIndex].name : '选择账户'}}</text>
<text class="tf-caret">▾</text>
</view>
</picker>
<text class="tf-hint" wx:if="{{accounts.length===0}}">当前账本还没有账户，请先到「资金账户」页添加</text>
<text class="tf-hint" wx:else>转账不计入收支，只改变两个账户的余额。还信用卡就选：银行卡 → 信用卡</text>
</view>
<picker mode="date" value="{{qaDate}}" bindchange="onQaDateChange">
<view class="date-picker">{{qaDate}}</view>
</picker>
<view class="cat-grid" wx:if="{{qaType!=='transfer' && !qaIsLoan}}">
<view class="cat-item {{qaCategory===item.name||qaExpandedKey===item.name?'selected':''}}" wx:for="{{currentCats}}" wx:key="name" bindtap="onCatTap" data-name="{{item.name}}" data-has-children="{{item.hasChildren}}">
<text class="cat-icon">{{item.icon}}</text>
<text class="cat-name">{{item.name}}</text>
</view>
</view>
<view class="sub-panel" wx:if="{{qaType!=='transfer' && !qaIsLoan && qaExpandedKey && subCats.length>0}}">
<view class="sub-header">
<text>{{qaExpandedKey}} 的子分类</text>
<text class="sub-self" bindtap="selectParentSelf">选「{{qaExpandedKey}}」本身</text>
</view>
<view class="sub-grid">
<view class="sub-item {{qaCategory===item.name||qaSubExpandedKey===item.name?'selected':''}}" wx:for="{{subCats}}" wx:key="name" bindtap="onSubCatTap" data-name="{{item.name}}">
<text>{{item.icon}} {{item.name}}</text>
</view>
</view>
<view wx:if="{{qaSubExpandedKey && subSubCats.length>0}}">
<view class="sub-header"><text>{{qaSubExpandedKey}} 的子分类</text></view>
<view class="sub-grid">
<view class="sub-item {{qaCategory===item.name?'selected':''}}" wx:for="{{subSubCats}}" wx:key="name" bindtap="onSubSubCatTap" data-name="{{item.name}}">
<text>{{item.icon}} {{item.name}}</text>
</view>
</view>
</view>
</view>
<input class="note-input" placeholder="添加备注（可选）" value="{{qaNote}}" bindinput="onNoteInput"/>
<!-- 油耗：仅油费分类显示 -->
<view class="fuel-fields" wx:if="{{qaType==='expense' && qaCategory==='油费'}}">
<view class="fuel-row">
<picker range="{{qaVehicles}}" range-key="name" value="{{qaVehicleIndex}}" bindchange="onQaVehicleChange">
<view class="fuel-vehicle">
<text class="fuel-label">🚗 车辆</text>
<text class="fuel-value">{{qaVehicles[qaVehicleIndex].name || '选择车辆'}}</text>
</view>
</picker>
<text class="fuel-add-vehicle" catchtap="addVehicle">＋</text>
</view>
<view class="fuel-row">
<view class="fuel-input-group">
<text class="fuel-label">⛽ 加油升数</text>
<input class="fuel-input" type="digit" value="{{qaFuelLiters}}" bindinput="onQaFuelLitersInput" placeholder="L"/>
</view>
<view class="fuel-input-group">
<text class="fuel-label">📟 里程表读数</text>
<input class="fuel-input" type="digit" value="{{qaOdometer}}" bindinput="onQaOdometerInput" placeholder="km"/>
</view>
</view>
<text class="fuel-hint">填升数+里程，自动算本次油耗（L/100km）</text>
</view>
<!-- 资金账户：钱从哪个账户出/进（与支付方式并存） -->
<view class="acc-row" wx:if="{{qaType!=='transfer' && accounts.length>0}}">
<picker class="acc-pick-wrap" range="{{accounts}}" range-key="name" value="{{qaAccountIndex}}" bindchange="onQaAccountChange">
<view class="acc-pick">
<text class="acc-pick-label">💼 资金账户</text>
<text class="acc-pick-name">{{accounts[qaAccountIndex] ? accounts[qaAccountIndex].name : '未选择'}}</text>
<text class="tf-caret">▾</text>
</view>
</picker>
</view>
<!-- 支付方式 -->
<view class="pay-row" wx:if="{{qaType!=='transfer'}}">
<view class="pay-item {{qaPaymentMethod===item.id?'selected':''}}" wx:for="{{paymentMethods}}" wx:key="id" bindtap="onQaPaymentChange" data-id="{{item.id}}">
<text class="pay-icon">{{item.icon}}</text>
<text class="pay-name">{{item.name}}</text>
</view>
</view>
<view class="reimburse-toggle" wx:if="{{qaType==='expense' && !qaIsLoan}}" bindtap="onQaReimburseTap">
<view class="reimburse-checkbox {{qaReimbursable?'checked':''}}">
<text wx:if="{{qaReimbursable}}">✓</text>
</view>
<text class="reimburse-toggle-label">🧾 可报销（公司公费）</text>
</view>
<!-- 借款开关：支出方向=借出/还债，收入方向=借入/收回 -->
<view class="loan-toggle {{qaIsLoan?'on':''}}" wx:if="{{qaType!=='transfer'}}" bindtap="onQaLoanTap">
<view class="loan-checkbox {{qaIsLoan?'checked':''}}">
<text wx:if="{{qaIsLoan}}">✓</text>
</view>
<text class="loan-toggle-label">🤝 借款<text class="loan-toggle-sub">（不计入收支）</text></text>
</view>
<view class="loan-box" wx:if="{{qaIsLoan && qaType!=='transfer'}}">
<view class="loan-row">
<text class="loan-label">{{qaType==='expense'?'借给谁':'向谁借'}}</text>
<input class="loan-input" value="{{qaCounterparty}}" bindinput="onQaLoanPartyInput" placeholder="{{qaType==='expense'?'如：张三':'如：李四'}}" maxlength="20"/>
</view>
<view class="loan-quick" wx:if="{{loanPartyHistory.length>0}}">
<text class="loan-quick-item" wx:for="{{loanPartyHistory}}" wx:key="*this" bindtap="pickLoanParty" data-name="{{item}}">{{item}}</text>
</view>
<text class="loan-hint" wx:if="{{qaType==='expense'}}">📤 借出：钱的去向是别人，不计入本月支出。对方还钱时在「收入」里勾借款记一笔，两条自动抵消。</text>
<text class="loan-hint" wx:else>📥 借入：钱来自别人，不计入本月收入。还钱时在「支出」里勾借款记一笔，两条自动抵消。</text>
</view>
<view class="submit-btn {{qaIsLoan&&qaType!=='transfer'?'loan-btn':(qaType==='transfer'?'transfer-btn':(qaType==='expense'?'expense-btn':'income-btn'))}}" bindtap="handleQuickAdd">{{qaLoading?"提交中...":(qaType==='transfer'?"确认转账":(qaIsLoan?(qaType==='expense'?"确认借出":"确认借入"):"确认记账"))}}</view>
</view>

<!-- 编辑弹窗 -->
<view class="modal-mask" wx:if="{{showEdit}}" bindtap="closeEdit"></view>
<view class="quick-panel {{showEdit?'show':''}}">
<view class="panel-header">
<text>编辑账目</text>
<text bindtap="closeEdit">✕</text>
</view>
<view class="type-tabs">
<text class="type-tab {{editType==='expense'?'active-exp':''}}" bindtap="setEditType" data-type="expense">支出</text>
<text class="type-tab {{editType==='income'?'active-inc':''}}" bindtap="setEditType" data-type="income">收入</text>
<text class="type-tab {{editType==='transfer'?'active-tra':''}}" bindtap="setEditType" data-type="transfer">转账</text>
</view>
<view class="amount-input-wrap {{editType==='expense'?'expense-bg':''}}{{editType==='income'?'income-bg':''}}{{editType==='transfer'?'transfer-bg':''}}">
<text class="yuan">{{editType==='transfer'?(accounts[editAccountIndex] ? accounts[editAccountIndex].name : '转账'):editSymbol}}</text>
<input type="digit" value="{{editAmount}}" bindinput="onEditAmountInput"/>
</view>
<!-- 币种选择 + 换算预览 -->
<view class="fx-row" wx:if="{{editType!=='transfer'}}">
<picker range="{{currencyLabels}}" value="{{editCurrencyIndex}}" bindchange="onEditCurrencyChange">
<view class="fx-pick"><text class="fx-code">{{editCurrency}}</text><text class="fx-caret">▾</text></view>
</picker>
<text class="fx-preview {{editRateWarn?'warn':''}}" wx:if="{{editConvertHint}}">{{editConvertHint}}</text>
<text class="fx-preview" wx:else>本位币记账 · {{baseCurrency}}</text>
</view>
<!-- 转账：转出账户 → 转入账户 -->
<view class="transfer-box" wx:if="{{editType==='transfer'}}">
<picker class="tf-pick-wrap" range="{{accounts}}" range-key="name" value="{{editAccountIndex}}" bindchange="onEditAccountChange">
<view class="tf-row">
<text class="tf-label">转出</text>
<text class="tf-name">{{accounts[editAccountIndex] ? accounts[editAccountIndex].name : '选择账户'}}</text>
<text class="tf-caret">▾</text>
</view>
</picker>
<view class="tf-swap" bindtap="swapEditAccounts">⇅</view>
<picker class="tf-pick-wrap" range="{{accounts}}" range-key="name" value="{{editToAccountIndex}}" bindchange="onEditToAccountChange">
<view class="tf-row">
<text class="tf-label">转入</text>
<text class="tf-name">{{accounts[editToAccountIndex] ? accounts[editToAccountIndex].name : '选择账户'}}</text>
<text class="tf-caret">▾</text>
</view>
</picker>
<text class="tf-hint" wx:if="{{accounts.length===0}}">当前账本还没有账户，请先到「资金账户」页添加</text>
<text class="tf-hint" wx:else>转账不计入收支，只改变两个账户的余额</text>
</view>
<!-- 结算校正：外币待结算，填银行账单上的实际扣款 -->
<view class="settle-box" wx:if="{{editIsPending}}">
<view class="settle-head">
<text class="settle-title">⏳ 待结算</text>
<text class="settle-desc">银行入账后，填实际扣的{{baseCurrency}}金额</text>
</view>
<view class="settle-input-wrap">
<text class="settle-symbol">{{baseSymbol}}</text>
<input class="settle-input" type="digit" value="{{settleAmount}}" bindinput="onSettleAmountInput" placeholder="银行实际扣款金额"/>
</view>
<text class="settle-hint">{{settleHint}}</text>
</view>
<picker mode="date" value="{{editDate}}" bindchange="onEditDateChange">
<view class="date-picker">{{editDate}}</view>
</picker>
<view class="cat-grid" wx:if="{{editType!=='transfer' && !editIsLoan}}">
<view class="cat-item {{editCategory===item.name?'selected':''}}" wx:for="{{editCats}}" wx:key="name" bindtap="onEditCatTap" data-name="{{item.name}}">
<text class="cat-icon">{{item.icon}}</text>
<text class="cat-name">{{item.name}}</text>
</view>
</view>
<view class="sub-panel" wx:if="{{!editIsLoan && editExpandedKey && editSubCats.length>0}}">
<view class="sub-header">
<text>{{editExpandedKey}} 的子分类</text>
<text class="sub-self" bindtap="selectEditParentSelf">选「{{editExpandedKey}}」本身</text>
</view>
<view class="sub-grid">
<view class="sub-item {{editCategory===item.name?'selected':''}}" wx:for="{{editSubCats}}" wx:key="name" bindtap="onEditSubCatTap" data-name="{{item.name}}">
<text>{{item.icon}} {{item.name}}</text>
</view>
</view>
<view wx:if="{{editSubExpandedKey && editSubSubCats.length>0}}">
<view class="sub-header"><text>{{editSubExpandedKey}} 的子分类</text></view>
<view class="sub-grid">
<view class="sub-item {{editCategory===item.name?'selected':''}}" wx:for="{{editSubSubCats}}" wx:key="name" bindtap="onEditSubSubCatTap" data-name="{{item.name}}">
<text>{{item.icon}} {{item.name}}</text>
</view>
</view>
</view>
</view>
<input class="note-input" placeholder="备注" value="{{editNote}}" bindinput="onEditNoteInput"/>
<!-- 油耗：仅油费分类显示 -->
<view class="fuel-fields" wx:if="{{editType==='expense' && editCategory==='油费'}}">
<view class="fuel-row">
<picker range="{{editVehicles}}" range-key="name" value="{{editVehicleIndex}}" bindchange="onEditVehicleChange">
<view class="fuel-vehicle">
<text class="fuel-label">🚗 车辆</text>
<text class="fuel-value">{{editVehicles[editVehicleIndex].name || '选择车辆'}}</text>
</view>
</picker>
<text class="fuel-add-vehicle" catchtap="addVehicle">＋</text>
</view>
<view class="fuel-row">
<view class="fuel-input-group">
<text class="fuel-label">⛽ 加油升数</text>
<input class="fuel-input" type="digit" value="{{editFuelLiters}}" bindinput="onEditFuelLitersInput" placeholder="L"/>
</view>
<view class="fuel-input-group">
<text class="fuel-label">📟 里程表读数</text>
<input class="fuel-input" type="digit" value="{{editOdometer}}" bindinput="onEditOdometerInput" placeholder="km"/>
</view>
</view>
<text class="fuel-hint">填升数+里程，自动算本次油耗（L/100km）</text>
</view>
<!-- 资金账户：钱从哪个账户出/进 -->
<view class="acc-row" wx:if="{{editType!=='transfer' && accounts.length>0}}">
<picker class="acc-pick-wrap" range="{{accounts}}" range-key="name" value="{{editAccountIndex}}" bindchange="onEditAccountChange">
<view class="acc-pick">
<text class="acc-pick-label">💼 资金账户</text>
<text class="acc-pick-name">{{accounts[editAccountIndex] ? accounts[editAccountIndex].name : '未选择'}}</text>
<text class="tf-caret">▾</text>
</view>
</picker>
</view>
<view class="pay-row" wx:if="{{editType!=='transfer'}}">
<view class="pay-item {{editPaymentMethod===item.id?'selected':''}}" wx:for="{{paymentMethods}}" wx:key="id" bindtap="onEditPaymentChange" data-id="{{item.id}}">
<text class="pay-icon">{{item.icon}}</text>
<text class="pay-name">{{item.name}}</text>
</view>
</view>
<view class="reimburse-toggle" wx:if="{{editType==='expense' && !editIsLoan}}" bindtap="onEditReimburseTap">
<view class="reimburse-checkbox {{editReimbursable?'checked':''}}">
<text wx:if="{{editReimbursable}}">✓</text>
</view>
<text class="reimburse-toggle-label">🧾 可报销（公司公费）</text>
</view>
<!-- 借款开关（编辑） -->
<view class="loan-toggle {{editIsLoan?'on':''}}" wx:if="{{editType!=='transfer'}}" bindtap="onEditLoanTap">
<view class="loan-checkbox {{editIsLoan?'checked':''}}">
<text wx:if="{{editIsLoan}}">✓</text>
</view>
<text class="loan-toggle-label">🤝 借款<text class="loan-toggle-sub">（不计入收支）</text></text>
</view>
<view class="loan-box" wx:if="{{editIsLoan && editType!=='transfer'}}">
<view class="loan-row">
<text class="loan-label">{{editType==='expense'?'借给谁':'向谁借'}}</text>
<input class="loan-input" value="{{editCounterparty}}" bindinput="onEditLoanPartyInput" placeholder="{{editType==='expense'?'如：张三':'如：李四'}}" maxlength="20"/>
</view>
<text class="loan-hint" wx:if="{{editType==='expense'}}">📤 借出：不计入本月支出。对方还钱时在「收入」里勾借款记一笔，两条自动抵消。</text>
<text class="loan-hint" wx:else>📥 借入：不计入本月收入。还钱时在「支出」里勾借款记一笔，两条自动抵消。</text>
</view>
<view class="edit-btns">
<view class="submit-btn {{editIsLoan&&editType!=='transfer'?'loan-btn':(editType==='expense'?'expense-btn':(editType==='income'?'income-btn':'transfer-btn'))}}" bindtap="handleEdit">{{editLoading?"保存中...":(editType==='transfer'?"保存转账":(editIsLoan?"保存借款":"保存修改"))}}</view>
<view class="delete-btn" bindtap="handleDelete">删除</view>
</view>
</view>

<!-- 隐私授权弹窗（独立于登录状态，所有用户首次使用都弹出） -->
<view class="privacy-mask" wx:if="{{showPrivacyConsent}}">
<view class="privacy-modal">
<view class="privacy-modal-title">用户协议和隐私政策</view>
<view class="privacy-modal-body">
<text class="privacy-modal-text">感谢您使用游游记账。我们重视您的隐私，请在使用服务前阅读并同意以下协议：</text>
<view class="privacy-modal-links">
<text class="privacy-modal-link" bindtap="goAgreement">《用户协议》</text>
<text class="privacy-modal-link" bindtap="goPrivacy">《隐私政策》</text>
</view>
<view class="privacy-modal-agree" bindtap="toggleAgree">
<view class="agree-checkbox {{agreedPrivacy?'checked':''}}">
<text wx:if="{{agreedPrivacy}}" class="agree-check-icon">✓</text>
</view>
<text class="agree-text">我已阅读并同意以上协议</text>
</view>
<view class="privacy-modal-btns">
<button class="privacy-modal-btn cancel" bindtap="rejectPrivacy">不同意</button>
<button class="privacy-modal-btn confirm {{!agreedPrivacy?'btn-disabled':''}}" bindtap="acceptPrivacy" disabled="{{!agreedPrivacy}}">同意并继续</button>
</view>
</view>
</view>
</view>
